        -- error, no log, just a spinner that never gets tapped. _G.RQSC keeps the loop's actual
        -- view readable, so "it doesn't work" is one look instead of a guessing round-trip. (The
        -- status lines that used to print it in this section were removed on request: the
        -- section is the toggles and the slider, nothing else.)
        local SC = { off = nil, s = 0, t = 0, diff = 0, moving = false, presses = 0, seen = 0, state = "off" }
        pcall(function() rawset(_G, "RQSC", SC) end)
        secAuto:Toggle("Auto Skillcheck", false, function(on)
            scGen = scGen + 1
            if not on then SC.state = "off"; return end
            SC.state = "starting"
            local myGen = scGen
            task.spawn(function()
                -- ROT_OFFSET is no longer chosen by fingerprint alone -- see discoverRotCands.
                local ROT_OFFSET, ROT_CANDS               = nil, {}
                local candMoves, candPrev                 = {}, {}
                -- The game's own hit test (decompiled from Client.Interfaces.Routes.Screen.Skillcheck)
                -- is `zone-20 <= spinner <= zone+20`, i.e. a FORTY degree window. Pressing only
                -- inside +/-9 used the middle 45% of it for no reason and threw away margin on a
                -- spinner that runs 90-500 deg/s (up to ~1000 as your combo builds). 15 keeps 5
                -- degrees of safety against a mistimed tap, which is an instant fail.
                local PRESS_WINDOW, DIFF_GATE             = 15, 30
                -- 5ms, the value confirmed working live on the standalone build. The port had
                -- 0.5ms, a tenth of the lead, which under-leads a 900 deg/s spinner by ~4 degrees
                -- against a 9 degree window.
                local LATENCY, MAXVEL, GLITCH_JUMP        = 5/1000, 900, 90
                local STATIC_TIMEOUT, COOLDOWN, HOLD      = 1/5, 3/20, 3/100
                local RESOLVE_TTL, IDLE_WAIT              = 1/2, 1/10
                local VK_SPACE = 0x20
                local plrs  = game:GetService("Players")
                local mread = memory_read
                local clk   = os.clock
                local abs   = math.abs

                local function nav(root, ...)
                    for _, nm in ipairs({ ... }) do
                        if not root then return nil end
                        root = root:FindFirstChild(nm)
                    end
                    return root
                end
                local function addrOf(inst)
                    if not inst then return nil end
                    local ok, a = pcall(function() return inst.Address end)
                    if ok and a then return tonumber(a) end
                    return nil
                end
                -- GuiObject.Rotation is not in Matcha's property bridge, so it has to be read
                -- straight out of the instance. Its struct offset is NOT stable across Roblox
                -- updates — it moved 376 -> 296 and silently killed this feature, because a bad
                -- offset just returns some unrelated float and the spinner never appears to move.
                --
                -- So don't hardcode it: find it. Rotation is stored with its sine and cosine
                -- cached in the next two floats, and that triple is a very strong fingerprint —
                -- sin^2+cos^2 == 1 AND deg(atan2(sin,cos)) == the degrees field. Requiring it to
                -- hold on SEVERAL different GuiObjects at once makes a coincidental match
                -- essentially impossible (measured live: it held on 2527 objects at +296 and on
                -- 2 at every other offset in a 280..520 sweep).
                local function rotTripleAt(addr, off)
                    local okD, d = pcall(mread, "float", addr + off)
                    local okS, s = pcall(mread, "float", addr + off + 4)
                    local okC, c = pcall(mread, "float", addr + off + 8)
                    if not (okD and okS and okC) then return nil end
                    if type(d) ~= "number" or d ~= d then return nil end
                    if type(s) ~= "number" or s ~= s then return nil end
                    if type(c) ~= "number" or c ~= c then return nil end
                    if abs(s * s + c * c - 1) > 0.002 then return nil end
                    if abs(((math.deg(math.atan2(s, c)) - d + 540) % 360) - 180) > 0.05 then return nil end
                    return d
                end
                -- Propose every offset where the triple holds on EVERY probe. Two things changed
                -- after this broke a third time:
                --
                --   1. The sweep was 240..560. The offset is now +216, so the real field was
                --      OUTSIDE the search window and could never be found. Widened to 120..800.
                --   2. It used to return a single winner. It cannot: at rest a GuiObject reads
                --      (0, 0, 1), and that passes the fingerprint TRIVIALLY (0*0+1*1 == 1,
                --      atan2(0,1) == 0). Discovery runs the moment the check appears, while
                --      everything is still at rotation 0, so every candidate looks equally valid
                --      and a dead one wins the coin flip -- which is precisely how it locked +280
                --      and then read a constant forever.
                --
                -- Measured live: exactly TWO offsets pass here, 216 (real) and 280 (zeros), so
                -- the per-frame cost of carrying the whole candidate list is nothing.
                local function discoverRotCands(addrs)
                    local out = {}
                    for off = 120, 800, 4 do
                        local all = true
                        for i = 1, #addrs do
                            if not rotTripleAt(addrs[i], off) then all = false break end
                        end
                        if all then out[#out + 1] = off end
                    end
                    return out
                end
                -- The tiebreak the fingerprint cannot make: whichever candidate actually CHANGES
                -- while the spinner is spinning is the real Rotation. A dead offset holds still,
                -- so it can never win, and a Roblox update that moves the field again just makes
                -- a different candidate start winning on its own.
                local function trackCands(addr)
                    for i = 1, #ROT_CANDS do
                        local off = ROT_CANDS[i]
                        local ok, v = pcall(mread, "float", addr + off)
                        if ok and type(v) == "number" and v == v then
                            local prev = candPrev[off]
                            if prev ~= nil and abs(v - prev) > 0.01 then
                                candMoves[off] = (candMoves[off] or 0) + 1
                            end
                            candPrev[off] = v
                        end
                    end
                    -- needs a few real changes, so one glitched read cannot win the lock
                    local best, bestN = nil, 2
                    for i = 1, #ROT_CANDS do
                        local off = ROT_CANDS[i]
                        local cnt = candMoves[off] or 0
                        if cnt > bestN then best, bestN = off, cnt end
                    end
                    if best and best ~= ROT_OFFSET then
                        ROT_OFFSET = best
                        SC.off = best
                    end
                end
                local function readRot(addr)
                    if not (addr and ROT_OFFSET) then return nil end
                    local ok, v = pcall(mread, "float", addr + ROT_OFFSET)
                    if ok and type(v) == "number" and v == v then return v % 360 end
                    return nil
                end
                local function angdiff(a, b) return ((a - b + 540) % 360) - 180 end
                local function rbxActive()
                    local ok, r = pcall(isrbxactive)
                    if ok then return r end
                    return true
                end

                local pg, cache, burst
                local lastS, lastChangeT, velEst, lastPress = nil, nil, 0, nil
                local hzN, hzT = 0, clk()

                while scGen == myGen and GUI.Running do
                    if not pg then
                        local lp = plrs.LocalPlayer
                        pg = lp and lp:FindFirstChild("PlayerGui")
                    end
                    local sc = pg and pg:FindFirstChild("Skillcheck")

                    if not sc then
                        cache, lastS, lastChangeT, velEst = nil, nil, nil, 0
                        SC.state = "no Skillcheck GUI"
                        task.wait(IDLE_WAIT)
                    else
                        local now = clk()
                        if (not cache) or (now - cache.t) > RESOLVE_TTL then
                            local content = nav(sc, "Skillcheck", "Group", "Frame", "Frame", "Content")
                            local spin = content and content:FindFirstChild("Spinner")
                            local val  = content and content:FindFirstChild("Validation")
                            local sa, va = addrOf(spin), addrOf(val)
                            if sa and va then
                                cache = { spin = sa, val = va, t = now }
                                -- Locate Rotation once per check, off these two plus a third
                                -- unrelated GuiObject so the triple has to agree three ways.
                                if #ROT_CANDS == 0 then
                                    local probes = { sa, va }
                                    local extra = content:FindFirstChild("Circle") or sc
                                    local ea = addrOf(extra)
                                    if ea then probes[#probes + 1] = ea end
                                    ROT_CANDS = discoverRotCands(probes)
                                    SC.cands = #ROT_CANDS
                                end
                                -- The Spinner is rebuilt per check, so these addresses are new.
                                -- Carrying the old values over would read as a movement and hand
                                -- the lock to whatever offset happened to differ.
                                candPrev = {}
                            else
                                cache = nil
                                SC.state = "Spinner/Validation not found"
                            end
                        end
                        if cache and #ROT_CANDS == 0 then SC.state = "no rotation candidates" end

                        if cache then
                            -- Learn first: until a candidate has visibly moved there is no
                            -- ROT_OFFSET, readRot returns nil, and we simply wait.
                            trackCands(cache.spin)
                            if not ROT_OFFSET then SC.state = "learning offset (spin the check)" end
                            local s = readRot(cache.spin)
                            local t = readRot(cache.val)
                            if s and t then
                                if lastS == nil then
                                    lastS = s
                                else
                                    local d = angdiff(s, lastS)
                                    if abs(d) > GLITCH_JUMP then
                                        lastS = s
                                    elseif d ~= 0 then
                                        if lastChangeT then
                                            local ddt = now - lastChangeT
                                            if ddt > 0 then
                                                local vv = d / ddt
                                                if vv > MAXVEL then vv = MAXVEL elseif vv < -MAXVEL then vv = -MAXVEL end
                                                velEst = vv
                                            end
                                        end
                                        lastChangeT = now
                                        -- Published for "Press E after minigame": a moving spinner
                                        -- IS an on-screen minigame (see that toggle).
                                        SC.lastMoveT = now
                                        lastS = s
                                    end
                                end

                                local moving = (lastChangeT ~= nil) and ((now - lastChangeT) < STATIC_TIMEOUT)
                                local diff   = angdiff(s, t)
                                local pred   = ((diff + velEst * LATENCY + 540) % 360) - 180

                                SC.s, SC.t, SC.diff, SC.moving = s, t, diff, moving
                                local act = moving and rbxActive() or false
                                if moving then SC.seen = SC.seen + 1 end
                                -- one reason string, in the order the gate actually evaluates
                                if not moving then SC.state = "waiting for spinner"
                                elseif abs(diff) > DIFF_GATE then SC.state = "out of range"
                                elseif abs(pred) > PRESS_WINDOW then SC.state = "closing in"
                                elseif not act then SC.state = "Roblox not focused"
                                else SC.state = "TAP" end

                                -- A skillcheck is OVER in a second or two -- the game posts a fail
                                -- the instant the spinner leaves the zone unpressed -- so the live
                                -- numbers are back to zero long before anyone can read them.
                                -- Summarise each burst of motion so ONE attempt explains itself.
                                if moving then
                                    if not burst then burst = { t0 = now, n = 0, md = 999, mv = 0, act = 0, taps = 0 } end
                                    burst.n = burst.n + 1
                                    if abs(diff) < burst.md then burst.md = abs(diff) end
                                    if abs(velEst) > burst.mv then burst.mv = abs(velEst) end
                                    if act then burst.act = burst.act + 1 end
                                elseif burst then
                                    SC.last = string.format("%.1fs  %d samples  closest %.0f deg  %.0f deg/s  focused %d/%d  taps %d",
                                        now - burst.t0, burst.n, burst.md, burst.mv, burst.act, burst.n, burst.taps)
                                    burst = nil
                                end

                                if moving and abs(diff) <= DIFF_GATE and abs(pred) <= PRESS_WINDOW
                                    and act
                                    and ((not lastPress) or (now - lastPress) > COOLDOWN) then
                                    lastPress = now
                                    SC.presses = SC.presses + 1
                                    if burst then burst.taps = burst.taps + 1 end
                                    pcall(keypress, VK_SPACE)
                                    task.wait(HOLD)
                                    pcall(keyrelease, VK_SPACE)
                                    lastS = nil
                                end
                            end
                        end

                        -- loop rate, so a starved loop is visible rather than inferred
                        hzN = hzN + 1
                        local hnow = clk()
                        if hnow - hzT >= 1 then SC.hz = hzN / (hnow - hzT); hzN, hzT = 0, hnow end
                        task.wait()
                    end
                end
            end)
        end):Tooltip("Legit auto-tap: reads the spinner + zone angle from memory and presses SPACE on time. Roblox must be the focused window. Not an instant-win.")

        -- ---------- Press E after minigame: chain checks back to back ----------
        -- You start the FIRST minigame yourself. From then on, the moment one ends, this taps E
        -- until the next one is on screen, then goes quiet while Auto Skillcheck plays it.
        --
        -- "On screen" is read off the spinner, because nothing else works: PlayerGui.Skillcheck
        -- exists permanently, and Visible / Enabled / GroupTransparency all read nil through
        -- Matcha. The game's controller advances the spinner every RenderStepped from the first
        -- frame of a check and never pauses it mid-combo (a hit only flips direction), so
        -- "spinner moved in the last ACTIVE_GRACE" is exactly "a minigame is running".
        -- That signal comes from the Auto Skillcheck loop, so this needs it switched ON.
        local EP = { state = "off", presses = 0 }
        local epGen = 0
        local epInterval = 1 / 10     -- default 10 taps/s: fast, as asked, and still a real tap
        secAuto:Toggle("Press E after minigame", false, function(on)
            epGen = epGen + 1
            if not on then
                EP.state = "off"
                pcall(keyrelease, 0x45)   -- never leave E held on the way out
                return
            end
            local myGen = epGen
            EP.state = "starting"
            task.spawn(function()
                -- 0.25s of stillness = over. The spinner steps every frame (~16ms) for the whole
                -- check, so this is ~15 missed frames: far past any render hitch, and short
                -- enough that the next E goes out almost as soon as the result lands.
                local ACTIVE_GRACE = 1 / 4
                local HOLD         = 3 / 100  -- same tap length Auto Skillcheck uses for SPACE
                -- If no minigame appears for this long, stop and wait for YOU to start one again.
                -- Without it, running out of materials or walking off would leave it tapping E
                -- into whatever prompt is nearby indefinitely.
                local GIVE_UP      = 20
                local VK_E         = 0x45
                local clk          = os.clock
                local seenGame     = false    -- only chain AFTER a minigame you started yourself
                -- Remembers WHY we are idle. Without it the give-up message was overwritten by
                -- "start the first minigame yourself" on the very next pass and never shown.
                local gaveUp       = false
                local spamSince, lastTap = nil, 0

                local function focused()
                    local ok, r = pcall(isrbxactive)
                    if ok then return r end
                    return true
                end

                -- Is the menu actually on screen? isrbxactive() cannot tell us: the menu is drawn
                -- INSIDE Roblox, so Roblox stays focused while you use it. That matters because the
                -- fork polls every key while open -- an injected E would be taken by a keybind
                -- capture (click Unload Script -> rebind, and E becomes your unload key, so the
                -- NEXT tap unloads the script) or typed into a textbox.
                -- _G.RQGeo is rebuilt as a fresh table every frame the window renders, so table
                -- identity is the heartbeat; a MINIMISED menu leaves it frozen at open=true, which
                -- the 0.25s staleness check catches. Same test drawBadge uses.
                local geoRef, geoAt = nil, 0
                local function menuBusy(now)
                    local g = _G.RQGeo
                    if g ~= geoRef then geoRef, geoAt = g, now end
                    if type(g) == "table" and g.open == true and (now - geoAt) <= 0.25 then return true end
                    -- belt and braces: the unload capture specifically
                    local kb = GUI._kbUnload and GUI._kbUnload.item
                    return type(kb) == "table" and kb.listening == true
                end

                while epGen == myGen and GUI.Running do
                    local now = clk()
                    local S = SC
                    local liveT = S and S.lastMoveT
                    local active = liveT ~= nil and (now - liveT) < ACTIVE_GRACE

                    if S == nil or S.state == "off" then
                        -- No liveness signal without the skillcheck loop -- do nothing rather
                        -- than tap E blind.
                        EP.state = "turn on Auto Skillcheck"
                        seenGame, spamSince, gaveUp = false, nil, false
                    elseif active then
                        seenGame, spamSince, gaveUp = true, nil, false
                        EP.state = "minigame running"
                    elseif not seenGame then
                        EP.state = gaveUp and ("no minigame for " .. GIVE_UP .. "s - start one to resume")
                                           or "start the first minigame yourself"
                    else
                        spamSince = spamSince or now
                        if now - spamSince > GIVE_UP then
                            -- Re-arm rather than stop: the next minigame you start by hand picks
                            -- the chain straight back up.
                            seenGame, spamSince, gaveUp = false, nil, true
                        elseif not focused() then
                            -- keypress is OS-level: with Roblox in the background every E would
                            -- be typed into whatever window has focus instead. A pause, not idle
                            -- time: it must not run down the give-up clock.
                            spamSince = nil
                            EP.state = "paused - Roblox not focused"
                        elseif GUI.PLSearchFocused then
                            -- every tap would type an "e" into the Player List search
                            spamSince = nil
                            EP.state = "paused - typing in Player List"
                        elseif menuBusy(now) then
                            spamSince = nil
                            EP.state = "paused - menu open"
                        else
                            EP.state = "pressing E"
                            if now - lastTap >= epInterval then
                                lastTap = now
                                EP.presses = EP.presses + 1
                                pcall(keypress, VK_E)
                                task.wait(HOLD)
                                pcall(keyrelease, VK_E)
                            end
                        end
                    end
                    task.wait()
                end
                pcall(keyrelease, VK_E)
                if epGen == myGen then EP.state = "off" end
            end)
        end):Tooltip("Start the first minigame yourself. After each one ends this taps E until the next one shows, then waits. Needs Auto Skillcheck ON (it reads the spinner to know when a minigame is up). Pauses while this menu is open or Roblox is not focused, so E never lands in a keybind or textbox. Gives up after 20s with no minigame.")
        secAuto:Slider("E Tap Interval", epInterval, 1 / 100, 1 / 20, 1 / 2, "s", function(v)
            epInterval = tonumber(v) or epInterval
        end):Tooltip("seconds between E taps while waiting for the next minigame. 0.10 = ten a second")

        local secPanels = tab:Section("Panels", "Right", "Floating windows")
        secPanels:Toggle("Counters", GUI.CounterVisible, function(v)
            GUI.CounterVisible = v; BuildCounterPanel()
        end)
        secPanels:Toggle("Enchants", GUI.EnchantsOpen, function(v)
            GUI.EnchantsOpen = v
            if v then
                if not GUI.EnchantsAllData then
                    GUI.EnchantsFetchStatus = "Fetching..."
                    BuildEnchantsPanel()
                    task.spawn(function() FetchEnchantData(); FetchOwnedEnchants(); BuildEnchantsPanel() end)
                else
                    task.spawn(function() FetchOwnedEnchants(); BuildEnchantsPanel() end)
                end
            else
                GUI.EnchantsModal = nil
                ClearEnchantsPanel()
                if GUI._enchHoverEl then GUI._enchHoverEl.Visible = false end
            end
        end)
        secPanels:Toggle("RS Diff", GUI.RSDiffOpen, function(v)
            GUI.RSDiffOpen = v
            if v then BuildRSDiffPanel() else ClearRSDiffPanel() end
        end)
    end)

    -- ===== Settings tab (built-in) =====
    tabBuild(function()
        local setTab = window:AddSettingsTab("cog")

        -- One Appearance: the library's own (Background, Text color, Border, Corner radius, ...).
        -- Its Theme section is dropped; Requiem adds "Apply to Panels" (the Player List / Enchants /
        -- RS Diff panels follow it; the panel engine reads GUI.MenuLook a few times a second) and
        -- "Accent" (menu + panels, saved in the config) to the top of it.

-- ============================ HIDDENS ============================
-- Hide Velocity: stops the game's own speed number (PlayerGui.Velocity.Velocity.Speed) being DRAWN
-- on your screen. It does not touch the talent that grants the readout, the label's text, or
-- anything the server sees.
--
-- MEASURED LIVE (2026-10-09) -- every rule below comes from these:
--   * The Visible flag is no use here. The game rewrites this label's text whenever the speed
--     changes, and a text change redraws the text without re-reading Visible (written on the
--     Frame and on the label: the number stayed on screen both times).
--   * What a text change DOES re-read is the label's "characters to draw" count
--     (MaxVisibleGraphemes): -1 = all of them, 0 = none. Written to 0 the number is gone at the
--     next speed change; written back to -1 it returns the same way. Seen both ways on screen.
--   * Seven fields read -1 on every ordinary label, so -1 alone does not identify the count. The
--     game's own typewriter labels do: they rest at 0 in exactly one of the seven. Exactly one
--     offset may fit that or nothing is written.
-- Wrapped in an IIFE for its own local budget. It talks to the menu only through GUI.HideVelocity
-- (the toggle) and GUI.HiddensCleanup (unload).
;(function()
local HINT = 3796                     -- where the count sat on the build this was measured on
local SCAN_LO, SCAN_HI = 2800, 4800   -- searched as well, so a Roblox update moving it is survivable
local MAX_COUNT = 5000                -- a typewriter label mid-sentence holds a small positive count
-- The game's typewriter labels (see above). Looked up by name because they are deep in the tree;
-- if a game update moves them, every label in PlayerGui is asked instead (slow, once).
local WITNESSES = {
    { "Eyecatcher", "Eyecatcher", "Chronicle", "Content", "TextContainer", "Text" },
    { "Eyecatcher", "Eyecatcher", "Chronicle", "Content", "TextContainer", "Ghost" },
    { "Messages", "Messages", "Background", "Frame", "Frame", "Background", "Message" },
}

local function say(msg, secs)
    pcall(function() uiNotify("Hiddens", msg, secs or 5) end)
end

-- Instance.Address is a hex string on some builds and a number on others.
local function addrOf(inst)
    local a = inst and inst.Address
    if type(a) == "number" then return a end
    if type(a) == "string" then return tonumber(a) or tonumber((a:gsub("^0[xX]", "")), 16) end
    return nil
end

local function readInt(a)
    local ok, v = pcall(memory_read, "int", a)
    if ok and type(v) == "number" then return v end
    return nil
end

local function playerGui()
    local lp = Players.LocalPlayer
    return lp and lp:FindFirstChild("PlayerGui") or nil
end

-- Always a FRESH lookup: the label is rebuilt with its GUI, and no instance is kept across passes.
local function speedAddr()
    local a
    pcall(function()
        local pg = playerGui()
        local root = pg and pg:FindFirstChild("Velocity")
        local frame = root and root:FindFirstChild("Velocity")
        a = addrOf(frame and frame:FindFirstChild("Speed"))
    end)
    return a
end

-- A few ordinary labels from each GUI, breadth-first and bounded. PlayerGui holds ~35,000
-- instances and one ClassName read costs ~80us, so walking all of it stalls the menu for seconds.
local function sampleLabels(pg)
    local out, looked = {}, 0
    for _, gui in ipairs(pg:GetChildren()) do
        if #out >= 60 or looked >= 4000 then break end
        local queue, qi, got, seen = { gui }, 1, 0, 0
        while queue[qi] and got < 6 and seen < 80 do
            local node = queue[qi]
            qi = qi + 1
            for _, c in ipairs(node:GetChildren()) do
                -- checked per child: one node with thousands of children must not eat the budget
                if got >= 6 or seen >= 80 then break end
                seen = seen + 1
                looked = looked + 1
                if c.ClassName == "TextLabel" then
                    local a = addrOf(c)
                    if a then out[#out + 1] = a; got = got + 1 end
                end
                queue[#queue + 1] = c
            end
        end
    end
    return out
end

local function witnessAddrs(pg)
    local out = {}
    for _, path in ipairs(WITNESSES) do
        local node = pg
        for _, name in ipairs(path) do
            node = node and node:FindFirstChild(name)
        end
        if node and node.ClassName == "TextLabel" then
            local a = addrOf(node)
            if a then out[#out + 1] = a end
        end
    end
    return out
end

-- Every offset where the sample reads -1 almost everywhere and never anything but a count.
local function candidates(sample)
    local out = {}
    local spare = math.floor(#sample * 0.15)   -- labels allowed to hold a count instead of -1
    local function fits(off)
        local counts = 0
        for i = 1, #sample do
            local v = readInt(sample[i] + off)
            if v ~= -1 then
                if v == nil or v < 0 or v > MAX_COUNT then return false end
                counts = counts + 1
                if counts > spare then return false end
            end
        end
        return true
    end
    if fits(HINT) then out[1] = HINT end
    for off = SCAN_LO, SCAN_HI, 4 do
        if off ~= HINT and fits(off) then out[#out + 1] = off end
    end
    return out
end

-- One label's vote. An ordinary label reads -1 at every candidate. A witness reads a count at
-- exactly ONE of them and -1 at the rest. Anything else (a label destroyed mid-scan, memory that
-- would not read) is not evidence either way and is only counted as junk.
local function vote(tally, cands, a)
    local hit, hits = nil, 0
    for i = 1, #cands do
        local v = readInt(a + cands[i])
        if v ~= -1 then
            if v == nil or v < 0 or v > MAX_COUNT then tally.junk = tally.junk + 1; return end
            hit = i
            hits = hits + 1
        end
    end
    if hits > 1 then tally.junk = tally.junk + 1; return end
    tally.n = tally.n + 1
    if hit then tally.wit[hit] = (tally.wit[hit] or 0) + 1 end
end

-- The single candidate that has a witness, or nil and the reason.
local function verdict(tally, cands)
    if tally.n < 20 then return nil, "notready" end
    if tally.junk > tally.n * 0.05 then return nil, "labels did not read cleanly" end
    local off, n = nil, 0
    for i = 1, #cands do
        local w = tally.wit[i]
        if w then
            -- a field most labels disagree on is not a "-1 unless typing" count
            if w > tally.n * 0.15 then return nil, "labels did not read cleanly" end
            off = cands[i]
            n = n + 1
        end
    end
    if n == 1 then return off end
    if n == 0 then return nil, "nothing to tell the fields apart" end
    return nil, n .. " possible spots"
end

-- Returns the offset, or nil and why. "nolabel" / "notready" mean try again later; anything else
-- is final for this session. Called from the engine's own loop thread, so the slow path may yield.
local function locate(alive)
    local pg, cands, off, why
    local ok, err = pcall(function()
        pg = playerGui()
        local speed = speedAddr()
        if not (pg and speed) then why = "nolabel"; return end
        local sample = sampleLabels(pg)
        if #sample < 20 then why = "notready"; return end
        cands = candidates(sample)
        if #cands == 0 then why = "no field fits on this Roblox build"; return end
        local tally = { n = 0, junk = 0, wit = {} }
        for i = 1, #sample do vote(tally, cands, sample[i]) end
        vote(tally, cands, speed)
        local wits = witnessAddrs(pg)
        for i = 1, #wits do vote(tally, cands, wits[i]) end
        off, why = verdict(tally, cands)
    end)
    if not ok then return nil, "error: " .. tostring(err) end
    if off or not cands or #cands == 0 or why == "notready" then return off, why end

    -- Slow, at most once a session: every label in PlayerGui votes. Only reached when the named
    -- typewriter labels did not settle it (a game update moved or renamed them).
    say("Hide Velocity: locating (one-time, a few seconds)...", 5)
    local tally = { n = 0, junk = 0, wit = {} }
    local function voteInst(d)
        if d.ClassName == "TextLabel" then
            local a = addrOf(d)
            if a then vote(tally, cands, a) end
        end
    end
    local okG, guis = pcall(function() return pg:GetChildren() end)
    if not okG or type(guis) ~= "table" then return nil, "error: PlayerGui went away" end
    local looked = 0
    for _, gui in ipairs(guis) do
        local okD, list = pcall(function() return gui:GetDescendants() end)
        if okD and type(list) == "table" then
            for _, d in ipairs(list) do
                pcall(voteInst, d)
                looked = looked + 1
                -- yield OUTSIDE the pcall, in small slices, so the menu keeps drawing
                if looked % 150 == 0 then
                    task.wait()
                    if not alive() then return nil, "stopped" end
                end
            end
        end
    end
    return verdict(tally, cands)
end

local OFF = nil          -- the located offset, kept for the session
local failed = nil       -- why locating failed for good; cleared when the toggle goes off
local told = nil
local engaged = false    -- the number may be hidden by us and owed a restore
local lastTry, notReady = 0, 0

-- want: 0 = draw nothing, -1 = draw everything (Roblox's default). Only ever written over one of
-- those two values: anything else means this is not the field that was measured, so leave it.
local function setCount(want)
    local a = speedAddr()
    if not (a and OFF) then return false, "nolabel" end
    local v = readInt(a + OFF)
    if v ~= want then
        if v ~= 0 and v ~= -1 then return false, "unexpected value " .. tostring(v) end
        pcall(memory_write, "int", a + OFF, want)
        if readInt(a + OFF) ~= want then return false, "write did not stick" end
    end
    -- the undo record for a later copy of the menu (see undoPrevious)
    if want == 0 then _G.__RQ_HIDDENS_PREV = { off = OFF, addr = a } else _G.__RQ_HIDDENS_PREV = nil end
    return true
end

-- Re-running the menu stops the previous copy's loop WITHOUT an unload, so the number can still
-- be hidden while this copy's toggle starts off. That copy left the exact label and offset it
-- wrote. Undo only if this is still that label, it still reads 0 there, AND that offset still
-- behaves like the count on other labels (-1 on nearly all of them). The record lives in _G,
-- which can outlast the game it was written in; a plain zero somewhere else must never be hit.
local function undoPrevious()
    local prev = _G.__RQ_HIDDENS_PREV
    _G.__RQ_HIDDENS_PREV = nil
    if type(prev) ~= "table" or type(prev.off) ~= "number" then return end
    local a = speedAddr()
    if not (a and a == prev.addr and readInt(a + prev.off) == 0) then return end
    local pg = playerGui()
    local sample = pg and sampleLabels(pg) or {}
    local minusOne = 0
    for i = 1, #sample do
        if readInt(sample[i] + prev.off) == -1 then minusOne = minusOne + 1 end
    end
    if #sample >= 20 and minusOne >= #sample * 0.85 then
        pcall(memory_write, "int", a + prev.off, -1)
    end
end

-- Reached from UnloadScript, which is defined above this block.
GUI.HiddensCleanup = function()
    if engaged then pcall(setCount, -1); engaged = false end
end

task.spawn(function()
    local gen = {}
    _G.__RQ_HIDDENS = gen
    local function alive() return GUI.Running and _G.__RQ_HIDDENS == gen end
    pcall(undoPrevious)
    while alive() do
        local on = GUI.HideVelocity == true
        if on then
            if not OFF and not failed and os.clock() - lastTry >= 2 then
                lastTry = os.clock()
                local off, why = locate(alive)
                if why == "notready" then
                    -- a GUI still loading reads as "too few labels"; give it time before saying so
                    notReady = notReady + 1
                    if notReady >= 8 then why = "too few text labels to compare" end
                end
                if off then
                    OFF = off
                elseif why ~= "nolabel" and why ~= "notready" and why ~= "stopped" then
                    failed = why
                    say("Hide Velocity: could not find it safely (" .. tostring(why) .. "). Nothing was changed.", 7)
                end
            end
            if OFF then
                engaged = true
                local ok, why = setCount(0)
                if not ok and why ~= "nolabel" and told ~= why then
                    told = why
                    say("Hide Velocity: " .. tostring(why) .. " - left alone", 6)
                end
            end
        else
            failed = nil
            told = nil
            notReady = 0
            if engaged then pcall(setCount, -1); engaged = false end
        end
        task.wait(on and 1 / 4 or 1 / 2)
    end
end)
end)()  -- /Hiddens



-- ============================================================
-- AUTO PARRY v3  —  Requiem "Blade Parry".  No tuning sliders.
-- ============================================================
-- WHAT THE GAME ACTUALLY DOES (reverse-engineered from Blades.Default's bytecode string table plus
-- the RaycastHitboxV4 fork it drives, which does decompile):
--     every frame, for each Attachment named "DmgPoint" on the blade:
--         workspace:Raycast(point.WorldPosition, point.WorldPosition - point.LastPosition)
-- That is the whole hit test. Three consequences drive this design:
--   1. The damaging shape is the SEGMENT the blade tip sweeps this frame — not a sphere round the
--      attacker, and not a forward cone. A sphere fires on anyone swinging at air nearby, and each
--      false press costs 5 seconds; a cone is beaten by a lateral fly-by.
--   2. Ray length == the point's per-frame displacement, so effective reach GROWS with closing
--      speed. THAT is the "he slashed from far and it still hit me when he arrived" case — it is a
--      real hit, not a bait, and it falls straight out of the maths below instead of needing a
--      "blade linger" knob.
--   3. Because the blade is a real part we can watch, we never have to predict the animation. The
--      old build guessed a "damage frame" (0.30s) and a "linger" and was wrong per-animation; this
--      one measures the blade directly, which is why every slider is gone.
--
-- SO THE PREDICATE IS: will the segment swept by their blade tip pass within my body radius of me,
-- soon? We track the tip, differentiate it, and solve for closest approach. Nothing else.
--
-- VERIFIED CONSTANTS (live getgc on this build):
--     SUCCESSFUL_PARRY_WINDOW_SECONDS       = 1
--     NON_SUCCESSFUL_PARRY_WINDOW_SECONDS   = 5    <-- whiffing costs FIVE seconds
--     PARRY_LOCKOUT_AFTER_SWING_END_SECONDS = 0.1
-- Parry itself is onKeybindPressed("Blade Parry") — an edge-triggered TAP.
--
-- WHY THE OLD BUILD WAS INCONSISTENT (both fixed here):
--   * "sometimes it doesn't even try" — every press armed a 5s refractory, and the only path that
--     shortened it watched for the Gear.Parried animation on the attacker. That animation is
--     defined but referenced by ZERO client modules, so it never plays: the shortening path was
--     dead code and we went blind for 5s after EVERY press. Now we confirm against OUR OWN
--     Gear.Parry animation (which does replicate), and we only arm a cooldown when the press
--     actually registered.
--   * "parries too early" — it committed on a hardcoded animation-time damage frame shared by all
--     13 swing animations. There is no such shared constant. Now we commit on observed geometry.
--
-- Strictly client-side: memory reads, property reads, and one real OS keypress. No remotes.
-- ============================================================
;(function()

local LP = Players.LocalPlayer
if not LP then return end

local C_WHIFF_LOCKOUT = 5.0
local C_SWING_LOCKOUT = 0.1

-- Animator / AnimationTrack memory layout. These USED to be constants right here (2944, 264, 184,
-- 212, 216, 192, weights 220 / 224), and that is what killed both features that read animations:
-- Roblox has moved them three times, a stale number raises no error, and the track walk simply
-- finds nothing. They are now LOCATED at runtime by the "animator layout" block further down and
-- copied into these names by layAdopt(); until then they are nil and scan() / fsApply() stand down.
--   OA  list of playing tracks on the Animator     ON / OT   node -> next, node -> track (stable)
--   OO  track -> its Animator                      OM / OI   track -> Animation, its id string
--   OS / OP   Speed / TimePosition                 OW / OWT  blend weight / weight target
-- OW / OWT are the liveness discriminator and they are load-bearing: Roblox leaves an
-- AnimationTrack in the Animator's active list AFTER it stops, so "the swing animation is present"
-- does NOT mean "they are swinging". Measured live on two enemies:
--   playing swing -> TimePosition advancing, weight 1.000, target 1.000
--   finished swing -> TimePosition frozen,   weight 0.000, target 0.000   (lingered for 21-25 SECONDS)
-- Without this gate the script tracks a dead swing and fires when the attacker merely walks past
-- with their blade out — which is exactly the "slashes near me then leaves" bait.
local OA, ON, OT, OO, OM, OS, OP, OI = nil, 0, 16, nil, nil, nil, nil, nil
local OW, OWT = nil, nil

-- STRICT allowlist. 82 of the 93 ids in Common.Animations.Gear are harmless, and the worst
-- look-alikes (Grapples.Double, Dashes, Launches) play exactly during a closing approach — so
-- "treat unknown gear animations as maybe-threats" would fire constantly. Only these can damage.
local SWINGS = {}
for _, id in ipairs({
    "96150550684216", "107395560572172", "94107418581065",     -- Blades.Swings.Ground
    "78407720926422", "106676784817648",                       -- Blades.Swings.Air
    "86336690808665", "85287366164918",                        -- Crossguard air
    "102346761719959", "135697384008415",                      -- Tempo air
    "128445066928907", "73922915237760",                       -- Burst air
    "72771561922649",                                          -- Draw.Slash (Dashing Draw)
}) do SWINGS[id] = true end
local ANIM_PARRY = "89583460276496"
local STUNS = {}
for _, id in ipairs({ "91072205250933", "111041292650955", "86381779914835" }) do STUNS[id] = true end
-- One merged set so a single animator walk answers both "are they swinging" and "did they parry".
local WATCHED = {}
for id in pairs(SWINGS) do WATCHED[id] = true end
WATCHED[ANIM_PARRY] = true
local PARRY_ONLY = { [ANIM_PARRY] = true }   -- hoisted: allocating this per tick churned the GC

local AP = {
    -- Two-stage: the menu pill is the MASTER ARM (Enabled), the hotkey toggles the running state
    -- (On) underneath it. The hotkey deliberately does NOT move the pill, and does nothing at all
    -- while the pill is off.
    Enabled = false,
    On = false,
    -- The in-game "Blade Parry" bind is always F (Gear keybind slot 10), so this is fixed rather
    -- than exposed — there was nothing useful to change it to.
    Key = 0x46,
    ToggleKey = 0x47,    -- G toggles the feature
    ESP = true,          -- enemy parry-cooldown readout
    -- learned, not configured
    CD = C_WHIFF_LOCKOUT,     -- parry cooldown; learned DOWN if we ever re-parry sooner
    -- Watch radius. MEASURED, not guessed: an ODM player grappling in starts their swing at
    -- 115-119 studs while closing at 222-246 studs/s, and the swing only lasts ~0.85s. The old
    -- 90-stud radius meant the swing began OUTSIDE it entirely — no candidate was ever created,
    -- and by the time they crossed 90 studs they were ~0.1s from impact. That is precisely why
    -- fast grapple-in attackers were never parried while stationary ones were.
    Watch = 170,
    -- Round-trip ping in ms. This CANNOT be measured: Matcha has no GetNetworkPing, no
    -- Stats:GetValue, no GetServerTimeNow, and DistributedGameTime reads nil — all verified live.
    -- It matters twice over, which is why lateness persisted after the other fixes:
    --   inbound  (RTT/2): what we observe is that stale. At 230 studs/s, 100ms = 23 STUDS of
    --                     position error, so the geometry itself was systematically behind.
    --   outbound (RTT/2): our keypress needs that long to reach the server, which decides the parry.
    -- We correct the first by extrapolating the attacker forward, and the second by leading the press.
    PingMs = 200,
    -- My hittable radius about the HRP, DERIVED from measurement rather than guessed:
    --   reachable envelope, HRP-to-HRP                     ~10.4 studs  (DmgPoint cloud analysis)
    --   measured outermost blade PART from attacker HRP     ~6.4 studs  (live, both hands)
    --   => body radius + the DmgPoint overshoot past the
    --      visible tip (~1.1 studs)                         ~4.0-4.2 studs
    -- We track the visible blade part, so the threshold must absorb that overshoot.
    BodyR = 4.2,
    -- runtime
    Roster = {}, RosterAt = 0, Cand = {}, Fired = {},
    LastPress = 0, PressAt = 0, Armed = 0, ProbeAt = 0,
    Presses = 0, Registered = 0, Rejected = 0, Hz = 0, Err = 0,
    Status = "off", Near = 0,
}
GUI.AP = AP
-- Also publish on _G: getgenv() returns nil under Matcha, so GUI is otherwise unreachable from
-- outside the chunk and the feature cannot be inspected live while debugging.
pcall(function() rawset(_G, "RQAP", AP) end)

-- The UI library's Keybind control hands back a lowercase key NAME ("f", "g", "f4"), while
-- iskeypressed/keypress want a Win32 virtual-key code. Invert the menu's own VK_NAMES so the two
-- always agree, and expose it so the tab can convert without duplicating the table.
local NAME2VK = {}
for vk, n in pairs(VK_NAMES) do NAME2VK[string.lower(n)] = vk end

-- ...except VK_NAMES is a DISPLAY table and the fork does NOT use its spellings. The fork builds
-- its own key list -- aE("pageup",0x21), aE("plus",0xBB), aE("tilde",0xC0) -- and hands the
-- callback THAT name. It disagrees with VK_NAMES on every non-alphanumeric ("PgUp" vs "pageup",
-- "=" vs "plus", backquote vs "tilde") and VK_NAMES has no Space/Tab/Enter/arrows at all, so
-- binding any of those resolved to nil and silently did nothing. This is the fork's exact contract.
-- Letters, digits and F-keys agree already and are left to NAME2VK.
-- The fork registers NO numpad keys, so a numpad bind cannot be captured through a Keybind control.
local UI_NAME_VK = {
    backspace = 0x08, tab   = 0x09, enter = 0x0D, space = 0x20,
    shift     = 0x10, ctrl  = 0x11, alt   = 0x12,
    lshift = 0xA0, rshift = 0xA1, lctrl = 0xA2, rctrl = 0xA3, lalt = 0xA4, ralt = 0xA5,
    pageup = 0x21, pagedown = 0x22, ["end"] = 0x23, home = 0x24,
    left = 0x25, up = 0x26, right = 0x27, down = 0x28,
    insert = 0x2D, delete = 0x2E,
    semicolon = 0xBA, plus = 0xBB, comma = 0xBC, minus = 0xBD, period = 0xBE, slash = 0xBF,
    tilde = 0xC0, lbracket = 0xDB, backslash = 0xDC, rbracket = 0xDD, quote = 0xDE,
}
-- Reverse direction, so a control's INITIAL value is a name the fork recognises and renders.
local VK_UI_NAME = {}
for n, vk in pairs(UI_NAME_VK) do VK_UI_NAME[vk] = n end
for i = 0x41, 0x5A do VK_UI_NAME[i] = string.lower(string.char(i)) end
for i = 0x30, 0x39 do VK_UI_NAME[i] = string.char(i) end
for i = 1, 12 do VK_UI_NAME[0x6F + i] = "f" .. i end

GUI.VKFromName = function(n)
    if type(n) ~= "string" then return nil end
    n = string.lower(n)
    return UI_NAME_VK[n] or NAME2VK[n]
end
GUI.VKToName = function(vk) return VK_UI_NAME[vk] or string.lower(VK_NAMES[vk] or "f") end

local function rptr(a) local ok, v = pcall(memory_read, "uintptr", a) return ok and v or nil end
local function rflt(a) local ok, v = pcall(memory_read, "float", a) return ok and v or nil end
local function ri32(a) local ok, v = pcall(memory_read, "int32", a) return ok and v or nil end

local function readStr(base)
    local len = rptr(base + 16)
    if not len or len <= 0 or len > 256 then return nil end
    local src = (len < 16) and base or rptr(base)
    if not src or src < 0x10000 then return nil end
    local out, i = {}, 0
    while i < len do
        local w = ri32(src + i)
        if not w then return nil end
        for b = 0, 3 do
            if i + b < len then out[#out + 1] = string.char(bit32.band(bit32.rshift(w, b * 8), 255)) end
        end
        i = i + 4
    end
    return table.concat(out)
end

-- Ids arrive as either "rbxassetid://N" or "http://www.roblox.com/asset/?id=N" (both seen in one
-- animator), so only the trailing number is comparable.
local function idNum(s) if type(s) ~= "string" then return nil end return string.match(s, "(%d+)%s*$") end

-- ---- animator layout: identical in Menu.lua and in Fast swing.lua ----
-- Where things live inside an Animator and an AnimationTrack. These are NOT constants. Roblox has
-- moved them three times, and each time everything built on the old numbers went silent -- a stale
-- offset raises no error, the track walk just finds nothing:
--     list of playing tracks      2944 -> 2896 -> 2688
--     track -> its Animator        264 ->  272 ->  256
--     track -> Animation           184 ->  184 ->  168      Animation id string  192 -> 192 -> 176
--     Speed / TimePosition     212/216 -> 212/216 -> 196/200     weight / target  220/224 -> 204/208
-- So they are FOUND, on your own animator, from what each field has to do:
--   * the list is a real linked list: walking it returns to its head in exactly as many steps as
--     the count stored beside the head, and every node's back link is the node before it
--   * a track points back at the animator it belongs to
--   * a track points at an Animation whose id reads as an asset id
--   * TimePosition is the float that advances, at the rate held in the float just before it
--     (Speed); the two floats after it are the blend weight and its target, both 0..1
-- Every track that shows all of that has to agree, or nothing is used.
-- Needs rptr / rflt / ri32 from the file around it.
local LAY = { ok = false, why = "not located yet", tries = 0 }
local LAY_HINT = { 2688, 2896, 2944 }   -- tried first; the search covers everything else

local function layPtr(p) return type(p) == "number" and p > 0x10000 and p < 0x7FFFFFFFFFFF end

-- A std::string that has to LOOK like one: printable, with a capacity that fits its length.
local function layStr(base)
    local len, cap = rptr(base + 16), rptr(base + 24)
    if not (len and cap) or len < 8 or len > 128 or cap < len or cap > 4096 then return nil end
    local src = (cap < 16) and base or rptr(base)
    if not layPtr(src) then return nil end
    local out, i = {}, 0
    while i < len do
        local w = ri32(src + i)
        if not w then return nil end
        for b = 0, 3 do
            if i + b < len then
                local ch = bit32.band(bit32.rshift(w, b * 8), 255)
                if ch < 32 or ch > 126 then return nil end
                out[#out + 1] = string.char(ch)
            end
        end
        i = i + 4
    end
    return table.concat(out)
end

-- Both spellings Roblox uses, ending in the numeric id.
local function layIsAsset(s)
    if type(s) ~= "string" or not string.match(s, "%d%d%d%d+%s*$") then return false end
    return string.find(s, "rbxassetid://", 1, true) ~= nil or string.find(s, "asset/?id=", 1, true) ~= nil
end

-- The elements of the linked list at A+off, or nil when it is not a well-formed one.
local function layList(A, off)
    local head, size = rptr(A + off), rptr(A + off + 8)
    if not layPtr(head) or not size or size < 1 or size > 64 then return nil end
    local out, prev, node = {}, head, rptr(head)
    while layPtr(node) and node ~= head and #out < size do
        if rptr(node + 8) ~= prev then return nil end
        out[#out + 1] = rptr(node + 16) or 0
        prev, node = node, rptr(node)
    end
    if node ~= head or #out ~= size or rptr(head + 8) ~= prev then return nil end
    return out
end

-- FIRST LOOK. Every well-formed list on the animator whose elements point back at it, with a
-- snapshot of each element's floats. Returns nil when there is nothing to study.
local function layLook(A)
    local found = {}
    local function consider(off)
        local els = layList(A, off)
        if not els then return end
        local mine = {}
        for i = 1, #els do
            local t = els[i]
            -- No cap on how many are studied: finished tracks stay in this list for 20+ seconds,
            -- so in a fight the playing ones can sit behind a dozen dead ones (layList already
            -- bounds the list at 64).
            if layPtr(t) and t ~= A then
                local owners = {}
                for o = 128, 512, 8 do
                    if rptr(t + o) == A then owners[#owners + 1] = o end
                end
                if #owners > 0 then
                    local f = {}
                    for o = 96, 400, 4 do f[o] = rflt(t + o) end
                    mine[#mine + 1] = { t = t, owners = owners, f = f, at = os.clock() }
                end
            end
        end
        if #mine > 0 then found[#found + 1] = { off = off, tracks = mine } end
    end
    for i = 1, #LAY_HINT do consider(LAY_HINT[i]) end
    for off = 1024, 4096, 8 do
        if #found >= 4 then break end
        if off ~= LAY_HINT[1] and off ~= LAY_HINT[2] and off ~= LAY_HINT[3] then consider(off) end
    end
    if #found == 0 then return nil end
    return found
end

-- SECOND LOOK, dt seconds after the first. Fills LAY and returns true, or returns false and why.
-- Neither look yields: the caller waits between them, OUTSIDE any pcall.
local function layDecide(A, found, dt)
    if type(dt) ~= "number" or dt < 0.05 then return false, "clock did not advance" end
    local why = "no animation was playing to measure"
    for li = 1, #found do
        local L = found[li]
        local sig, n, clash, live = nil, 0, false, false
        for ti = 1, #L.tracks do
            local tr = L.tracks[ti]
            local t = tr.t
            if n < 4 and rptr(t + tr.owners[1]) == A then      -- still the same object
                -- TimePosition: it advanced, at the rate the float before it (Speed) says.
                -- Timed against THIS track's own first sample: the tracks are sampled one after
                -- another, and one shared interval read every later track as faster than it is.
                local el = os.clock() - tr.at
                if el < 0.05 then el = dt end
                local op, nOp = nil, 0
                for o = 100, 400, 4 do
                    local a, b, s = tr.f[o], rflt(t + o), tr.f[o - 4]
                    if a and b and s and a >= 0 and b > a and b < 36000 and s >= 0.05 and s <= 30 then
                        if math.abs((b - a) / el - s) <= 0.25 * s + 0.05 then op = o; nOp = nOp + 1 end
                    end
                end
                if nOp == 1 then
                    local w, wt = rflt(t + op + 4), rflt(t + op + 8)
                    local om, oi = nil, nil
                    for m = 96, 400, 8 do
                        local p = rptr(t + m)
                        if layPtr(p) and p ~= A then
                            for i = 96, 400, 8 do
                                if layIsAsset(layStr(p + i)) then om, oi = m, i break end
                            end
                        end
                        if om then break end
                    end
                    if om and w and wt and w >= 0 and w <= 1.001 and wt >= 0 and wt <= 1.001 then
                        if w > 0.5 and wt > 0.5 then live = true end
                        if sig == nil then
                            sig = { op = op, om = om, oi = oi, owners = tr.owners }
                        elseif sig.op ~= op or sig.om ~= om or sig.oi ~= oi then
                            clash = true
                        else
                            -- keep only the owner offsets every track shares
                            local keep = {}
                            for a1 = 1, #sig.owners do
                                for a2 = 1, #tr.owners do
                                    if sig.owners[a1] == tr.owners[a2] then keep[#keep + 1] = sig.owners[a1] end
                                end
                            end
                            sig.owners = keep
                        end
                        n = n + 1
                    end
                end
            end
        end
        if sig and not clash and #sig.owners == 1 and live then
            LAY.OA, LAY.OO, LAY.OM, LAY.OI = L.off, sig.owners[1], sig.om, sig.oi
            LAY.OS, LAY.OP, LAY.OW, LAY.OWT = sig.op - 4, sig.op, sig.op + 4, sig.op + 8
            LAY.ok, LAY.why, LAY.n = true, "ok", n
            return true
        elseif clash then
            why = "tracks disagree about the layout"
        elseif sig and #sig.owners ~= 1 then
            why = "owner field is ambiguous"
        elseif sig then
            why = "blend weights not confirmed yet"
        end
    end
    return false, why
end
-- ---- /animator layout ----

-- Animation-pointer keyed (NOT track-keyed): tracks are pooled and a freed track's address gets
-- reused, which would return a previous swing's id.
local IDC = {}
local function trackId(t)
    local ap = rptr(t + OM)
    if not ap or ap < 0x10000 then return nil end
    local k = ap
    local e = IDC[k]
    local now = os.clock()
    if e and (now - e[2]) < 30 then return e[1] end
    local id = idNum(readStr(ap + OI)) or false
    IDC[k] = { id, now }
    return id
end

-- Copy a located layout into the short names the hot paths use. Ids cached before this were read
-- through no layout at all, so the cache starts over.
local function layAdopt()
    OA, OO, OM, OI = LAY.OA, LAY.OO, LAY.OM, LAY.OI
    OS, OP, OW, OWT = LAY.OS, LAY.OP, LAY.OW, LAY.OWT
    IDC = {}
end

-- Second half of the liveness test: is TimePosition actually ADVANCING?
-- Weight alone is not enough — measured live, a swing track sat at FULL weight for 24.6 seconds
-- with its TimePosition frozen. Tracking that as a live swing is the stale-swing bait all over
-- again. A frozen track is also exactly what onHoldBasicBladeSwing produces when someone holds a
-- charge, which must never be committed to.
-- The 0.15s grace matters: we sample far faster than the animation updates (render rate), so most
-- individual samples legitimately show no change.
local TPW = {}
local TPWn = 0
local function advancing(t, tp, now)
    local r = TPW[t]
    if not r then
        if TPWn >= 400 then
            -- bound the table by dropping only records that have not moved lately (emptying
            -- it wholesale made every long-frozen track look newly seen again)
            local keep, n = {}, 0
            for k, v in pairs(TPW) do
                if now - v[2] < 2 then keep[k] = v; n = n + 1 end
            end
            if n >= 400 then keep, n = {}, 0 end
            TPW, TPWn = keep, n
        end
        -- First seen at the START of its timeline = a swing that has just begun: trust it.
        -- First seen mid-timeline has to be SEEN moving first. It used to count as live on
        -- sight, and "mid-timeline and not moving" is exactly a held charge (or a finished
        -- track still in the list): someone flying in holding one got a parry pressed at them
        -- the moment they crossed the watch radius, which is a 5 second lockout for nothing.
        local early = tp < 0.10
        TPW[t] = { tp, early and now or (now - 1) }
        TPWn = TPWn + 1
        return early
    end
    if tp > r[1] + 0.0005 then r[1] = tp; r[2] = now; return true end
    if tp < r[1] - 0.05 then r[1] = tp; r[2] = now; return true end   -- looped/restarted
    return (now - r[2]) < 0.15
end

-- One walk, one pass: returns the first id found from `want`, plus its track pointer and TimePosition.
-- The owner check is load-bearing: foreign tracks genuinely appear in this list.
local function scan(A, want)
    if not LAY.ok then return nil end
    local head = rptr(A + OA)
    if not head or head < 0x10000 then return nil end
    local node, guard = rptr(head + ON), 0
    while node and node > 0x10000 and node ~= head and guard < 64 do
        guard = guard + 1
        local t = rptr(node + OT)
        if t and t > 0x10000 and rptr(t + OO) == A then
            local id = trackId(t)
            if id and want[id] then
                -- liveness: only a track that is actually blended in counts
                local wt = rflt(t + OWT)
                local w = rflt(t + OW)
                if wt and w and wt > 0.5 and w > 0.05 then
                    local tp = rflt(t + OP) or 0
                    if advancing(t, tp, os.clock()) then
                        return id, t, tp
                    end
                end
            end
        end
        node = rptr(node + ON)
    end
    return nil
end

-- distance from point P to segment AB (this is exactly the shape the game raycasts)
local function segDist(px, py, pz, ax, ay, az, bx, by, bz)
    local abx, aby, abz = bx - ax, by - ay, bz - az
    local apx, apy, apz = px - ax, py - ay, pz - az
    local ab2 = abx * abx + aby * aby + abz * abz
    local t = 0
    if ab2 > 0.000001 then
        t = (apx * abx + apy * aby + apz * abz) / ab2
        if t < 0 then t = 0 elseif t > 1 then t = 1 end
    end
    local cx, cy, cz = (ax + abx * t) - px, (ay + aby * t) - py, (az + abz * t) - pz
    return math.sqrt(cx * cx + cy * cy + cz * cz)
end

-- closest approach of P0 + V*t over t in [0, tmax]; returns (distance, t)
local function closest(px, py, pz, vx, vy, vz, tmax)
    local vv = vx * vx + vy * vy + vz * vz
    local t = 0
    if vv > 0.000001 then t = -((px * vx + py * vy + pz * vz) / vv) end
    if t < 0 then t = 0 elseif t > tmax then t = tmax end
    local dx, dy, dz = px + vx * t, py + vy * t, pz + vz * t
    return math.sqrt(dx * dx + dy * dy + dz * dz), t
end

-- Same question but under CONSTANT ACCELERATION, solved by sampling instead of a closed form.
-- Why: at 200ms ping we are forced to predict 100-150ms ahead, and when BOTH players are grappling
-- a straight-line extrapolation is badly wrong — a grapple reel accelerates hard, and the error
-- scales with both players' speed. That is the mutual-movement case. Returns the FIRST time the
-- separation drops inside `thresh` (not the global minimum), because we want to guard the moment
-- contact becomes possible, not the deepest point of the pass.
local function firstContact(px, py, pz, vx, vy, vz, ax, ay, az, thresh, horizon)
    local bestD, bestT = 1000000000, nil
    for i = 0, 12 do
        local t = horizon * i / 12
        local h = 0.5 * t * t
        local qx = px + vx * t + ax * h
        local qy = py + vy * t + ay * h
        local qz = pz + vz * t + az * h
        local d = math.sqrt(qx * qx + qy * qy + qz * qz)
        if d <= thresh then return t, d end
        if d < bestD then bestD = d; bestT = t end
    end
    return nil, bestD, bestT
end

-- Roster: plain strings/numbers only. Matcha returns a distinct shim per access, so a shim can
-- never be a table key and `a == b` is always false for the same instance.
local function rebuildRoster()
    local out = {}
    local myName = LP.Name
    local myTeam = nil
    pcall(function() myTeam = LP.Team and LP.Team.Name or nil end)
    for _, p in ipairs(Players:GetPlayers()) do
        local nm = nil
        pcall(function() nm = p.Name end)
        if nm and nm ~= myName then
            local c = p.Character
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            local an = hum and hum:FindFirstChildOfClass("Animator")
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if an and hrp then
                local okA, ad = pcall(function() return tonumber(an.Address) end)
                if okA and ad and ad > 0x10000 then
                    local tn = nil
                    pcall(function() tn = p.Team and p.Team.Name or nil end)
                    -- nil-safe: in FFA everyone's Team is nil, and `nil ~= nil` is false, which
                    -- would otherwise reject the whole server.
                    if not (myTeam ~= nil and tn ~= nil and tn == myTeam) then
                        -- Carry cached state across rebuilds, keyed by the CHARACTER ADDRESS.
                        -- `prev.char == c` would be a shim comparison — always false — so the blade
                        -- tips would be re-resolved every rebuild (~6.5ms each) forever.
                        local ca = nil
                        pcall(function() ca = tostring(c.Address) end)
                        local prev = nil
                        for _, o in ipairs(AP.Roster) do if o.name == nm then prev = o break end end
                        local keep = (prev and ca and prev.charAddr == ca)
                        out[#out + 1] = {
                            name = nm, A = ad, hrp = hrp, char = c, charAddr = ca,
                            tips = keep and prev.tips or nil,
                            span = keep and prev.span or nil,
                            -- carried so a roster rebuild mid-approach cannot drop the swing latch
                            swingAt = (prev and prev.swingAt) or nil,
                            parryAt = (prev and prev.parryAt) or 0,
                            wasParry = (prev and prev.wasParry) or false,
                        }
                    end
                end
            end
        end
    end
    AP.Roster = out
end

-- Resolve the outermost blade part per hand ONCE per character. GetDescendants over the gear costs
-- ~6.5ms, so it must never run on the commit path — it is done lazily the first time a player
-- actually becomes a threat, then cached.
local function resolveTips(e)
    if e.tips then return e.tips end
    local tips = {}
    local root = nil
    pcall(function() root = e.hrp.Position end)
    if not root then return tips end   -- don't cache a failure; retry next time
    for _, side in ipairs({ "LeftGearHandle", "RightGearHandle" }) do
        local gh = nil
        pcall(function() gh = e.char:FindFirstChild(side) end)
        if gh then
            local kids = nil
            pcall(function() kids = gh:GetDescendants() end)
            local best, bestd = nil, -1
            if kids then
                for _, d in ipairs(kids) do
                    -- EVERY read is guarded individually. Measured live: only 4 of the 20 BaseParts
                    -- under a gear handle return a readable .Position — the rest come back nil. A
                    -- single pcall around the whole loop aborts on the first of those, which left
                    -- the tip list EMPTY and meant the parry could never fire.
                    local isPart = false
                    pcall(function() isPart = d:IsA("BasePart") end)
                    if isPart then
                        local pv = nil
                        pcall(function() pv = d.Position end)
                        if pv then
                            local vx, vy, vz = pv.X - root.X, pv.Y - root.Y, pv.Z - root.Z
                            local dd = math.sqrt(vx * vx + vy * vy + vz * vz)
                            local sz = nil
                            pcall(function() sz = d.Size end)
                            if sz then dd = dd + sz.Z * 0.5 end
                            if dd > bestd then bestd = dd; best = d end
                        end
                    end
                end
            end
            if best then
                tips[#tips + 1] = best
                -- Their real blade span, measured from their own gear rather than assumed. The
                -- fast-closer path needs this to know how far out their blade can reach.
                if bestd > (e.span or 0) then e.span = bestd end
            end
        end
    end
    -- Only cache a SUCCESSFUL resolve, so a transient nil read cannot permanently disarm this player.
    if #tips > 0 then e.tips = tips end
    return tips
end

local function press()
    local vk = AP.Key
    if not vk then return end
    AP.Presses = AP.Presses + 1
    AP.LastPress = os.clock()
    AP.PressAt = AP.LastPress
    GUI._injVK, GUI._injAt = vk, AP.LastPress   -- so the Player List search doesn't type our F
    pcall(keypress, vk)
    AP.Armed = AP.LastPress
end

-- ---------- enemy parry-cooldown readout ----------
local ESPPool = {}
local function espText(i)
    local t = ESPPool[i]
    if not t then
        local ok, d = pcall(Drawing.new, "Text")
        if not ok or not d then return nil end
        pcall(function()
            d.Size = 16; d.Center = true; d.Outline = true
            d.Font = Drawing.Fonts.System; d.Visible = false; d.ZIndex = 9
            d.Color = Color3.fromRGB(255, 95, 95)
        end)
        ESPPool[i] = d
        t = d
    end
    return t
end

-- One token per run of the menu, held in _G. _G survives a re-run of the script; AP and GUI do
-- not (they are new tables every time), so the old test, a generation counter kept ON the AP
-- table, was true forever and a re-run left the PREVIOUS copy's parry and swing loops running
-- behind a menu that showed them
-- off. Each loop below now stops the moment a newer copy takes the token: the swing loop hands
-- its speeds back on the way out and the parry loop releases its key.
local myGen = {}
_G.__RQ_AUTOPARRY = myGen

-- ============================================================
-- FAST SWING  —  local playback speed on your OWN swing animations
-- ============================================================
-- Writes AnimationTrack.Speed on your own swing tracks. Entirely local: it changes how fast YOUR
-- client plays the animation. Nothing is sent to the server, no remote is touched.
--   tap / release : play the slash at Swing Speed, then zoom the recovery tail at Recovery Speed so
--                   you become actionable again sooner
--   M1 held       : with Charge Hold on, boost only the windup and then go COMPLETELY hands-off, so
--                   the game parks the charge at that animation's own keyframe.
--
-- WHY IT WAS DEAD (fixed in v5.5): not the matching, the memory layout. Every offset this read was
-- a constant from an older Roblox build, so the "is this MY track" test failed on every track and
-- no speed was ever written. The offsets are now located at runtime (the "animator layout" block).
--
-- MATCHING is the rule set of the standalone Fast swing.lua v4, which replaced the
-- ambient-denylist version that used to live here:
--   * strict allowlist: the seeded swing ids, plus ids LEARNED from a real swing signature -- the
--     track APPEARS, at the very start of its timeline, within 0.3s of an M1 press. Locomotion is
--     already playing and mid-timeline when you click, so it does not qualify. (The old rule,
--     "anything not yet seen while idle is an attack", sped up running, jumping and grappling.)
--   * anything seen advancing while you are NOT attacking is ambient and can never be learned
--     KNOWN LIMIT, inherited from v4: something that is not a swing but happens to START inside a
--     click, before it was ever seen without one (a jump on the same instant), is learned too.
--     That is what the Relearn Animations button is for.
--   * the parry and the stuns are never touched: the parry window is opened by a KEYFRAME inside
--     the parry animation, and racing it means the keyframe never fires
-- Two things v4 got wrong are fixed here rather than copied:
--   * it learned an animation's length from the running maximum of TimePosition DURING the first
--     play, so "45% of the length" was always behind the playhead and the slash itself got the
--     recovery speed. Length now comes only from a play that has ENDED, and it can only move the
--     slash / recovery cut LATER than the fixed default (long Crossguard swings), never earlier.
--   * its "never slow a track down" guard compared against the speed it had itself just written,
--     so a Recovery Speed below Swing Speed never applied. The game's own speed is now remembered
--     separately from ours (see fsSetSpeed).
local FS = {
    -- same two-stage arrangement as Auto Parry: pill arms, hotkey runs
    Enabled = false,
    On = false,
    Key = 0x48,        -- H
    Swing = 1.0,       -- playback rate for the active slash / windup boost
    Recovery = 8.0,    -- playback rate for the recovery tail
    -- How much of the animation the charge boost covers before going hands-off. Fixed rather than
    -- exposed: it only shapes the brief windup boost while M1 is HELD, and the value that matters
    -- is that it ends early enough for the game to park the charge at its own keyframe.
    Windup = 0.36,
    Slash = 0.35,      -- animation time that still counts as the slash rather than the tail
    M1 = false, M1At = 0, Phase = "-", Hz = 0,
    Ambient = {}, AmbientN = 0,   -- ids seen advancing while NOT attacking: a veto on learning
    Learned = {}, LearnedN = 0,   -- ids learned from a swing signature
    Len = {},                     -- [animId] = length, from plays that have ended
    Tracks = 0, Hits = 0,         -- last pass: tracks walked / tracks sped. Diagnostics.
    Rate = 0,                     -- playback rate MEASURED on the last sped track: the proof it works
    UpAt = 0,                     -- when M1 was last released; ambient sampling waits on this
    HoldMode = false,             -- see the FS.HoldMode branch in fsApply
    Layout = "not located yet",   -- why the animator layout is not usable yet, or nil when it is
}
GUI.FS = FS
pcall(function() rawset(_G, "RQFS", FS) end)

-- Melee tool swings are included as well: this is purely local playback speed, so it helps every
-- weapon, not just the gear blades the parry cares about.
local FS_SWINGS = {}
for id in pairs(SWINGS) do FS_SWINGS[id] = true end
for _, id in ipairs({ "112666168396669", "86140055867484", "124361532701064", "136621055776523",
                      "82666636655771", "75659520618730", "89635808450635" }) do FS_SWINGS[id] = true end
-- Keyframe-gated animations: never raced, never learned.
local FS_NEVER = { [ANIM_PARRY] = true }
for id in pairs(STUNS) do FS_NEVER[id] = true end

local FS_QUIET = 1.5       -- M1 up this long before the tracks then advancing count as ambient
local FS_TPEPS = 0.0005    -- TimePosition delta above which a track counts as advancing
local FS_LEARNWIN = 0.30   -- a track appearing this soon after an M1 press is a swing
local FS_SLASHFRAC = 0.45  -- once a length is known, this fraction of the animation is "slash"

-- Per-track memory, keyed by the track pointer and dropped the pass a track leaves the list
-- (pointers are pooled and reused): { id, tp, peak, pass, wrote, base, ra, rtp }
local FS_T = {}
local FS_PASS = 0
local FS_A = nil           -- the animator FS_T belongs to
-- Passes walked since FS_T was last emptied. On the first one EVERY track looks like it has just
-- appeared, so nothing may be learned from "appeared" until there is a previous pass to compare to.
local FS_RUN = 0

-- Set a track's speed without fighting the game.
--   * A speed that is not the one WE last wrote was put there by the game: 1 for a normal swing,
--     something else if a stance scales it, 0 while it parks a held charge on its keyframe. That
--     is remembered as the track's base.
--   * base 0  -> hands off entirely until the game restarts it.
--   * a speed-up never goes below the base (1.0 on the slider really means "unchanged").
-- Returns false when the track was left alone.
local function fsSetSpeed(t, r, want)
    local cur = rflt(t + OS)
    if not cur then return false end
    if r.wrote == nil or math.abs(cur - r.wrote) > 0.001 then r.base = cur end
    if r.base < 0.01 then r.wrote = nil; return false end
    if want >= 1 and want < r.base then want = r.base end
    if math.abs(cur - want) > 0.001 then pcall(memory_write, "float", t + OS, want) end
    r.wrote = want
    return true
end

-- Give every track we are still holding its own speed back. Runs when Fast Swing goes off and on
-- unload, so nothing stays sped up behind a switch that says off.
local function fsRelease()
    if LAY.ok and FS_A then
        for t, r in pairs(FS_T) do
            if r.wrote and r.base and r.base >= 0.01 and rptr(t + OO) == FS_A then
                local cur = rflt(t + OS)
                if cur and math.abs(cur - r.wrote) <= 0.001 and math.abs(cur - r.base) > 0.001 then
                    pcall(memory_write, "float", t + OS, r.base)
                end
            end
        end
    end
    FS_T = {}
    FS_RUN = 0
end

-- "Relearn Animations". Speeds are handed back FIRST: an id that has been forgotten is never
-- written again, so anything still playing would otherwise keep the last speed it was given.
function FS.Reset()
    fsRelease()
    FS.Ambient, FS.AmbientN, FS.Learned, FS.LearnedN, FS.Len = {}, 0, {}, 0, {}
end

local function fsApply(now)
    if not LAY.ok then FS.Phase = "-"; FS.Tracks, FS.Hits = 0, 0; return end
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local an = hum and hum:FindFirstChildOfClass("Animator")
    if not an then return end
    local okA, A = pcall(function() return tonumber(an.Address) end)
    if not (okA and A) then return end
    local head = rptr(A + OA)
    if not head or head < 0x10000 then return end
    if A ~= FS_A then FS_T = {}; FS_RUN = 0; FS_A = A end      -- respawned: a different animator

    -- Ambient is only sampled well clear of any attack: swings run ~0.85s and the recovery zoom
    -- cuts that shorter, so 1.5s of M1 being up means whatever is still advancing is locomotion.
    local quiet = (not FS.M1) and (now - (FS.UpAt or 0)) > FS_QUIET
    local onClick = FS_RUN >= 1 and FS.M1 and (now - (FS.M1At or 0)) < FS_LEARNWIN
    local nTracks, nHits = 0, 0
    FS_PASS = FS_PASS + 1

    local node, guard = rptr(head + ON), 0
    while node and node > 0x10000 and node ~= head and guard < 64 do
        guard = guard + 1
        local t = rptr(node + OT)
        if t and t > 0x10000 and rptr(t + OO) == A then
            local id = trackId(t)
            if id and not FS_NEVER[id] then
                nTracks = nTracks + 1
                local tp = rflt(t + OP) or 0
                local r = FS_T[t]
                local fresh = (r == nil) or (r.id ~= id)
                if fresh then
                    -- not here last pass (or a recycled pointer now playing something else)
                    if r and r.peak > (FS.Len[r.id] or 0) then FS.Len[r.id] = r.peak end
                    r = { id = id, tp = tp, peak = tp }
                    FS_T[t] = r
                end
                r.pass = FS_PASS
                local adv = (not fresh) and math.abs(tp - r.tp) > FS_TPEPS
                local since = now - (r.mv or now)   -- how long the playhead had been standing still
                if adv then
                    r.mv = now
                    if tp < r.tp - 0.05 then
                        -- It restarted, so the play that just ended shows how long this animation
                        -- is. Only a FINISHED play counts: the running maximum during a play is
                        -- just the playhead, and using it put the cut behind the playhead.
                        if r.peak > (FS.Len[id] or 0) then FS.Len[id] = r.peak end
                        r.peak = tp
                        r.ra = nil
                    elseif tp > r.peak then
                        r.peak = tp
                    end
                elseif since > 0.25 and r.peak > (FS.Len[id] or 0) then
                    -- Standing still: that play is over (or parked on a held charge). If the game
                    -- makes a NEW track for every swing, a finished one never "restarts" and only
                    -- leaves the list 20+ seconds later, which is how late the length was learned.
                    -- Safe to take now: a length can only move the cut LATER, never earlier.
                    FS.Len[id] = r.peak
                end
                r.tp = tp

                local known = FS_SWINGS[id] or FS.Learned[id]
                -- Ambient is a VETO on learning, never a positive signal.
                if quiet and adv and not known and not FS.Ambient[id] then
                    FS.Ambient[id] = true
                    FS.AmbientN = FS.AmbientN + 1
                end
                -- The swing signature: it APPEARED, at the start of its timeline, on a click.
                if not known and not FS.Ambient[id] and fresh and onClick and tp < 0.10 then
                    FS.Learned[id] = true
                    FS.LearnedN = FS.LearnedN + 1
                    known = true
                end

                if known then
                    nHits = nHits + 1
                    local cut = FS.Slash
                    local len = FS.Len[id]
                    if len and len * FS_SLASHFRAC > cut then cut = len * FS_SLASHFRAC end
                    if FS.M1 and FS.HoldMode then
                        -- OPT-IN, off by default. Charging and chain-swinging both look exactly
                        -- like "M1 is down" and nothing in the animator separates them, so forcing
                        -- this on meant holding M1 to chain swings boosted only each windup and
                        -- then went hands-off, which read as the feature doing nothing.
                        if tp < FS.Windup then
                            fsSetSpeed(t, r, FS.Swing)
                            FS.Phase = "charge boost"
                        else
                            FS.Phase = "held (hands off)"
                        end
                    elseif tp < cut then
                        FS.Phase = fsSetSpeed(t, r, FS.Swing) and "slash" or "charge held by game"
                    else
                        FS.Phase = fsSetSpeed(t, r, FS.Recovery) and "recovery zoom" or "charge held by game"
                    end
                    -- Measure what the track is really doing: the readout that shows the write
                    -- taking effect. Both ends of the window are instants the playhead MOVED, so
                    -- the dead time after a swing ends is never counted (that read 0.5x on a 2x
                    -- swing). Expect roughly the number asked for, not exactly it.
                    -- A window also restarts whenever the speed we asked for changes, so it
                    -- never straddles the slash and the tail; and it may close after 3 moves /
                    -- 30ms, because an 8x tail is over in ~60ms and a 0.1s window never fit in it.
                    if adv then
                        if not r.ra or tp < r.rtp or r.rw ~= r.wrote or since > 0.1 then
                            r.ra, r.rtp, r.rw, r.rn = now, tp, r.wrote, 0
                        else
                            r.rn = r.rn + 1
                            if now - r.ra >= 0.1 or (r.rn >= 3 and now - r.ra >= 0.03) then
                                FS.Rate = (tp - r.rtp) / (now - r.ra)
                                r.ra, r.rtp, r.rn = now, tp, 0
                            end
                        end
                    end
                end
            end
        end
        node = rptr(node + ON)
    end
    -- Forget tracks that left the list, keeping what their last play taught us.
    for t, r in pairs(FS_T) do
        if r.pass ~= FS_PASS then
            if r.peak > (FS.Len[r.id] or 0) then FS.Len[r.id] = r.peak end
            FS_T[t] = nil
        end
    end
    FS_RUN = FS_RUN + 1
    FS.Tracks, FS.Hits = nTracks, nHits
end

-- LOCATING THE LAYOUT. Its own thread, because it has to look twice a quarter of a second apart
-- and that wait must sit OUTSIDE any pcall. Runs only while a feature that needs it is armed,
-- and stops for good once it has an answer.
task.spawn(function()
    local told = false
    while GUI.Running and _G.__RQ_AUTOPARRY == myGen do
        if not LAY.ok and (AP.Enabled or FS.Enabled) then
            local A = nil
            pcall(function()
                local ch = LP.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                local an = hum and hum:FindFirstChildOfClass("Animator")
                A = an and tonumber(an.Address) or nil
            end)
            if not A then
                LAY.why = "no character yet"
            else
                local okL, found = pcall(layLook, A)
                if okL and found then
                    local t0 = os.clock()
                    task.wait(1 / 4)
                    local okD, good, why = pcall(layDecide, A, found, os.clock() - t0)
                    if okD and good then
                        layAdopt()
                    elseif okD then
                        LAY.why = tostring(why)
                    else
                        LAY.why = "error: " .. tostring(good)
                    end
                elseif okL then
                    LAY.why = "no track list on this animator"
                else
                    LAY.why = "error: " .. tostring(found)
                end
                LAY.tries = LAY.tries + 1
                -- One message, and only after it has genuinely kept failing (~15s).
                if not LAY.ok and LAY.tries >= 12 and not told then
                    told = true
                    pcall(function()
                        uiNotify("Fast Swing / Auto Parry", "Cannot read animations on this Roblox build (" .. tostring(LAY.why) .. ")", 8)
                    end)
                end
            end
        end
        FS.Layout = (not LAY.ok) and LAY.why or nil
        task.wait(1)
    end
end)

task.spawn(function()
    local wasK, ready, wasLive = false, false, false
    local hzN, hzT = 0, os.clock()
    while GUI.Running and _G.__RQ_AUTOPARRY == myGen do
        pcall(function()
            local now = os.clock()
            hzN = hzN + 1
            if now - hzT >= 1 then FS.Hz = hzN / (now - hzT); hzN, hzT = 0, now end

            -- M1 edge, read here rather than on its own thread: ismouse1pressed is executor-local
            -- and effectively free, so it costs nothing to sample it in the same loop.
            local m1 = false
            pcall(function() m1 = ismouse1pressed() and true or false end)
            if m1 and not FS.M1 then FS.M1At = now end      -- press edge: the learn window
            if (not m1) and FS.M1 then FS.UpAt = now end    -- release edge: ambient sampling
            FS.M1 = m1

            -- hotkey, with the same release-arm guard the parry uses
            local d = false
            pcall(function() d = iskeypressed(FS.Key) and true or false end)
            if not ready then
                if not d then ready = true end
            elseif d and not wasK and FS.Enabled and not (GUI.PLTyping and GUI.PLTyping(FS.Key)) then
                -- only meaningful while armed, and it must NOT move the pill
                FS.On = not FS.On
                pcall(function() uiNotify("Fast Swing", FS.On and "ON" or "OFF", 2) end)
            end
            wasK = d

            -- A heartbeat the standalone Fast swing.lua reads, so it can tell a live, armed menu
            -- from a table a dead copy left in _G, and stand down instead of fighting over H.
            FS.Beat = now
            local live = FS.Enabled and FS.On
            if live then
                fsApply(now)
            else
                if wasLive then fsRelease() end
                FS.Phase = "-"
            end
            wasLive = live
        end)
        task.wait((FS.Enabled and FS.On) and 1 / 200 or 1 / 30)
    end
    pcall(fsRelease)
end)

task.spawn(function()
    local hzN, hzT = 0, os.clock()
    local wasToggle, toggleReady = false, false
    while GUI.Running and _G.__RQ_AUTOPARRY == myGen do
        local ok, err = pcall(function()
            local now = os.clock()
            hzN = hzN + 1
            if now - hzT >= 1 then AP.Hz = hzN / (now - hzT); hzN, hzT = 0, now end
            -- Measured tick period drives the commit lead. Sleep is the dominant latency here:
            -- task.wait(1/120) actually costs 10.2ms on this build (98Hz), and we need two samples
            -- to differentiate the blade, so a fixed 0.12s lead left almost no margin once input
            -- and network delay were added. That is the "parries late" case.
            if AP.LastTick then
                local d = now - AP.LastTick
                if d > 0 and d < 0.25 then AP.Dt = (AP.Dt or d) * 0.9 + d * 0.1 end
            end
            AP.LastTick = now

            -- toggle hotkey, with the release-arm guard: Matcha's iskeypressed can report a key
            -- permanently HELD, which would otherwise flip the feature on the very first frame.
            local td = false
            pcall(function() td = iskeypressed(AP.ToggleKey) and true or false end)
            if not toggleReady then
                if not td then toggleReady = true end
            elseif td and not wasToggle and AP.Enabled and not (GUI.PLTyping and GUI.PLTyping(AP.ToggleKey)) then
                -- only meaningful while armed, and it must NOT move the pill
                AP.On = not AP.On
                pcall(function() uiNotify("Auto Parry", AP.On and "ON" or "OFF", 2) end)
            end
            wasToggle = td

            -- release a held parry key promptly (edge-triggered keybind; a brief hold registers
            -- more reliably than an instant tap, but it must never be left down)
            if AP.Armed > 0 and (now - AP.Armed) > 0.05 then
                pcall(keyrelease, AP.Key)
                AP.Armed = 0
            end

            -- cleared every tick: an early return below must not leave the loop sprinting
            AP.Active = false
            if not AP.Enabled then AP.Status = "disabled"; AP.Near = 0; return end
            if not AP.On then AP.Status = "off (hotkey)"; AP.Near = 0; return end
            -- Nothing below can see an animation until the layout is located (see "animator
            -- layout"): say so rather than sit at "armed" while blind.
            if not LAY.ok then AP.Status = "reading animator layout (" .. tostring(LAY.why) .. ")"; AP.Near = 0; return end

            local ch = LP.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if not (hum and hrp) then AP.Status = "no character"; AP.Cand = {}; return end
            local hp = 0
            pcall(function() hp = hum.Health end)
            if hp <= 0 then AP.Status = "dead"; AP.Cand = {}; return end
            local myPos, myVel
            pcall(function() myPos = hrp.Position; myVel = hrp.AssemblyLinearVelocity end)
            if not (myPos and myVel) then return end

            -- MY acceleration. Needed because when we are BOTH grappling, the thing that has to be
            -- predicted is RELATIVE motion, and both halves of it are accelerating hard. Sampled on
            -- a ~50Hz baseline and smoothed, since frame-to-frame acceleration is very noisy.
            local mAx, mAy, mAz = 0, 0, 0
            if AP.pmv and AP.pmvT then
                local d = now - AP.pmvT
                if d > 0.02 and d < 0.3 then
                    mAx = (myVel.X - AP.pmv[1]) / d
                    mAy = (myVel.Y - AP.pmv[2]) / d
                    mAz = (myVel.Z - AP.pmv[3]) / d
                    AP.pmv = { myVel.X, myVel.Y, myVel.Z }
                    AP.pmvT = now
                    AP.ax = (AP.ax or 0) * 0.7 + mAx * 0.3
                    AP.ay = (AP.ay or 0) * 0.7 + mAy * 0.3
                    AP.az = (AP.az or 0) * 0.7 + mAz * 0.3
                end
            else
                AP.pmv = { myVel.X, myVel.Y, myVel.Z }
                AP.pmvT = now
            end

            local an = hum:FindFirstChildOfClass("Animator")
            local myA = nil
            if an then local o, a = pcall(function() return tonumber(an.Address) end); myA = o and a or nil end

            -- ONE walk of my own animator answers: did my press register (Gear.Parry playing), am I
            -- stunned, and did I just swing (PARRY_LOCKOUT_AFTER_SWING_END_SECONDS).
            local blocked, parrying = false, false
            if myA then
                local sid = scan(myA, PARRY_ONLY)
                if sid then parrying = true end
                if not sid then
                    if scan(myA, STUNS) then blocked = true end
                    local sw = scan(myA, SWINGS)
                    if sw then AP.MySwingAt = now end
                end
            end
            if AP.MySwingAt and (now - AP.MySwingAt) < C_SWING_LOCKOUT then blocked = true end

            -- Confirm the press. Our own Gear.Parry animation DOES replicate, so it is the ground
            -- truth for "the game accepted the input". Only a registered press starts a cooldown —
            -- a press the game ate (grapple, lockout, focus) must not blind us.
            if AP.PressAt > 0 then
                if parrying then
                    AP.Registered = AP.Registered + 1
                    -- Learn the real cooldown: if we ever register two parries closer together than
                    -- the model, the model was too pessimistic. Floor at the game's success window.
                    if AP.LastReg and (AP.PressAt - AP.LastReg) > 0.2 then
                        local gap = AP.PressAt - AP.LastReg
                        if gap < AP.CD then AP.CD = math.max(1.0, gap) end
                    end
                    AP.LastReg = AP.PressAt
                    AP.CoolUntil = AP.PressAt + AP.CD
                    AP.PressAt = 0
                elseif (now - AP.PressAt) > 0.25 then
                    AP.PressAt = 0     -- never registered: no cooldown, allow a retry
                end
            end
            if parrying then blocked = true end
            if AP.CoolUntil and now < AP.CoolUntil then
                -- Probe occasionally: a press that REGISTERS proves we were not locked out, which is
                -- how AP.CD gets learned down from the pessimistic 5s. Bounded to one per second.
                if (now - (AP.ProbeAt or 0)) < 1.2 then blocked = true end
            end

            if now - AP.RosterAt > 2 then AP.RosterAt = now; rebuildRoster() end

            local bestT, bestE, bestD, bestK = 9, nil, 0, nil
            local bestClose = 0
            local near = 0

            -- PASS 1: cheap distance prefilter — one position read per player, and nothing else
            -- for anyone far away.
            local nearList = {}
            for _, e in ipairs(AP.Roster) do
                local epos
                pcall(function() epos = e.hrp.Position end)
                if epos then
                    local ndx, ndy, ndz = epos.X - myPos.X, epos.Y - myPos.Y, epos.Z - myPos.Z
                    local nd3 = math.sqrt(ndx * ndx + ndy * ndy + ndz * ndz)  -- 3D: air swings come from above and below
                    if nd3 < AP.Watch then
                        nearList[#nearList + 1] = { e = e, d = nd3, dx = ndx, dy = ndy, dz = ndz }
                    end
                end
            end
            table.sort(nearList, function(a, b) return a.d < b.d end)
            near = #nearList
            -- PASS 2: the expensive work (animator walk, blade reads) for the NEAREST few only, so
            -- a crowded server cannot stall the loop and make us late.
            local lim = near
            if lim > 8 then lim = 8 end
            for li = 1, lim do
                local nl = nearList[li]
                local e, d3 = nl.e, nl.d
                local dx, dy, dz = nl.dx, nl.dy, nl.dz
                do
                    do
                        -- ONE walk per player per tick, covering swings AND their parry. Two
                        -- separate scans would double the cost of the hottest path in the loop.
                        local aid, tptr = scan(e.A, WATCHED)
                        local sid = (aid and SWINGS[aid]) and aid or nil

                        -- enemy parry-cooldown readout (rising edge of their Gear.Parry)
                        local isParry = (aid == ANIM_PARRY)
                        if isParry and not e.wasParry then e.parryAt = now end
                        e.wasParry = isParry
                        if sid then e.parryAt = 0 end   -- they are swinging, so not locked out

                        -- ================= PATH 2: the fast closer =================
                        -- The blade-sweep test below is precise, but it only runs WHILE the swing
                        -- animation is playing. A player who slashes early at range and then
                        -- grapples in finishes that animation in mid-air, so the weight gate drops
                        -- them while they are still inbound and the sweep test never gets to run —
                        -- then they arrive and the hit lands. That is the case that felt unparryable.
                        --
                        -- So: latch the swing, and for anyone CLOSING FAST predict when their body
                        -- arrives inside blade range instead of waiting for the tip to reach us.
                        -- Gating on closing speed is what keeps this from re-introducing the bait —
                        -- a stationary attacker swinging at air has ~zero closing speed and can
                        -- never take this path.
                        if sid then e.swingAt = now end
                        if e.swingAt and (now - e.swingAt) < 1.0 then
                            local evel
                            pcall(function() evel = e.hrp.AssemblyLinearVelocity end)
                            if evel then
                                -- their acceleration, same treatment as ours
                                if e.pv and e.pvT then
                                    local pd2 = now - e.pvT
                                    if pd2 > 0.02 and pd2 < 0.3 then
                                        e.ax = (e.ax or 0) * 0.7 + ((evel.X - e.pv[1]) / pd2) * 0.3
                                        e.ay = (e.ay or 0) * 0.7 + ((evel.Y - e.pv[2]) / pd2) * 0.3
                                        e.az = (e.az or 0) * 0.7 + ((evel.Z - e.pv[3]) / pd2) * 0.3
                                        e.pv = { evel.X, evel.Y, evel.Z }
                                        e.pvT = now
                                    end
                                else
                                    e.pv = { evel.X, evel.Y, evel.Z }
                                    e.pvT = now
                                end
                                local vdx = evel.X - myVel.X
                                local vdy = evel.Y - myVel.Y
                                local vdz = evel.Z - myVel.Z
                                -- LAG COMPENSATION. Their position is RTT/2 old; ours is current.
                                -- Extrapolate THEM forward so the geometry describes now, not then.
                                local lin = (AP.PingMs or 0) / 2000
                                local cdx = dx + evel.X * lin
                                local cdy = dy + evel.Y * lin
                                local cdz = dz + evel.Z * lin
                                local cd3 = math.sqrt(cdx * cdx + cdy * cdy + cdz * cdz)
                                local dx, dy, dz, d3 = cdx, cdy, cdz, cd3
                                local closing = 0
                                if d3 > 0.01 then closing = -((dx * vdx + dy * vdy + dz * vdz) / d3) end
                                local bkey = "body:" .. e.name .. ":" .. string.format("%.2f", e.swingAt)
                                if closing > 30 and not AP.Fired[bkey] then
                                    -- Effective reach grows with closing speed because the game
                                    -- raycasts each DmgPoint along its OWN per-frame displacement —
                                    -- at 300 studs/s that is ~5 extra studs per frame. This is the
                                    -- mechanism behind "he hit me from further than he should".
                                    local reach = (e.span or 6.5) + AP.BodyR + closing * (1 / 60)
                                    -- RELATIVE acceleration: this is the term that was missing, and
                                    -- it is exactly what makes a mutual grapple fight different from
                                    -- a one-sided approach.
                                    local rax = (e.ax or 0) - (AP.ax or 0)
                                    local ray = (e.ay or 0) - (AP.ay or 0)
                                    local raz = (e.az or 0) - (AP.az or 0)
                                    local tHit = firstContact(dx, dy, dz, vdx, vdy, vdz, rax, ray, raz, reach, 0.8)
                                    if tHit and tHit < bestT then
                                        bestT = tHit
                                        bestE = e
                                        bestD = reach
                                        bestK = bkey
                                        bestClose = closing
                                    end
                                end
                            end
                        end

                        if sid and tptr then
                            local key = e.name .. ":" .. tostring(tptr) .. ":" .. sid
                            if not AP.Fired[key] then
                                -- Only now is it worth resolving their blade tips (one-off ~6.5ms,
                                -- deliberately off the commit path).
                                local tips = resolveTips(e)
                                for ti = 1, #tips do
                                    local tip = tips[ti]
                                    local tpos
                                    pcall(function() tpos = tip.Position end)
                                    if tpos then
                                        -- index, NOT tostring(tip): tostring on a shim yields the
                                        -- part's Name, and both blade tips are often named the same.
                                        local ckey = key .. ":" .. ti
                                        local rec = AP.Cand[ckey] or {}
                                        -- Differentiate the tip: this reproduces the game's own ray
                                        -- (origin = tip now, direction = tip movement this frame).
                                        local vx, vy, vz = 0, 0, 0
                                        local dt = now - (rec.t or 0)
                                        if rec.x and dt > 0.001 and dt < 0.25 then
                                            vx = (tpos.X - rec.x) / dt
                                            vy = (tpos.Y - rec.y) / dt
                                            vz = (tpos.Z - rec.z) / dt
                                            -- Lag-compensate the blade: what we see of them is
                                            -- RTT/2 old, so shift the whole swept segment forward
                                            -- along its own measured velocity before comparing it
                                            -- against our CURRENT position.
                                            local lin = (AP.PingMs or 0) / 2000
                                            local ax, ay, az = rec.x + vx * lin, rec.y + vy * lin, rec.z + vz * lin
                                            local bx, by, bz = tpos.X + vx * lin, tpos.Y + vy * lin, tpos.Z + vz * lin
                                            -- the swept segment the game would raycast right now
                                            local sd = segDist(myPos.X, myPos.Y, myPos.Z, ax, ay, az, bx, by, bz)
                                            -- and where that tip is heading relative to me
                                            local rx = vx - myVel.X
                                            local ry = vy - myVel.Y
                                            local rz = vz - myVel.Z
                                            -- 0.8s horizon, not 0.45: a swing thrown at 118 studs
                                            -- while closing at 230 studs/s lands ~0.47s later, which
                                            -- the old horizon clipped right at the boundary.
                                            local thresh = AP.BodyR
                                            local rax = (e.ax or 0) - (AP.ax or 0)
                                            local ray = (e.ay or 0) - (AP.ay or 0)
                                            local raz = (e.az or 0) - (AP.az or 0)
                                            local pt = firstContact(bx - myPos.X, by - myPos.Y, bz - myPos.Z,
                                                rx, ry, rz, rax, ray, raz, thresh, 0.8)
                                            if sd <= thresh then
                                                if 0 < bestT then bestT = 0; bestE = e; bestD = sd; bestK = key end
                                            elseif pt and pt < bestT then
                                                bestT = pt; bestE = e; bestD = thresh; bestK = key
                                                -- relative closing speed of the BLADE, used to size
                                                -- the commit lead the same way the body path does
                                                local rs = math.sqrt(rx * rx + ry * ry + rz * rz)
                                                if rs > bestClose then bestClose = rs end
                                            end
                                        end
                                        rec.x, rec.y, rec.z, rec.t = tpos.X, tpos.Y, tpos.Z, now
                                        AP.Cand[ckey] = rec
                                    end
                                end
                            end
                        end
                    end
                end
            end
            AP.Near = near

            -- COMMIT. bestT is seconds until their blade sweep reaches my body. Press just before
            -- it lands; one press per swing track, and never faster than 0.3s apart.
            -- Commit lead = fixed input+network allowance + a few measured ticks of detection lag.
            -- Pressing early is cheap (the parry stays active ~1s); pressing late is a free hit.
            -- Scale the lead with closing speed. At 230 studs/s the attacker covers ~13 studs in the
            -- 55ms base lead, so a fixed lead is effectively late against a grapple-in. Pressing
            -- early is nearly free (the parry stays active ~1s per SUCCESSFUL_PARRY_WINDOW_SECONDS)
            -- whereas pressing late is a guaranteed hit, so the asymmetry says lead more, not less.
            -- OUTBOUND half of the ping: the server decides the parry, so the press has to be in
            -- flight this long before contact. The geometry above is already lag-compensated for
            -- the inbound half, so only RTT/2 is added here — adding the full RTT would double-count.
            local lout = (AP.PingMs or 0) / 2000
            local lead = 0.055 + lout + 3 * (AP.Dt or 0.01) + math.min(0.15, (bestClose or 0) * 0.0006)
            if lead > 0.45 then lead = 0.45 end
            AP.Lead = lead
            AP.Active = (bestE ~= nil)
            if bestE and not blocked and bestT <= lead and (now - AP.LastPress) > 0.3 then
                if AP.CoolUntil and now < AP.CoolUntil then AP.ProbeAt = now end
                press()
                -- one press per swing track: without this the commit predicate stays true for many
                -- consecutive ticks and a single swing turns into a burst of presses
                if bestK then AP.Fired[bestK] = true end
                AP.Status = string.format("PARRY %s  d=%.1f", bestE.name, bestD)
            elseif bestE then
                AP.Status = string.format("tracking %s  t=%.2f d=%.1f", bestE.name, bestT, bestD)
            elseif AP.CoolUntil and now < AP.CoolUntil then
                AP.Status = string.format("cooldown %.1fs", AP.CoolUntil - now)
            else
                AP.Status = "armed"
            end

            -- prune per-swing memory
            if now - (AP.PruneAt or 0) > 3 then
                AP.PruneAt = now
                AP.Cand = {}
                AP.Fired = {}
            end
        end)
        if not ok then
            AP.Err = AP.Err + 1
            AP.Status = "error"
            -- never leave the key down if the tick died between press and release
            pcall(keyrelease, AP.Key)
            AP.Armed = 0
        end
        -- ADAPTIVE RATE. Measured on this build: task.wait() costs 0.28ms (~3600Hz) while
        -- task.wait(1/120) actually costs 10.2ms (~98Hz). Sleeping 10ms per tick was the single
        -- largest source of "parries late". So we sprint only while a swing is actually in flight
        -- — a fraction of a second at a time — and idle cheaply the rest of the time.
        if AP.Active then
            task.wait()             -- ~3600Hz ceiling; real rate is set by the work below it
        elseif (AP.Near or 0) > 0 then
            task.wait(1 / 120)      -- someone nearby: stay responsive enough to catch a swing start
        else
            task.wait(1 / 60)       -- nobody near: cheap
        end
    end
    pcall(keyrelease, AP.Key)
end)


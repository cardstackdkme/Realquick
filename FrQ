                    local ky=rz.key=="pl" and "PlayerListY" or rz.key=="en" and "EnchantsY" or "RSDiffY"
                    local kw=rz.key=="pl" and "PlayerListW" or rz.key=="en" and "EnchantsW" or "RSDiffW"
                    local kh=rz.key=="pl" and "PlayerListH" or rz.key=="en" and "EnchantsH" or "RSDiffH"

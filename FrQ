                           math.max(0, math.min(255, math.floor(b + 0.5))) }
            end
            return out
        end
        local gd = data.gradients
        GUI.Grad.gas = stopsOK(gd.gas) or GUI.Grad.gas
        GUI.Grad.hp  = stopsOK(gd.hp)  or GUI.Grad.hp
        if type(gd.presets) == "table" then
            local ps = {}
            for _, p in ipairs(gd.presets) do
                local st = type(p) == "table" and stopsOK(p.stops)
                if st and #ps < 8 then

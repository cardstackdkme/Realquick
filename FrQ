-- ---------- Player List search box: typing ----------
-- WHY TYPING WAS DEAD: the keys were read by InputLoop's OLD Player List block, which only runs
-- while GUI.PlayerListElements is non-empty -- and nothing has filled that table since this engine
-- took over drawing the panel. Clicking focused the box (the caret showed) but no key ever reached
-- it. The keys are now polled here, in the same loop that draws the box.
--
-- Matcha can't swallow a key (it reads key state from outside the game), so every key typed here
-- ALSO reaches Roblox. Nothing here touches your character.
local PLI = { was = {}, box = nil, bsAt = 0, blink = 0, KEYS = {}, MAX = 20 }
for vk = 0x41, 0x5A do PLI.KEYS[vk] = { string.char(vk + 32), string.char(vk) } end        -- a-z, Shift = A-Z
for vk = 0x30, 0x39 do PLI.KEYS[vk] = { string.char(vk), false } end                       -- 0-9, Shift = symbol: ignored
for vk = 0x60, 0x69 do PLI.KEYS[vk] = { string.char(vk - 0x30), string.char(vk - 0x30) } end -- numpad 0-9
PLI.KEYS[0xBD] = { "_", "_" }   -- the minus key: Roblox names only ever contain underscores

-- Shared with the script's own hotkeys (InputLoop, Auto Parry, Fast Swing): true while the search
-- box has focus AND this key is one it uses, so typing "g" doesn't also flip Auto Parry and a typed
-- "3" doesn't close the list (Numpad3 is its default key). PLTypingAt is refreshed every frame the
-- box is serviced, so if this loop ever died with the box focused, the 0.5s staleness hands every
-- hotkey back on its own -- the unload key must never be lockable.
GUI.PLTyping = function(vk)
    if GUI.PLSearchFocused ~= true or vk == nil then return false end
    if (os.clock() - (GUI.PLTypingAt or 0)) >= 0.5 then return false end
    if PLI.KEYS[vk] ~= nil or vk == 0x08 or vk == 0x0D or vk == 0x1B then return true end
    -- Shift (capitals) and Ctrl (Ctrl+Backspace) are used by the box too, incl. their L/R codes
    return vk == 0x10 or vk == 0x11 or (vk >= 0xA0 and vk <= 0xA3)
end

-- Snapshot every key we watch as "already down", so a key held (or stuck -- Matcha's iskeypressed
-- can report one permanently held) at the moment you click the box is never typed.
function PLI.seed()
    for vk in pairs(PLI.KEYS) do PLI.was[vk] = iskeypressed(vk) and true or false end
    PLI.was[0x08] = iskeypressed(0x08) and true or false
    PLI.was[0x0D] = iskeypressed(0x0D) and true or false
    PLI.was[0x1B] = iskeypressed(0x1B) and true or false
    -- Park the Backspace repeat: a Backspace already held (or stuck) here must not start deleting.
    -- A fresh press takes the first-press branch in poll(), which sets the real repeat delay.
    PLI.bsAt = math.huge
end

function PLI.focus(on)
    on = on == true
    if GUI.PLSearchFocused == on then return end
    GUI.PLSearchFocused = on
    PLI.blink = 0
    PLI.ending = nil
    if on then
        GUI.PLTypingAt = os.clock()
        pcall(PLI.seed)
    end
end
-- Reached from UnloadScript, which is defined above this engine.
GUI.PLSearchCleanup = function() GUI.PLSearchFocused = false end

-- v4.1/v4.2 anchored your HumanoidRootPart while this box had focus. That is gone; this one-time
-- un-anchor on load frees a character an older build left frozen. Nothing in the game's client
-- anchors your own root part (Baking/Cooking anchor a cloned camera rig), so this undoes only ours.
pcall(function()
    local ch = Players.LocalPlayer and Players.LocalPlayer.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.Anchored = false end
end)

function PLI.poll(now)
    if not GUI.PLSearchFocused then return end
    if not GUI.PlayerListOpen then PLI.focus(false); return end
    GUI.PLTypingAt = now
    -- keys go to whatever window has focus: while Roblox is in the background they are not ours
    local active = true
    pcall(function() active = isrbxactive() and true or false end)
    if not active then pcall(PLI.seed); return end
    local text, changed = GUI.PLSearchText or "", false
    local shift = iskeypressed(0x10) and true or false
    local ctrl = iskeypressed(0x11) and true or false
    -- a key this script presses for you (Auto Parry's F) is not typing
    local injVK = (GUI._injAt and (now - GUI._injAt) < 0.2) and GUI._injVK or nil
    for vk, ch in pairs(PLI.KEYS) do
        local down = iskeypressed(vk) and true or false
        if down and not PLI.was[vk] and not ctrl and vk ~= injVK and #text < PLI.MAX then
            local c = ch[shift and 2 or 1]
            if c then text = text .. c; changed = true end
        end
        PLI.was[vk] = down
    end
    -- Backspace deletes (hold to repeat); Ctrl+Backspace clears the whole box
    local bs = iskeypressed(0x08) and true or false
    if bs and #text > 0 then
        if not PLI.was[0x08] then
            text = ctrl and "" or text:sub(1, -2); changed = true; PLI.bsAt = now + 0.45
        elseif now >= PLI.bsAt then
            text = text:sub(1, -2); changed = true; PLI.bsAt = now + 0.035
        end
    end
    PLI.was[0x08] = bs
    if changed then GUI.PLSearchText = text; GUI.PLScrollOffset = 0; PLI.blink = 0 end
    -- Enter or Esc finishes -- on RELEASE, not on press. While the key is still down the box keeps
    -- focus, so PLTyping keeps gating it and every hotkey loop records it as held; a toggle bound to
    -- Enter therefore can't flip on the same press that ends your search. (Esc also opens Roblox's
    -- own menu -- Matcha can't stop that.)
    -- Only the key that ARMED the finish is waited on, so a stuck Esc can't stop Enter from working
    -- (and vice versa); if its release is somehow missed, finish anyway after 1s.
    local en = iskeypressed(0x0D) and true or false
    local esc = iskeypressed(0x1B) and true or false
    if not PLI.ending then
        if en and not PLI.was[0x0D] then PLI.ending, PLI.endAt = 0x0D, now
        elseif esc and not PLI.was[0x1B] then PLI.ending, PLI.endAt = 0x1B, now end
    end
    PLI.was[0x0D], PLI.was[0x1B] = en, esc
    if PLI.ending then
        -- (not `ending==0x0D and en or esc`: with en==false that idiom falls through to esc)
        local held
        if PLI.ending == 0x0D then held = en else held = esc end
        if not held or (now - (PLI.endAt or now)) > 1 then PLI.focus(false) end
    end
end


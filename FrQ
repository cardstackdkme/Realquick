    -- ===== Tab: Character  (ability config pins: Eradicate / Grapple / Velocity) =====
    -- Each pin edits client-side config constants exactly like the proven standalone
    -- requiem_*.lua scripts: getgc(key) -> keep only the real numeric entry (an accept
    -- range filters out the hash-sized decoys) -> applygc(entries, key, value). The
    -- pre-change value is captured the first time a key is touched, so "Reset Default"
    -- restores YOUR original value (not a hard-coded guess). Self-contained: all state
    -- and helpers live inside this tab's scope.
    tabBuild(function()
        local tab = window:Tab("Character", "sword")
        -- Row-locked columns: each Left section opens a ROW at max(both cursors) and the next
        -- Right section starts level with it, so Grapple/Velocity, Dash/Parry and
        -- Firearm Auto/Thunderspears line up exactly. Costs whitespace under the shorter card
        -- of each pair, which is the trade we want here.
        -- OPT-IN per tab on purpose: with two Left sections in a row (ESP, Style, Tools) it would
        -- push the first Right section down to the second Left's row instead of letting it start
        -- at the top. Only tabs that strictly alternate L,R should turn this on.
        -- pcall'd because the upstream fallback library has no RowAlign.
        pcall(function() tab:RowAlign(true) end)

        -- key -> { lo, hi = accept range (excludes hash decoys, spans every slider value), fb = default }
        local CFG = {
            GearAdditionalGrappleRange  = { lo = 0, hi = 20000, fb = 0    },
            GearMaxVelocityMultiplier   = { lo = 0, hi = 100,   fb = 1.11 },
            GearVelocityIncreaseRate    = { lo = 0, hi = 100,   fb = 1.75 },
            -- Dash (Canisters) + Burst Dash (Client Unique enchant) + Blades parry — added 2026-07-03,
            -- all confirmed as the ONLY numeric entry for their key (live getgc). ⚠ GAS_COST hi is
            -- capped BELOW 240 so we only ever hit the CLIENT Burst Dash (100; was 150), never the SERVER
            -- Burst Dash (240 — which isn't in client memory anyway, but belt-and-suspenders).
            DASH_FALLBACK_MIN_SPEED             = { lo = 1, hi = 100000, fb = 150 },
            DASH_BASE_GAS_COST                  = { lo = 0, hi = 100000, fb = 50  },
            GAS_COST                            = { lo = 0, hi = 200,    fb = 100 },
            BURST_FORCE                         = { lo = 1, hi = 100000, fb = 280 },
            -- Burst Dash's extra max-velocity gain (added by the game 2026-10). Read client-side at
            -- activation: signals.addVelocityGain:Fire(cfg.VELOCITY_GAIN_ADDITION). Live getgc: ONE
            -- numeric entry (25); the other two same-name entries are strings, excluded by type.
            VELOCITY_GAIN_ADDITION              = { lo = 0, hi = 1000,   fb = 25  },
            NON_SUCCESSFUL_PARRY_WINDOW_SECONDS = { lo = 0, hi = 60,     fb = 5   },
            -- Gun spread + recoil (v8.0). Since the CharacterFirearmHandler rewrite every shot does
            --   offset = random(+-inaccuracy) * (1 - FirearmAccuracyMultiplier)
            --   kick   = recoilImpulse * FirearmRecoilMultiplier
            -- and both multipliers are plain entries in ClientAttributesHandler's stat table
            -- (name -> value, the same table the Grapple/Velocity pins write). So two writes cover
            -- every gun, from the next shot, gun in hand included. Live 2026-11-01: accuracy 0,
            -- recoil 1. The name->hash cache holds the same names with int16 hashes (e.g. 50934);
            -- these windows plus faEntry's address check keep those out.
            FirearmAccuracyMultiplier           = { lo = -1, hi = 1,     fb = 0   },
            FirearmRecoilMultiplier             = { lo = 0, hi = 5,      fb = 1   },
            -- LEGACY (pre-v8.0 builds wrote these; kept only so Restore can undo such a write in
            -- the same server). BASE_INACCURACY_OFFSET is still the Thunderspear key. For guns both
            -- are now just fallbacks: each gun's own baseInaccuracyOffset / recoilImpulse wins,
            -- which is why writing them stopped affecting guns.
            -- lo is 0, NOT 1: once a value has been zeroed, a lo=1 window makes keep() reject it AND
            -- makes the _G cache revalidator drop the key -> the re-scan finds nothing and Restore
            -- silently no-ops.
            BASE_INACCURACY_OFFSET              = { lo = 0, hi = 20,     fb = 0   },
            BASE_RECOIL_IMPULSE                 = { lo = 0, hi = 20,     fb = 0   },
            -- Thunderspear aim lever. MUST be listed here or entriesFor() bails at its
            -- `if not cfg then return {} end` guard and every write silently no-ops. Exactly two
            -- numeric entries exist in the whole game (both 100, both spears), so the accept
            -- window only has to clear the slider's 1000 ceiling — there are no decoys to exclude.
            INACCURACY_REFERENCE_DISTANCE       = { lo = 0, hi = 5000,   fb = 100 },
            -- Thunderspear fire shake. All five are spear-exclusive (exactly 2 numeric entries
            -- each — one per module instance), so they need no partitioning. lo=0 so an already
            -- zeroed value still passes keep() and the cache revalidator.
            FIRE_SHAKE_AMPLITUDE                = { lo = 0, hi = 50,     fb = 5/2    },
            FIRE_SHAKE_ROTATION_INFLUENCE       = { lo = 0, hi = 10,     fb = 4/100  },
            FIRE_SHAKE_SUSTAIN_TIME             = { lo = 0, hi = 30,     fb = 1/10   },
            FIRE_SHAKE_FADE_OUT_TIME            = { lo = 0, hi = 30,     fb = 35/100 },
            -- ⚠ NEVER write 0 here. Shake.Update does `(t + offset) / Frequency % 10000`, so 0
            -- is a divide by zero -> inf -> inf%10000 = NaN -> math.noise(NaN) = NaN, and NaN*0
            -- is still NaN, so a zeroed Amplitude does NOT save it. The NaN lands in
            -- Camera.CFrame. Listed only so the restore path can REPAIR it back to stock.
            FIRE_SHAKE_FREQUENCY                = { lo = 0, hi = 30,     fb = 12/100 },
            -- Spyglass (Client.User.Equipment.Tools.Exploration.Spyglass). Live getgc 2026-10-21:
            -- exactly TWO numeric entries per key (the config is loaded twice), both 200; every
            -- other entry under these names is a string or a function, excluded by type. lo=0 so
            -- a value already written low still passes keep() and the cache revalidator.
            ZOOMED_CAMERA_MAX_DISTANCE          = { lo = 0, hi = 100000, fb = 200 },
            ZOOMED_CAMERA_MIN_DISTANCE          = { lo = 0, hi = 100000, fb = 200 },
        }
        -- Cross-run cache: getgc addresses stay valid for as long as you STAY in one server (same
        -- game.JobId = same Lua VM), and _G survives a script re-run -- so the scan is stashed in _G
        -- keyed by JobId. Re-running Requiem in the same server reuses it INSTANTLY (no re-scan); only
        -- a REJOIN (new JobId -> fresh Lua heap -> new addresses) forces another scan.
        local JOB = ""
        pcall(function() JOB = tostring(game.JobId or "") end)
        local prevG = _G.RequiemCharVals
        local reuse = type(prevG) == "table" and prevG.job == JOB and type(prevG.cache) == "table"
        local cache        = (reuse and prevG.cache) or {}          -- key -> filtered getgc entries
        local savedDefault = (reuse and prevG.savedDefault) or {}    -- your value BEFORE the first change (Reset Default)
        local warmed = false
        -- getgc reports .addr as a hex STRING on this build and as a number on others. Normalise
        -- before any memory_read, or every read fails and the "fast" cache path silently degrades
        -- into a full re-scan (a multi-second freeze) on every reuse.
        local function gcAddr(e)
            if type(e) ~= "table" then return nil end
            local a = e.addr
            if type(a) == "number" then return a end
            if type(a) == "string" then return tonumber(a) or tonumber((a:gsub("^0[xX]", "")), 16) end
            return nil
        end
        local function gcKey(e)
            local a = gcAddr(e)
            return a and string.format("%.0f", a) or nil   -- %.0f: tostring() on a big number gives sci-notation
        end
        local function gcNum(v) local n = tonumber(v); if n and n == n then return n end return nil end
        -- RETIRED KEYS. The _G cache is keyed by JobId and survives a script re-run, so a key that an
        -- OLDER build scanned stays in it forever even after its slider is deleted. Two consequences,
        -- both real:
        --   1. `warmed` below is set by ANY cached key with entries. A retired key alone would flip it
        --      true, unlocking the Character tab while none of the CURRENT keys have been swept — and
        --      then every entriesFor() falls back to a slow per-key getgc instead of one batch sweep.
        --   2. Anything the old build APPLIED is still live in the game with no control left to undo
        --      it (it only clears on rejoin).
        -- So on reuse: write each retired key back to the value captured before its first change, then
        -- drop it. Setting an existing field to nil mid-pairs() is defined behaviour in Lua.
        local retiredFixed = 0
        if reuse then
            for k, entries in pairs(cache) do
                if not CFG[k] then
                    local orig = savedDefault[k]
                    if orig ~= nil and type(applygc) == "function" then
                        for _, e in ipairs(entries) do
                            pcall(function() applygc({ e }, k, orig) end)
                            retiredFixed = retiredFixed + 1
                        end
                    end
                    cache[k] = nil
                    savedDefault[k] = nil
                end
            end
        end
        -- On reuse, drop any key whose cached address stopped reading a sane number (config rebuilt this
        -- session) so it re-scans lazily; the rest stay instant.
        local droppedAny = false
        if reuse and type(memory_read) == "function" then
            for k, entries in pairs(cache) do
                local cfg, e = CFG[k], entries[1]
                local a = gcAddr(e)
                if cfg and a then
                    local ok, r = pcall(memory_read, "double", a)
                    if not (ok and type(r) == "number" and r == r and r >= cfg.lo and r <= cfg.hi) then
                        cache[k] = {}
                        droppedAny = true
                    end
                end
            end
        end
        -- CFG[k] guard is load-bearing: without it a retired key's leftovers report the tab as loaded.
        for k, entries in pairs(cache) do if CFG[k] and #entries > 0 then warmed = true; break end end
        -- `bb` rides along on the same JobId key: it holds the BlunderBuss's resolved GC slots + the
        -- last value written to each, so a script RE-RUN in the same server reuses them instead of
        -- re-fingerprinting a heap we have already edited (the stock-value test can only pass once).
        local bbState = (reuse and type(prevG.bb) == "table" and prevG.bb) or {}
        -- Resolved slot sets point INTO the cached entries. If any cache was just invalidated the
        -- entries they reference may be stale too, so throw the resolutions away and re-derive.
        if droppedAny then bbState.ts, bbState.ok, bbState.slots = nil, nil, nil end
        _G.RequiemCharVals = { job = JOB, cache = cache, savedDefault = savedDefault, warmed = warmed, bb = bbState }
        local function notif(t, m, d) uiNotify(t, m, d or 3) end
        if retiredFixed > 0 then
            notif("Character", "Reverted " .. retiredFixed .. " value(s) from removed sliders", 4)
        end
        local function keep(cfg, e)   -- is this getgc entry the real numeric config value (not a hash decoy)?
            if type(e) ~= "table" or e.type ~= "number" then return false end
            local v = tonumber(e.value); return v ~= nil and v >= cfg.lo and v <= cfg.hi
        end

        -- ONE getgc sweep for EVERY key, filtered + cached. getgc scans the whole Lua GC (slow),
        -- so sweeping once instead of once-per-key on every apply is what removes the multi-second freeze.
        local function warm()
            local keys = {}
            for k in pairs(CFG) do keys[#keys + 1] = k; if not cache[k] then cache[k] = {} end end
            -- The gas bar rides on this sweep (no second freeze). Its keys are NOT CFG keys, so the
            -- filter below never caches them; the gas bar gets the raw entries instead.
            for _, k in ipairs(GUI.GasSweepKeys or {}) do keys[#keys + 1] = k end
            local ok, entries = pcall(function() return getgc(keys) end)   -- getgc accepts a key LIST
            if not ok or type(entries) ~= "table" then return false end
            if GUI.GasFromSweep then pcall(GUI.GasFromSweep, entries) end
            local found = 0
            for _, e in pairs(entries) do
                local cfg = e and CFG[e.key]
                if cfg and keep(cfg, e) then
                    local c = cache[e.key]; c[#c + 1] = e; found = found + 1
                    if savedDefault[e.key] == nil then savedDefault[e.key] = tonumber(e.value) end
                end
            end
            if found > 0 then warmed = true; if _G.RequiemCharVals then _G.RequiemCharVals.warmed = true end end
            return found > 0
        end

        -- cached entries for a key; lazily sweep just that one key if the cache is still empty
        local function entriesFor(key)
            if cache[key] and #cache[key] > 0 then return cache[key] end
            if not warmed then pcall(warm) end            -- first use this session: ONE sweep for ALL keys
            if cache[key] and #cache[key] > 0 then return cache[key] end
            local cfg = CFG[key]; if not cfg then return {} end
            local ok, entries = pcall(function() return getgc(key) end)
            if not ok or type(entries) ~= "table" then return {} end
            local safe = {}
            for _, e in pairs(entries) do
                if e and e.key == key and keep(cfg, e) then
                    safe[#safe + 1] = e
                    if savedDefault[key] == nil then savedDefault[key] = tonumber(e.value) end
                end
            end
            cache[key] = safe
            if #safe > 0 then warmed = true; if _G.RequiemCharVals then _G.RequiemCharVals.warmed = true end end
            return safe
        end

        -- write `value` to `key` using the cached entries (fast applygc; no GC re-scan)
        local function apply(key, value)
            if type(getgc) ~= "function" or type(applygc) ~= "function" then return false end
            local safe = entriesFor(key)
            if #safe == 0 then return false end
            if savedDefault[key] == nil then savedDefault[key] = tonumber(safe[1].value) end
            return (pcall(function() applygc(safe, key, value) end))
        end

        local function reset(key)
            if savedDefault[key] ~= nil then return apply(key, savedDefault[key]) end
            entriesFor(key)                           -- never changed: this captures your live current as default
            return true
        end

        -- ===== Character-tab LOCK GATE =====================================================
        -- The VISUAL lock -- a dim over ONLY this panel + a centered "Load Values" popup -- is drawn by
        -- the REQUIEM engine (drawCharLock), positioned with _G.RQGeo (the panel rect the patched INS-ui
        -- fork publishes each frame). Here we just expose the load state + trigger to that engine, and
        -- hard-block pin actions until loaded (the scrim is visual only; clicks still reach the lib).
        GUI.CharIsLoaded = function() return warmed end
        -- In-flight flag: a double-click used to start a SECOND ~15s memory scan behind the first.
        local charLoading = false
        GUI.CharIsLoading = function() return charLoading end
        GUI.CharLoad = function()
            if warmed or charLoading then return end
            charLoading = true
            task.spawn(function()
                notif("Values", "Scanning memory... (~15s freeze)", 2)
                pcall(warm)
                charLoading = false
                notif("Values", warmed and "Loaded - pins are instant now" or "Failed - join a round, then retry", warmed and 3 or 4)
            end)
        end
        -- Reload Gas: a respawn rebuilds the gear table, so the gas bar needs one more sweep. Gas keys
        -- ONLY -- the Character values themselves are untouched (their cached slots outlive respawns,
        -- and re-resolving the BlunderBuss after an edit would fail its stock-value test).
        GUI.CharReloadGas = function()
            if charLoading then return end
            if not warmed then return GUI.CharLoad() end   -- nothing loaded yet: the full Load Values
            charLoading = true
            task.spawn(function()
                notif("Gas", "Scanning memory... (~10s freeze)", 2)
                local n = 0
                local ok, entries = pcall(function() return getgc(GUI.GasSweepKeys) end)
                if ok and type(entries) == "table" and GUI.GasFromSweep then
                    local ok2, r = pcall(GUI.GasFromSweep, entries)
                    if ok2 and type(r) == "number" then n = r end
                end
                charLoading = false
                notif("Gas", n > 0 and "Gas bar loaded" or "No gear found - equip it, then retry", n > 0 and 3 or 4)
            end)
        end
        -- Silent. drawCharLock already dims this panel and puts "VALUES LOCKED" + a Load Values
        -- popup over it, so a toast on every blocked click was just noise on top of that.
        local function gateOK()
            return warmed and true or false
        end

        -- Apply/Reset run in a background task so even the first (cache-warming) sweep can't freeze the click.
        local function applyMany(title, keys, vals)
            if not gateOK() then return end
            task.spawn(function()
                local okAll = true
                for i, k in ipairs(keys) do if not apply(k, vals[i]) then okAll = false end end
                if okAll then notif(title, "Applied", 3) else notif(title, "Failed - join a round first", 4) end
            end)
        end
        local function resetMany(title, keys)
            if not gateOK() then return end
            task.spawn(function()
                for _, k in ipairs(keys) do reset(k) end
                notif(title, "Restored your defaults", 3)
            end)
        end

        -- ---------- Grapple (ODM hook range) ----------
        -- Additional Range only. GearGrappleRangeMultiplier is no longer written at all (its slider
        -- was removed), so the projection is a plain 400 + additional.
        local secGr = tab:Section("Grapple", "Left", "ODM hook range")
        local grAdd = CFG.GearAdditionalGrappleRange.fb
        secGr:Slider("Additional Range", grAdd, 50, 0, 5000, "", function(v) grAdd = math.floor(tonumber(v) or grAdd) end)
        secGr:Label(function()
            return string.format("Est. hook range  ~%d studs  (stock 400)", math.floor(grAdd + 400 + 0.5))
        end)
        secGr:Button("Apply Grapple", function()

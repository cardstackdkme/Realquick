        -- ---------- Velocity (ODM speed build-up) ----------
        -- Column layout is paired by row, and the ORDER OF THESE Section() CALLS is what sets it:
        --   Grapple      | Velocity
        --   Dash         | Parry
        --   Firearm Auto | Thunderspears
        --   Gas Bar      |
        -- Move a section by changing its "Left"/"Right" AND its position in this file.
        local secVe = tab:Section("Velocity", "Right", "ODM speed build-up")
        local veMax, veInc = CFG.GearMaxVelocityMultiplier.fb, CFG.GearVelocityIncreaseRate.fb
        secVe:Slider("Max Velocity", veMax, 0.01, 0.5, 5, "x", function(v) veMax = tonumber(v) or veMax end)
        secVe:Slider("Increase Rate", veInc, 0.05, 0.5, 5, "x", function(v) veInc = tonumber(v) or veInc end)
        secVe:Button("Apply Velocity", function()
            applyMany("Velocity", { "GearMaxVelocityMultiplier", "GearVelocityIncreaseRate" }, { veMax, veInc })
        end)

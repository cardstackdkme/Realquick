-- ============================================================
-- TRIGGER BOT  —  shoot the player under your cursor
-- ============================================================
-- The GAME does the aiming (decompiled): a gun's left click casts a ray from the muzzle at
-- Mouse.Hit. So nothing here moves the mouse. It only decides WHEN to click.
--
-- "Is the cursor on a player?" is answered ON SCREEN, because Matcha has no raycast. A body is a
-- capsule along the HumanoidRootPart's up axis (head top to feet), a head is a circle around the
-- Head part, all projected with WorldToScreen into the same space as Mouse.X/Y. A wall in between
-- cannot be seen this way; the game's own ray decides, and then the shot hits the wall.
--
-- WHEN TO PRESS (v7.9). The game reads the cursor a frame or so AFTER the click, so a click made
-- while the mouse sweeps OFF someone lands beside them. A click therefore needs the cursor on the
-- target now AND where it will be when the game reads it (cursor velocity minus the target's, on
-- screen, times the lead). That one test rejects sweeps. The lead grows with the tick time, so a
-- slow frame rate looks further ahead instead of firing late. Far players are never narrower than
-- AIM.MinPx.
--
-- TRIGGER BOT. Fires at the player under the cursor while a gun is in your hands and the server
--   says you are aiming (the character's "Aiming" attribute). Per-gun rules in TB_GUNS, read live
--   from the game's CharacterFirearmHandler (2026-11-01):
--   * single-shot guns that must be readied (Flintlock family): the game IGNORES a click for 0.3s
--     after you aim (READY_STATE_TRANSITION_TIME), so it waits that out, then fires ONCE. A second
--     click on the empty gun would start a reload. It fires again after a reload or a fresh aim.
--   * magazines: clicks every `gap`. A click while the bolt is cycling is ignored by the game.
--   * MP41 is automatic: the button is HELD while the cursor stays on them, released when it leaves.
--   Never during a reload, never while you hold the button yourself. Options: actors only (the
--   Player's "Actor" attribute), headshots only.
-- It is real input, so it never acts while Roblox is in the background (it would go to whatever
-- has focus), the menu is open, or the Player List search is focused.
local TB = {
    Enabled = false,
    ActorsOnly = false,    -- only players whose Player has Actor = true
    HeadOnly = false,      -- only when the cursor is on the head
    -- runtime
    Status = "off", Shots = 0, LastAt = -10, Fired = 0, Gun = nil,
    Holding = false, Target = nil, OnAt = 0, RelAt = -10,
}
local AIM = {
    BodyR = 1.15,          -- studs: the body counts as under the cursor this close to its line
    CoreR = 0.85,          -- studs: a shot needs it this close
    HeadR = 0.6,           -- studs: head radius
    MinPx = 4,             -- pixels: no target is narrower than this (far players)
    Lead = 0.03,           -- seconds from deciding to the game reading the cursor, at least...
    LeadTicks = 1.5,       -- ...or this many of our ticks when frames are slow
    Dwell = 0,             -- seconds the gate must already have held (0 = fire on the first tick)
    MaxDist = 3000,        -- studs; range itself is the Character tab's job
}
GUI.TB = TB
pcall(function() rawset(_G, "RQTB", TB) end)

-- Guns, by the name of the model under your character while it is in your hands (the holstered
-- copy is "attachment_<name>"). rounds = magazine; settle = seconds after "Aiming" turns on before
-- the first shot; gap = seconds between clicks; auto = hold the button. Values from the live
-- CharacterFirearmHandler configs: makeReady guns hold 1 round, M1911 8 (fireDelay 0.25),
-- MP41 32 (automatic, 0.1), Kar98k 5, TrenchShotgun 6, Dual Flintlocks 2 (0.5), AntiTitanRifle 1
-- (requireAimIdle: waits for the aim animation to finish).
local TB_GUNS = {
    Flintlock = { rounds = 1, settle = 0.32 },
    Musket = { rounds = 1, settle = 0.32 },
    BlunderBuss = { rounds = 1, settle = 0.32 },
    ["Long Rifle"] = { rounds = 1, settle = 0.32 },
    Carbine = { rounds = 1, settle = 0.32 },
    AntiTitanRifle = { rounds = 1, settle = 0.6 },
    ["Dual Flintlocks"] = { rounds = 2, settle = 0.32, gap = 0.55 },
    Kar98k = { rounds = 5, settle = 0.05, gap = 0.15 },
    ScopedKar98k = { rounds = 5, settle = 0.05, gap = 0.15 },
    TrenchShotgun = { rounds = 6, settle = 0.05, gap = 0.15 },
    M1911 = { rounds = 8, settle = 0.05, gap = 0.27 },
    MP41 = { rounds = 32, settle = 0.05, auto = true },
}
-- A gun this list does not know yet (a model with a muzzle): the careful rules.
local TB_UNKNOWN = { rounds = 1, settle = 0.32 }
local TB_NOTGUN = { GearBoxes = true, LeftGearHandle = true, RightGearHandle = true, Humanoid = true }

local function tbRelease(now)
    if TB.Holding then pcall(mouse1release) end
    TB.Holding, TB.Target = false, nil
    if now then TB.RelAt = now end
end

-- Is the menu on screen? The fork rebuilds _G.RQGeo every frame it renders, so a table that
-- stopped changing is a minimised menu (same test the E loop uses).
local agGeoRef, agGeoAt = nil, 0
local function agMenuOpen(now)

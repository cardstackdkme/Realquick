                if it.label == "Background" then v.bg = it.value
                elseif it.label == "Text color" then v.text = it.value
                elseif it.label == "Border" then v.border = tonumber(it.value)
                elseif it.label == "Corner radius" then v.radius = (tonumber(it.value) or 100) / 100 end
            end
            return v
        end
        local secPan = setTab:Section("Panels", "Left")
        local follow = secPan:Toggle("Apply to Panels", GUI.PanelsFollowMenu ~= false, function(v) GUI.PanelsFollowMenu = v == true end)
        pcall(function() follow:Tooltip("the Player List, Enchants and RS Diff panels use this Appearance's background, text colour, border and corner radius. Off = their own dark look") end)
        local accPick = nil
        pcall(function()
            accPick = secPan:Colorpicker("Accent", RUITHEME.accent or Color3.fromRGB(220, 75, 75), function(c)
                GUI.SetAccent(c)
                GUI.AccentRGB = { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
                -- the picker fires while you drag it: save once it has been still for a second
                GUI._accSaveAt = os.clock()
                task.spawn(function()
                    task.wait(1)
                    if os.clock() - (GUI._accSaveAt or 0) >= 0.95 then pcall(saveConfig) end
                end)
            end)
            accPick:Tooltip("the menu's and the panels' accent colour. Saved with your config")
        end)
        -- The lib auto-loads its own config a moment after the window is ready, in the background,
        -- and that file carries an accent of its own. Put Requiem's saved accent back on top of it
        -- over the first seconds (the newest pick, so a change made meanwhile is kept).
        task.spawn(function()
            for _, d in ipairs({ 0.5, 1.5, 3, 6 }) do
                task.wait(d)
                local sa = GUI.AccentRGB
                if not GUI.Running then return end
                if type(sa) == "table" and tonumber(sa[1]) then GUI.SetAccent(Color3.fromRGB(sa[1], sa[2], sa[3])) end
            end
        end)
        -- Both belong inside Appearance: move them to its top and drop the helper section.
        pcall(function()
            if look and follow.item then
                table.insert(look.items, 1, follow.item)
                if accPick and accPick.item then table.insert(look.items, 2, accPick.item) end
                local secs = setTab._tab.sections
                for i = #secs, 1, -1 do if secs[i] == secPan._section then table.remove(secs, i) end end
            end
        end)

        local secLay = setTab:Section("Layout", "Left", "Where the menu and panels open")
        secLay:Toggle("Snap While Dragging", GUI.SnapOn ~= false, function(v) GUI.SnapOn = v == true end)
            :Tooltip("a dragged bar or panel locks its edges and centre onto other panels, the menu, the screen centre, and the mirror of another panel across the centre (so left and right bars line up). A blue line shows what it locked onto. Hold Shift to place it freely")
        secLay:Button("Save GUI Positions", function()
            local ok, err = GUI.SaveLayout()
            if ok then
                uiNotify("Layout", "Saved - the menu and panels open here next time", 4)
            else
                uiNotify("Layout", "Could not save: " .. tostring(err), 5, "warning")
            end
        end)
        secLay:Button("Clear Saved Positions", function()
            local ok, err = GUI.ClearLayout()
            if ok then
                uiNotify("Layout", "Cleared - next load uses the default spots", 4)
            else
                uiNotify("Layout", "Could not clear: " .. tostring(err), 5, "warning")
            end
        end)

        -- Unload key. InputLoop just polls iskeypressed(GUI.CloseKey), so rebinding is only a
        -- matter of moving that number; End is the default, not a hardcoded rule. Persisted as
        -- binds.close, which means it survives only if you hit Save Config.
        -- pcall'd like the other :Keybind uses: the method exists in the fork but not necessarily
        -- in the upstream fallback lib, and an error here would drop the whole Settings tab.
        local secKeys = setTab:Section("Keybinds", "Right", "Click, then press a key")
        pcall(function()
            GUI._kbUnload = secKeys:Keybind("Unload Script", GUI.VKToName(GUI.CloseKey), function(k)
                local vk = GUI.VKFromName(k)
                if not vk then
                    -- Mouse buttons and anything else with no virtual-key mapping (m1/m2/mb3-5 are
                    -- capturable by the fork but have no iskeypressed VK here). Leaving CloseKey
                    -- alone is the safe failure -- an unbindable unload key would strand the script
                    -- -- but the fork has ALREADY written the new name into the control, so simply
                    -- returning would leave the pill advertising a key that does nothing while the
                    -- real unload key still fires unannounced. Put the displayed value back.
                    -- Set() re-enters this callback once with the old, valid name; that maps
                    -- cleanly and stops there, so there is no recursion.
                    uiNotify("Keybinds", "that key cannot be used - unload key unchanged", 3, "warning")
                    pcall(function() GUI._kbUnload:Set(GUI.VKToName(GUI.CloseKey)) end)

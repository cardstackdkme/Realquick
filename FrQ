local last = os.clock()
task.spawn(function()
    while GUI.Running do
        local nowc=os.clock(); R.dt=minf(nowc-last,0.1); last=nowc
        R.mx,R.my=Mouse.X,Mouse.Y
        local down=false; pcall(function() down=ismouse1pressed() end)
        R.justP = down and not R.down

        -- carry the menu's live accent + transparency each frame (set by the theme driver via the shared GUI table)
        pcall(R.syncLook, os.clock())
        local th=GUI._theme
        if th then if th.accent then T.red=th.accent end; R.opacity=tonumber(th.opacity) or 1 end

        if R.resizeKey and down then
            local kx=R.resizeKey=="pl" and "PlayerListX" or R.resizeKey=="en" and "EnchantsX" or "RSDiffX"
            local ky=R.resizeKey=="pl" and "PlayerListY" or R.resizeKey=="en" and "EnchantsY" or "RSDiffY"
            local kw=R.resizeKey=="pl" and "PlayerListW" or R.resizeKey=="en" and "EnchantsW" or "RSDiffW"
            local kh=R.resizeKey=="pl" and "PlayerListH" or R.resizeKey=="en" and "EnchantsH" or "RSDiffH"
            GUI[kw]=maxf(560,(R.mx-GUI[kx])+R.resizeOX); GUI[kh]=maxf(400,(R.my-GUI[ky])+R.resizeOY)
        elseif not down then R.resizeKey=nil end

        if R.dragKey and down then
            local kx = R.dragKey=="pl" and "PlayerListX" or R.dragKey=="en" and "EnchantsX" or "RSDiffX"
            local ky = R.dragKey=="pl" and "PlayerListY" or R.dragKey=="en" and "EnchantsY" or "RSDiffY"
            local sw = R.dragKey=="pl" and GUI.PlayerListW or R.dragKey=="en" and GUI.EnchantsW or GUI.RSDiffW
            local sh = R.dragKey=="pl" and GUI.PlayerListH or R.dragKey=="en" and GUI.EnchantsH or GUI.RSDiffH
            GUI[kx], GUI[ky] = GUI.Snap(R.dragKey, R.mx-R.dragOX, R.my-R.dragOY, sw, sh)
        elseif not down then
            if R.dragKey then GUI.SnapGuides(nil, nil) end
            R.dragKey=nil
        end
        if R.scrollOff and down then
            local dy=R.my-R.scrollLastY
            GUI[R.scrollOff]=maxf(0,minf(R.scrollMax,(GUI[R.scrollOff] or 0)+dy*(R.scrollMax/maxf(1,R.scrollTrackH))))
            R.scrollLastY=R.my
        elseif not down then R.scrollOff=nil end

        -- persist window position + size when a drag/resize finishes (remembers where you left it)
        local manip = R.dragKey or R.resizeKey
        if R._wasManip and not manip then pcall(function() if saveConfig then saveConfig() end end) end
        R._wasManip = manip

        -- typing first, so this frame already draws what you just typed
        pcall(PLI.poll, nowc)
        beginFrame(); clicks={}; drags={}; scrolls={}; resizes={}
        -- drawBadge FIRST and in its own pcall: the rest share one, so a player row or enchant
        -- card that throws would otherwise blink the version out for that whole frame.
        -- Menu heartbeat, taken BEFORE drawing: RQGeo is a fresh table every frame the menu renders, so
        -- an unchanged one (minimised to the bubble) is stale after 0.25s. drawCharLock needs this to
        -- tell a live menu from a frozen one, and the click guard below reuses it.
        local g=_G.RQGeo
        if g~=R.geoRef then R.geoRef=g; R.geoAt=nowc end
        local geoLive=type(g)=="table" and g.open==true and (nowc-(R.geoAt or 0))<=0.25
        R.geoLive=geoLive
        pcall(drawBadge)
        local ok,err=pcall(function() drawPlayers(); drawEnchants(); drawRS() end)
        -- Its OWN pcall, still drawn last (on top): if a panel throws, the lock popup must not vanish
        -- and _G.RQBlockInput must not freeze at whatever it was last frame.
        local okL,errL=pcall(drawCharLock)
        if not okL then _G.RQBlockInput=nil; warn("[Requiem UI] "..tostring(errL)) end
        endFrame()
        if not ok then warn("[Requiem UI] "..tostring(err)) end

        -- The INS-ui menu is drawn ABOVE these panels, so a click on it belongs to it -- never to a
        -- panel control hidden underneath. Without this a menu click could focus the covered search
        -- box (freezing you) or hit RS Diff's Overwrite/Clear. The fork publishes its window rect in
        -- RQGeo (wx/wy/ww/wh) plus `pop` while a dropdown / colour picker / key menu / dialog /
        -- spotlight is open (those can hang outside the window). RQGeo is a fresh table every frame
        -- the menu renders, so an unchanged one (minimised to the bubble) is stale after 0.25s.
        -- Older/upstream libs publish neither field: no guard, exactly the old behaviour.
        -- (g / geoLive: the heartbeat taken before drawing, above)
        -- The minimised menu is a 42px bubble the fork publishes as _G.RQBubble -- a fresh table every
        -- frame it is drawn, so the same identity trick tells a live bubble from a faded one.
        local bub=_G.RQBubble
        if bub~=R.bubRef then R.bubRef=bub; R.bubAt=nowc end
        local onBubble=type(bub)=="table" and (nowc-(R.bubAt or 0))<=0.25
            and type(bub.x)=="number" and type(bub.y)=="number" and type(bub.s)=="number"
            and R.mx>=bub.x-2 and R.mx<=bub.x+bub.s+2 and R.my>=bub.y-2 and R.my<=bub.y+bub.s+2
        local overMenu=onBubble or geoLive and (g.pop==true
            or (type(g.wx)=="number" and type(g.wy)=="number" and type(g.ww)=="number" and type(g.wh)=="number"
                and R.mx>=g.wx-2 and R.mx<=g.wx+g.ww+2 and R.my>=g.wy-2 and R.my<=g.wy+g.wh+2))
        -- Clicking anywhere but the search box ends typing, like any text field -- including a click
        -- on the menu where it happens to cover the box. Checked BEFORE the click is dispatched so
        -- the click itself still lands (a sort button, a row, the menu, the game).
        if R.justP and GUI.PLSearchFocused then
            local b=PLI.box

        local secDash = tab:Section("Dash", "Left", "Canisters + Burst Dash")
        secDash:Label(function() return "Speed 220 | Gas 0/0 | Force 350" end)
        secDash:Label(function() return "Burst velo gain 25 -> 75" end)
        secDash:Button("Apply Dash", function()
            applyMany("Dash",
                { "DASH_FALLBACK_MIN_SPEED", "DASH_BASE_GAS_COST", "GAS_COST", "BURST_FORCE", "VELOCITY_GAIN_ADDITION" },
                { 220, 0, 0, 350, 75 })
        end)
        -- Spyglass: its OWN button, sitting here only for placement. Apply Dash and Restore Default
        -- never touch it, so anyone who does not want it simply never presses it. Fixed values, no
        -- slider, as asked: both zoomed-camera distances to 200. Takes effect the next time you
        -- zoom in. Rejoining puts the game's own values back.
        secDash:Button("Apply Spyglass", function()
            applyMany("Spyglass", { "ZOOMED_CAMERA_MAX_DISTANCE", "ZOOMED_CAMERA_MIN_DISTANCE" }, { 200, 200 })
        end)
        secDash:Button("Restore Default", function()
            resetMany("Dash", { "DASH_FALLBACK_MIN_SPEED", "DASH_BASE_GAS_COST", "GAS_COST", "BURST_FORCE", "VELOCITY_GAIN_ADDITION" })
        end)

        -- ---------- Blades (non-successful parry window) — slider ----------
        local secParry = tab:Section("Parry", "Right", "Parry window (default 5s)")
        local parryVal = CFG.NON_SUCCESSFUL_PARRY_WINDOW_SECONDS.fb
        secParry:Slider("Parry Window", parryVal, 0.1, 0, 5, "s", function(v) parryVal = tonumber(v) or parryVal end)
        secParry:Button("Apply Parry", function()
            applyMany("Parry", { "NON_SUCCESSFUL_PARRY_WINDOW_SECONDS" }, { parryVal })
        end)
        secParry:Button("Restore Default", function()
            resetMany("Parry", { "NON_SUCCESSFUL_PARRY_WINDOW_SECONDS" })
        end)

        -- ---------- Firearms (EVERY gun): spread + recoil ----------
        -- v8.0: written through your two firearm STATS, not the gun configs (see the CFG note on
        -- FirearmAccuracyMultiplier). The old way wrote BASE_INACCURACY_OFFSET / BASE_RECOIL_IMPULSE,
        -- which the new handler only uses for a gun that has no value of its own. Every gun now
        -- has its own baseInaccuracyOffset / recoilImpulse, so those writes changed nothing.
        -- Per-gun values were the other option and were rejected: they live in each gun module's
        -- table TEMPLATE (copied on every equip, so a write only lands on the next draw), getgc
        -- misses some of their fields, and it also returns look-alike entries from the modules'
        -- constant lists where each name sits on the PREVIOUS field's value. Writing one of those
        -- rewrites gun code, e.g. M1911 fireDelay. The stat route has none of that.
        local secFire = tab:Section("Firearm Auto", "Left", "One press: no spread / no recoil")
        secFire:Label(function() return "Spread 0 | Recoil 0   (every gun, next shot)" end)
        -- LEGACY: what pre-v8.0 builds wrote, so Restore can still undo it in the same server.
        local FIRE_KEYS = { "BASE_INACCURACY_OFFSET", "BASE_RECOIL_IMPULSE" }
        local fireOrig = bbState.fireOrig or {}
        bbState.fireOrig = fireOrig
        -- Thunderspears share BASE_INACCURACY_OFFSET with the gun handler's fallback, so the
        -- spear panel must find its own entries by ADDRESS.
        --
        -- Identify them by ANCHOR, not by value. The obvious test — "the entry whose value is 15"
        -- — is self-erasing: the moment the spear panel writes 3, it can never be found again.
        -- INACCURACY_REFERENCE_DISTANCE is spear-exclusive (exactly 2 numeric entries in the whole
        -- game) and NEITHER panel's identity depends on what we wrote, so it survives our own
        -- edits. Its slot sits +64 bytes from the spear's inaccuracy slot; the nearest FOREIGN
        -- inaccuracy slot is ~3.1 MB away, so a 2048-byte moat has ~1500x headroom.
        -- The module is instantiated twice (two anchors, ~742 MB apart) and BOTH must be written,
        -- or one config stays stale — so resolve per anchor rather than aborting on "2 matches".
        local TS_WINDOW = 2048
        local function tsResolve()
            if bbState.ts then return bbState.ts end
            local cands   = entriesFor("BASE_INACCURACY_OFFSET")
            local anchors = entriesFor("INACCURACY_REFERENCE_DISTANCE")
            if #anchors == 0 then return nil, "spear config not loaded - equip thunderspears once" end
            local out, n = {}, 0
            for _, an in ipairs(anchors) do
                local aa = gcAddr(an)
                local hit, hits = nil, 0
                if aa then
                    for _, c in ipairs(cands) do
                        local ca = gcAddr(c)
                        if ca and math.abs(ca - aa) <= TS_WINDOW then hit = c; hits = hits + 1 end
                    end
                end
                -- exactly one, or we cannot tell spears from a co-located gun: refuse
                if hits ~= 1 then return nil, "spear layout unexpected (" .. hits .. " near anchor)" end
                out[gcKey(hit)] = true
                n = n + 1
            end
            if n ~= #anchors then return nil, "resolved " .. n .. "/" .. #anchors end
            bbState.ts = out          -- cache only a COMPLETE resolve
            return out
        end
        -- applygc on a ONE-entry list writes exactly that address, which is how we hit a subset.
        -- Verified per entry: range-check the address still reads sanely, write, then read back.
        -- Without the read-back, pcall returning true proves nothing — applygc can no-op.
        local function writeEntries(key, list, value)
            local cfg, done = CFG[key], 0
            for _, e in ipairs(list) do
                local a = gcAddr(e)
                if a and type(memory_read) == "function" then
                    local okR, cur = pcall(memory_read, "double", a)
                    cur = okR and gcNum(cur) or nil
                    if cur and cfg and cur >= cfg.lo and cur <= cfg.hi then
                        pcall(function() applygc({ e }, key, value) end)
                        local okB, back = pcall(memory_read, "double", a)
                        back = okB and gcNum(back) or nil
                        if back and math.abs(back - value) < 0.0001 then done = done + 1 end
                    end
                end
            end
            return done == #list, done
        end
        -- LEGACY undo: puts back anything a pre-v8.0 build wrote to the two fallback keys, per
        -- address (1-entry applygc = that one address only).
        local function fireRestore()
            local n = 0
            for _, key in ipairs(FIRE_KEYS) do
                local orig = fireOrig[key]
                if orig then
                    for _, e in ipairs(entriesFor(key)) do
                        local o = orig[gcKey(e)]
                        if o ~= nil then
                            pcall(function() applygc({ e }, key, o) end)
                            n = n + 1
                        end
                    end
                    fireOrig[key] = nil
                end
            end
            return n
        end

        -- ---- the two firearm stats ----
        -- `fa` rides on the per-JobId _G table, so a script re-run in the same server still knows
        -- your own values and can Restore them.
        --   nat[key]    = your own value (talents, buffs), re-read whenever the GAME changes it
        --   last[key]   = what we last wrote; a live value that differs means the game moved it
        --   keyptr[key] = the key-string pointer stored right after the value, checked every write
        --   pct         = { spread, recoil } share KEPT while an override is on; nil when off
        local FA_ACC, FA_REC = "FirearmAccuracyMultiplier", "FirearmRecoilMultiplier"
        local FA_EPS = 1/10000
        -- Live: the stat slots sit 1.5-11 KB from GearMaxVelocityMultiplier (same table); the
        -- name->hash cache with the same names sits ~118 KB away.
        local ATTR_WINDOW = 32768
        local fa = bbState.fa or {}
        bbState.fa = fa
        fa.nat, fa.last, fa.keyptr = fa.nat or {}, fa.last or {}, fa.keyptr or {}
        fa.gen = fa.gen or 0

        -- The ONE stat slot for `key`: inside the stat table, i.e. near the GearMaxVelocityMultiplier
        -- entry the Velocity pin already writes. Anything but exactly one candidate refuses -- the
        -- wrong slot would be some other table's number.
        local function faEntry(key)
            local anchor = entriesFor("GearMaxVelocityMultiplier")[1]
            local aa = anchor and gcAddr(anchor)
            local hits = {}
            for _, e in ipairs(entriesFor(key)) do
                local a = gcAddr(e)
                if a and (aa == nil or math.abs(a - aa) <= ATTR_WINDOW) then hits[#hits + 1] = e end
            end
            if #hits ~= 1 then
                return nil, string.format("%s: %d candidates - rejoin and Load Values again", key, #hits)
            end
            return hits[1]
        end
        -- A table slot is [value 16 bytes][key 16 bytes]. If the key pointer after our value ever
        -- changes, the table was rebuilt and the address is stale: refuse instead of writing into
        -- memory that belongs to something else now.
        local function faKeyOK(key, e)
            local a = gcAddr(e)
            if not a or type(memory_read) ~= "function" then return false end
            local ok, p = pcall(memory_read, "uint64", a + 16)
            if not ok or type(p) ~= "number" or p == 0 then return false end
            if fa.keyptr[key] == nil then fa.keyptr[key] = p end
            return p == fa.keyptr[key]
        end
        local function faRead(e)
            local ok, v = pcall(memory_read, "double", gcAddr(e))
            return ok and gcNum(v) or nil
        end

        -- What to write, from your own value and the share of spread/recoil to KEEP (pct 0 = none,
        -- 1 = unchanged). The game multiplies spread by (1 - accuracy), so accuracy 1 = dead
        -- centre; recoil is a plain multiplier, so 0 = no kick. Relative to your own value, so a
        -- talent you already have is never undone and 100% is exactly stock.
        local function faTarget(key, natural, pct)
            if key == FA_ACC then return 1 - pct * (1 - natural) end
            return natural * pct
        end

        local function faWrite(key, pct)
            local e, why = faEntry(key)
            if not e then return false, why end
            if not faKeyOK(key, e) then return false, key .. " slot moved - rejoin" end
            local cur = faRead(e)
            if cur == nil then return false, key .. " unreadable" end
            -- A live value that isn't our last write is the game's (first use, or a buff/talent
            -- changed it since): that becomes the value we scale from.
            if fa.last[key] == nil or math.abs(cur - fa.last[key]) > FA_EPS then fa.nat[key] = cur end
            local v = faTarget(key, fa.nat[key], pct)
            if math.abs(cur - v) > FA_EPS and not writeEntries(key, { e }, v) then
                return false, key .. " write did not land"
            end
            fa.last[key] = v
            return true
        end

        -- Keeper. The game rewrites a stat only when the SERVER sends a new value for it (a buff,
        -- a talent). Once a second, re-apply on top of whatever it sent: two memory reads a tick,
        -- never a scan.
        local function faKeep()
            fa.gen = fa.gen + 1
            local my = fa.gen
            task.spawn(function()
                while fa.gen == my and fa.pct and GUI.Running do
                    task.wait(1)
                    if fa.gen ~= my or not fa.pct or not GUI.Running then break end
                    for _, key in ipairs({ FA_ACC, FA_REC }) do
                        local ok, why = faWrite(key, key == FA_ACC and fa.pct.spread or fa.pct.recoil)
                        if not ok then
                            fa.pct = nil
                            notif("Firearms", "Stopped - " .. tostring(why), 5)
                            break
                        end
                    end
                end
            end)
        end

        local function faApply(spread, recoil)
            local ok1, w1 = faWrite(FA_ACC, spread)
            local ok2, w2 = faWrite(FA_REC, recoil)
            if not (ok1 and ok2) then return false, w1 or w2 end
            fa.pct = { spread = spread, recoil = recoil }
            faKeep()
            return true
        end

        -- Undo only our own write: if the game changed the stat since, it is already yours.
        local function faRestore()
            fa.pct = nil
            fa.gen = fa.gen + 1          -- ends the keeper
            local n = 0
            for _, key in ipairs({ FA_ACC, FA_REC }) do
                local e = faEntry(key)
                local cur = e and faKeyOK(key, e) and faRead(e)
                if cur and fa.last[key] and fa.nat[key] and math.abs(cur - fa.last[key]) <= FA_EPS then
                    if math.abs(cur - fa.nat[key]) <= FA_EPS or writeEntries(key, { e }, fa.nat[key]) then
                        n = n + 1
                    end
                end
                fa.last[key] = nil
            end
            return n
        end
        -- A re-run in the same server picks the keeper back up. Only when the values are already
        -- loaded: otherwise its first lookup would start the big scan without being asked.
        if fa.pct and warmed then faKeep() end

        secFire:Button("Apply Firearms", function()
            if not gateOK() then return end
            task.spawn(function()
                local ok, why = faApply(0, 0)
                notif("Firearms", ok and "Every gun: no spread, no recoil (from your next shot)"
                    or ("Failed - " .. tostring(why)), ok and 4 or 5)
            end)
        end):Tooltip("Sets your firearm accuracy stat to full and your recoil stat to zero, so every gun fires dead centre with no camera kick from your next shot - no re-equip needed. Pellet guns keep a small cone (the BlunderBuss keeps half). Restore Default puts your own values back.")
        secFire:Button("Restore Default", function()
            if not gateOK() then return end
            task.spawn(function()
                local n = faRestore() + fireRestore()
                notif("Firearms", n > 0 and ("Restored " .. n .. " value(s)") or "Nothing to restore - no writes recorded", 3)
            end)
        end)

        -- ---------- Thunderspears ----------
        -- The spear's whole accuracy model is two numbers. It picks an aim point
        -- REFERENCE_DISTANCE studs straight ahead, jitters that point by up to +/-INACCURACY on
        -- each axis, and fires at it — so the cone half-angle is atan(inaccuracy / distance).
        -- That gives two ways to tighten it, and they are NOT equivalent:
        --   Spear Inaccuracy  -> shrinks the jitter. Shared key, but we write ONLY the spear
        --                        addresses (see tsResolve), so guns are untouched.
        --   Aim Distance      -> lengthens the lever arm, which divides the cone down without
        --                        touching the jitter. INACCURACY_REFERENCE_DISTANCE has exactly
        --                        two numeric entries in the whole game and both are spears, so
        --                        this one is inherently safe. 1000 = a tenth of the stock cone.
        local tsInacc, tsDist = 15, 100
        -- addr -> pre-write value. In the per-JobId _G table for the same reason as fireOrig:
        -- as a plain local, a script re-run kept the writes but lost the way back.
        local tsOrig = bbState.tsOrig or {}
        bbState.tsOrig = tsOrig
        local secTS = tab:Section("Thunderspears", "Right", "Spear accuracy")
        secTS:Slider("Spear Inaccuracy", tsInacc, 0.1, 0, 15, "",
            function(v) tsInacc = tonumber(v) or tsInacc end,
            "Random scatter applied to the aim point, in studs. Stock 15 - by far the loosest weapon in the game. 0 = perfectly straight.")
        secTS:Slider("Aim Distance", tsDist, 25, 100, 1000, "",
            function(v) tsDist = tonumber(v) or tsDist end,
            "How far ahead the aim point sits. Bigger = tighter cone, because the spread angle is inaccuracy divided by this. Stock 100; 1000 makes the same jitter ten times tighter.")
        -- Camera shake on throw. Zeroing Amplitude alone already flattens the output vector
        -- (offset = noise * Amplitude), but we also stop the shake outright: FadeOutTime 0 is
        -- explicitly handled by Shake.Update as "finish now", and SustainTime 0 removes the hold.
        -- FIRE_SHAKE_FREQUENCY is deliberately NOT in this list — see the CFG comment; it is a
        -- divisor, and 0 there NaNs your camera instead of removing the shake.
        local TS_SHAKE = { "FIRE_SHAKE_AMPLITUDE", "FIRE_SHAKE_ROTATION_INFLUENCE",
                           "FIRE_SHAKE_SUSTAIN_TIME", "FIRE_SHAKE_FADE_OUT_TIME" }
        secTS:Button("No Camera Shake", function()
            if not gateOK() then return end
            task.spawn(function()
                local okAll, n = true, 0
                for _, key in ipairs(TS_SHAKE) do
                    local list = entriesFor(key)
                    if #list == 0 then
                        okAll = false
                    else
                        for _, e in ipairs(list) do
                            local a = gcKey(e)
                            if a and tsOrig[a] == nil then tsOrig[a] = gcNum(e.value) end
                        end
                        if writeEntries(key, list, 0) then n = n + #list else okAll = false end
                    end
                end
                -- Repair a Frequency that has already been zeroed (by an earlier build, or by
                -- hand in a constant editor). Left at 0 it breaks the camera on the next throw.
                local fixed = 0
                for _, e in ipairs(entriesFor("FIRE_SHAKE_FREQUENCY")) do
                    if (gcNum(e.value) or 0) == 0 then
                        pcall(function() applygc({ e }, "FIRE_SHAKE_FREQUENCY", 12/100) end)
                        fixed = fixed + 1
                    end
                end
                notif("Thunderspears",
                    (okAll and ("Camera shake off (" .. n .. " values)")
                            or "Shake partly failed - throw a spear once, then retry")
                    .. (fixed > 0 and ("  |  repaired Frequency x" .. fixed) or ""), 4)
            end)
        end):Tooltip("Removes the camera kick when you throw. It is purely visual - the spear's direction comes from your body, so the shake never affected where it goes.")
        secTS:Button("Apply Thunderspears", function()
            if not gateOK() then return end
            task.spawn(function()
                local ts, why = tsResolve()
                if not ts then
                    notif("Thunderspears", "Failed - " .. tostring(why), 5)
                    return
                end
                -- spear-only subset of the shared inaccuracy key
                local list = {}
                for _, e in ipairs(entriesFor("BASE_INACCURACY_OFFSET")) do
                    local a = gcKey(e)
                    if a and ts[a] then
                        list[#list + 1] = e
                        if tsOrig[a] == nil then tsOrig[a] = gcNum(e.value) end
                    end
                end
                local okI, doneI = false, 0
                if #list > 0 then okI, doneI = writeEntries("BASE_INACCURACY_OFFSET", list, tsInacc) end
                -- the aim distance key is spear-exclusive, so every entry is ours
                local dist = entriesFor("INACCURACY_REFERENCE_DISTANCE")
                for _, e in ipairs(dist) do
                    local a = gcKey(e)
                    if a and tsOrig[a] == nil then tsOrig[a] = gcNum(e.value) end
                end
                local okD, doneD = writeEntries("INACCURACY_REFERENCE_DISTANCE", dist, tsDist)
                if okI and okD then
                    notif("Thunderspears", string.format("Spread %.1f | aim distance %d   cone ~%.1f deg (stock 8.5)",
                        tsInacc, tsDist, math.deg(math.atan(tsInacc / tsDist))), 4)
                else
                    notif("Thunderspears", string.format("Partial - spread %d/%d, distance %d/%d",
                        doneI, #list, doneD, #dist), 5)
                end
            end)
        end)
        secTS:Button("Restore Default", function()
            if not gateOK() then return end
            tsInacc, tsDist = 15, 100
            task.spawn(function()
                local n = 0
                for _, key in ipairs({ "BASE_INACCURACY_OFFSET", "INACCURACY_REFERENCE_DISTANCE",
                                       "FIRE_SHAKE_AMPLITUDE", "FIRE_SHAKE_ROTATION_INFLUENCE",
                                       "FIRE_SHAKE_SUSTAIN_TIME", "FIRE_SHAKE_FADE_OUT_TIME",
                                       "FIRE_SHAKE_FREQUENCY" }) do
                    -- BASE_INACCURACY_OFFSET is SHARED with every gun, so only addresses we
                    -- actually recorded may be touched. Every other key here is spear-exclusive,
                    -- so we can fall back to the known stock value — which is what lets this
                    -- repair constants zeroed outside the menu, Frequency above all.
                    local shared = (key == "BASE_INACCURACY_OFFSET")
                    for _, e in ipairs(entriesFor(key)) do
                        local o = tsOrig[gcKey(e)]
                        if o == nil and not shared then o = CFG[key] and CFG[key].fb end
                        if o ~= nil then
                            pcall(function() applygc({ e }, key, o) end)
                            n = n + 1
                        end
                    end
                end
                notif("Thunderspears", n > 0 and ("Restored " .. n .. " spear values (incl. camera shake)")
                    or "Nothing to restore - no writes recorded", 3)
            end)
        end)

        -- Directly UNDER Firearm Auto (the user's spot). RowAlign would start this left section a
        -- new row below the taller Thunderspears; `stack` (uilib patch #12) makes
        -- it continue the left column instead. On the upstream fallback lib it just sits lower.
        -- Load Values (the lock popup) also loads the gas bar; a respawn rebuilds the gear table, and
        -- this re-finds it (gas keys only).
        local secGas = tab:Section("Gas Bar", "Left", "after a respawn")
        pcall(function() secGas._section.stack = true end)
        secGas:Button("Reload Gas  (~10s)", function()
            if GUI.CharReloadGas then GUI.CharReloadGas() end
        end)
    end)


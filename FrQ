-- ============================================================
-- DEATH LOG WEBHOOK ENGINE
-- ============================================================
-- Detection model: when a player dies in Requiem, their character
-- Model in Workspace is replaced by a model named "<Name>_ragdoll"
-- carrying attributes (Reason, Damage, Category, Timestamp, Actor).
-- We poll Workspace:GetChildren() every PollInterval seconds.
--
-- Event filter: non-event deaths despawn the corpse after a few
-- seconds; event deaths leave the body forever. To filter out
-- non-event noise we don't fire on detection — we hold the ragdoll
-- in Pending and only webhook it if the body is STILL there after
-- PermaThreshold seconds (60s). If it despawns before then we drop
-- it silently and also clear `Seen` so a future death under the
-- same name re-evaluates fresh.
--
-- Routing: Actor=true ragdolls go to DEATHLOG.ActorWebhook (lore/NPC
-- channel), anything else goes to DEATHLOG.Webhook (normal player
-- deaths). Each channel only ever sees its own category.
--
-- Seeding: the first scan after enable adds every existing ragdoll
-- to .Seen WITHOUT queueing — only deaths that happen AFTER the
-- watcher is running can trigger a webhook.

-- Try to read an attribute by name from the ragdoll Model, then from
-- each first-level child. Matcha's GetAttribute is inconsistent on
-- Workspace Models (often returns nil) but works on BaseParts /
-- Humanoids — so probing children is the reliable path.
local function deathGetAttr(inst, name)
    local v
    pcall(function() v = inst:GetAttribute(name) end)
    if v ~= nil then return v end
    local kids
    pcall(function() kids = inst:GetChildren() end)
    if not kids then return nil end
    for _, c in ipairs(kids) do
        local cv
        pcall(function() cv = c:GetAttribute(name) end)
        if cv ~= nil then return cv end
    end
    return nil
end

local function deathReadAttrs(inst)
    return
        deathGetAttr(inst, "Reason"),
        deathGetAttr(inst, "Damage"),
        deathGetAttr(inst, "Category"),
        deathGetAttr(inst, "Timestamp"),
        deathGetAttr(inst, "Actor")
end

-- Strip "_ragdoll" suffix to recover the original player name.
local function deathCleanName(name)
    local stripped = (name or ""):gsub("_ragdoll$", "")
    if stripped == "" then return tostring(name or "?") end
    return stripped
end

-- Uppercase the first character only — "musket" -> "Musket",
-- "animal" -> "Animal". Used to clean up Reason / Category before
-- they're dropped into the message body.
local function deathCapitalize(s)
    if type(s) ~= "string" or #s == 0 then return s end
    return s:sub(1, 1):upper() .. s:sub(2)
end

-- Build the Discord message body. Format:
--   **Player** ( Name ) **Has died.**
--   **Reason:** <Reason>
--   **Amount:** <damage int>
--   **Details:** <Category>
--   **Died on:** <t:<int>:S>
-- Reason / Category are first-letter capitalized. Timestamp gets
-- math.floor() (the game stores 1779493554.14 — only integer seconds
-- are needed for Discord's <t:N:S> token).
local function deathFormatMessage(playerName, reason, damage, category, timestamp)
    local clean = deathCleanName(playerName)

    -- Timestamp → integer seconds. Handle number, numeric string, or nil.
    local tsInt
    if type(timestamp) == "number" then
        tsInt = math.floor(timestamp)
    elseif type(timestamp) == "string" then
        local n = tonumber((timestamp:match("^(%-?%d+)")))
        if n then tsInt = n end
    end
    if not tsInt then
        local okT, t = pcall(os.time)
        tsInt = okT and t or 0
    end

    -- Damage → integer if numeric, otherwise stringify.
    local dmgText
    if type(damage) == "number" then
        dmgText = tostring(math.floor(damage))
    elseif damage ~= nil then
        dmgText = tostring(damage)
    else
        dmgText = "?"
    end

    return string.format(
        "**Player** ( %s ) **Has died.**\n**Reason:** %s\n**Amount:** %s\n**Details:** %s\n**Died on:** <t:%d:S>",
        clean,
        deathCapitalize(tostring(reason or "?")),
        dmgText,
        deathCapitalize(tostring(category or "?")),
        tsInt
    )
end

-- `isActor`=true → post to the actor/lore webhook; otherwise the normal
-- player-deaths webhook. Each webhook only ever sees its own category
-- so neither channel gets cross-posted noise.
-- `url`, when given, overrides both: a caller with a channel of its own (Send Actors).
local function deathSendWebhook(content, isActor, url)
    if type(content) ~= "string" or #content == 0 then return end
    url = url or (isActor and DEATHLOG.ActorWebhook or DEATHLOG.Webhook)
    if type(url) ~= "string" or #url == 0 then return end

    -- Prefer HttpService:JSONEncode (proper escaping) with a minimal
    -- manual fallback if it errors on weird control bytes.
    local body
    local okEnc, encoded = pcall(function()
        return HttpService:JSONEncode({ content = content })
    end)
    if okEnc and type(encoded) == "string" and #encoded > 0 then
        body = encoded
    else
        local esc = content
            :gsub("\\", "\\\\")
            :gsub('"', '\\"')
            :gsub("\n", "\\n")
            :gsub("\r", "\\r")
            :gsub("\t", "\\t")
        body = '{"content":"' .. esc .. '"}'
    end

    -- Fire-and-forget — never block the watcher thread on a 1-2s POST.
    task.spawn(function()
        pcall(function()
            if type(httppost) == "function" then
                httppost(url, body, "application/json")
            else
                game:HttpPost(url, body, "application/json")
            end
        end)
    end)
end

local function deathLogUpdate()
    if not DEATHLOG.Enabled then return end

    local now = tick()
    if now < DEATHLOG.NextPollAt then return end
    DEATHLOG.NextPollAt = now + DEATHLOG.PollInterval

    -- Hoist hot fields into locals — Lua field reads are cheap but
    -- not free, and this is the hot path.
    local seen    = DEATHLOG.Seen
    local pending = DEATHLOG.Pending
    local seeded  = DEATHLOG.Seeded

    -- Single outer pcall around the whole workspace scan. Matcha's
    -- per-pcall overhead is significant (each one crosses the
    -- emulator boundary), so batching all child reads into ONE pcall
    -- instead of one-per-child cuts scan cost dramatically on big
    -- workspaces.
    local liveByName
    pcall(function()
        local kids = Workspace:GetChildren()
        if not kids then return end
        local n = #kids
        local lbn = {}
        for i = 1, n do
            local c = kids[i]
            local nm = c.Name
            if type(nm) == "string" then
                local len = #nm
                if len > 8 and nm:sub(len - 7) == "_ragdoll" then
                    lbn[nm] = c
                    if not seen[nm] then
                        seen[nm] = true
                        if seeded then
                            pending[nm] = {
                                instance    = c,
                                firstSeenAt = now,
                            }
                        end
                    end
                end
            end
        end
        liveByName = lbn
    end)
    if not liveByName then
        DEATHLOG.Seeded = true
        return
    end

    -- Drain Pending. Two outcomes per entry:
    --   * Body still in Workspace AND age >= PermaThreshold → event-perma
    --     death, send the webhook now. (Non-event corpses despawn within
    --     ~5s, so any body that's still around past 60s is a real death.)
    --   * Body vanished before PermaThreshold → normal non-event death,
    --     drop silently. Also clear `seen[nm]` so if the same player
    --     dies again later we re-evaluate that body fresh.
    -- Anything in between just waits another poll.
    if next(pending) ~= nil then
        local threshold = DEATHLOG.PermaThreshold
        for nm, info in pairs(pending) do
            local inst       = liveByName[nm]
            local stillAlive = inst ~= nil
            local elapsed    = now - info.firstSeenAt

            if not stillAlive then
                -- Non-event corpse — body despawned before perma threshold.
                pending[nm] = nil
                seen[nm]    = nil
            elseif elapsed >= threshold then
                local reason, damage, category, timestamp, actor = deathReadAttrs(inst)
                local msg = deathFormatMessage(nm, reason, damage, category, timestamp)
                deathSendWebhook(msg, actor == true)
                DEATHLOG.SentCount = DEATHLOG.SentCount + 1
                local okT, t = pcall(os.time)
                DEATHLOG.LastSent = {
                    name = deathCleanName(nm),
                    when = okT and t or 0,
                }
                pending[nm] = nil
            end
        end
    end

    DEATHLOG.Seeded = true
end

-- On-demand snapshot: scan Workspace right now and webhook every
-- existing ragdoll, regardless of the watcher's Seeded state. Each
-- one is also added to DEATHLOG.Seen so the regular watcher won't
-- re-post the same body. Returns the count actually sent.
-- Assigned to the forward-declared module-level local so the PageLogs
-- button (built much earlier in the file) can resolve it as an upvalue.
deathFetchAllNow = function()
    -- Collect ragdoll Instances first under a single pcall, then do
    -- attribute reads + webhook sends outside the protected section.
    -- Same batching rationale as deathLogUpdate.
    local matches = {}
    pcall(function()
        local kids = Workspace:GetChildren()
        if not kids then return end
        for i = 1, #kids do
            local c = kids[i]
            local nm = c.Name
            if type(nm) == "string" then
                local len = #nm
                if len > 8 and nm:sub(len - 7) == "_ragdoll" then
                    matches[#matches + 1] = { inst = c, name = nm }
                end
            end
        end
    end)

    local sent = 0
    for i = 1, #matches do
        local m = matches[i]
        local nm = m.name
        local reason, damage, category, timestamp, actor = deathReadAttrs(m.inst)
        -- Skip actors entirely — the manual fetch is for normal player
        -- deaths only. Actors get their own dedicated webhook through
        -- the live watcher; pulling them in here would double-post
        -- bodies the user explicitly doesn't want in this channel.
        if actor ~= true then
            local msg = deathFormatMessage(nm, reason, damage, category, timestamp)
            deathSendWebhook(msg, false)
            DEATHLOG.SentCount = DEATHLOG.SentCount + 1
            DEATHLOG.Seen[nm] = true
            DEATHLOG.Pending[nm] = nil
            sent = sent + 1
            local okT, t = pcall(os.time)
            DEATHLOG.LastSent = {
                name = deathCleanName(nm),
                when = okT and t or 0,
            }
        end
    end
    return sent
end

-- "Send Actors" (Logs tab): who in THIS server has the Actor flag. It is an attribute on the
-- PLAYER object. Measured 2026-10-14: one of 86 players had Player.Actor = true, nobody else
-- carried the attribute at all, and it is on neither the character nor its Humanoid. The death
-- log only ever reads it off ragdolls, which is why nothing here could list LIVING actors.
-- Returns the usernames, sorted, and how many players were looked at.
-- A Player GetAttribute costs ~5ms, so a full server is ~0.4s: call it from a spawned thread.
DEATHLOG.ListActors = function()
    local names, total = {}, 0
    local players = {}
    pcall(function() players = Players:GetPlayers() end)
    for _, p in ipairs(players) do
        total = total + 1
        local isActor = false
        pcall(function() isActor = p:GetAttribute("Actor") == true end)
        if isActor then
            local nm = nil
            pcall(function() nm = p.Name end)
            if type(nm) == "string" and nm ~= "" then names[#names + 1] = nm end
        end
    end
    table.sort(names, function(a, b) return a:lower() < b:lower() end)
    return names, total
end

-- Post the list to DEATHLOG.ActorListWebhook as a Discord EMBED:
--     | red bar |   Actors in this server
--                   3 actors  *  86 players
--                   Server  `6d127440-544e-4692-9e28-dc2328691f00`
--                   game.Workspace.A game.Workspace.B game.Workspace.C     <- one line, to copy
-- No footer and no timestamp: the user removed both.
-- (each actor's character model in Workspace is named after their username). No per-actor list on
-- top, as asked; the copy line is a code block, which copies exactly.
-- The JSON is built by hand: Matcha's JSONEncode writes the colour as 15844367.0 and Discord rejects
-- a non-integer colour with a 400 that nobody sees. The bullet is sent as a \u escape,
-- so the body is plain ASCII. httppost BLOCKS the VM until Discord answers and hands back its
-- reply, so a rejection is returned as the third value for the toast to show.
-- One message, never one per actor (a webhook on this feed has been deleted for spam). Up to ~75
-- actors fit one embed; past that the line continues in a second embed of the SAME message.
-- Nothing is sent when there are no actors.
DEATHLOG.SendActors = function()
    local names, total = DEATHLOG.ListActors()
    if #names == 0 then return names, total end
    local url = DEATHLOG.ActorListWebhook
    if type(url) ~= "string" or url == "" then return names, total, "no webhook set" end
    local jobId = nil
    pcall(function() jobId = game.JobId end)

    -- the copy line, in at most two pieces (two embeds stay under Discord's 6000-character total)
    local chunks, line = {}, ""
    for _, nm in ipairs(names) do
        local item = "game.Workspace." .. nm
        if #line > 0 and #line + 1 + #item > 2800 then
            chunks[#chunks + 1] = line
            line = ""
        end
        line = (#line > 0) and (line .. " " .. item) or item
    end
    chunks[#chunks + 1] = line

    local head = "**" .. #names .. "** " .. (#names == 1 and "actor" or "actors")
        .. "  <<DOT>>  **" .. total .. "** players"
    if type(jobId) == "string" and jobId ~= "" then head = head .. "\nServer  `" .. jobId .. "`" end
    local function desc(text) return (rsJsonEscape(text):gsub("<<DOT>>", "\\u2022")) end

    local tail = ""                                                   -- no footer, no timestamp
    local color = ',"color":' .. string.format("%d", 15548997)       -- 0xED4245, Discord red; an INTEGER
    local embeds = {
        '{"title":"Actors in this server"' .. color
            .. ',"description":' .. desc(head .. "\n```\n" .. chunks[1] .. "\n```")
            .. ((chunks[2] == nil) and tail or "") .. "}",
    }
    if chunks[2] then
        embeds[2] = '{"description":' .. desc("```\n" .. chunks[2] .. "\n```") .. color .. tail .. "}"
    end
    local body = '{"embeds":[' .. table.concat(embeds, ",") .. ']}'

    local reply = nil
    local ok = pcall(function()
        if type(httppost) == "function" then
            reply = httppost(url, body, "application/json")
        else
            reply = game:HttpPost(url, body, "application/json")
        end
    end)
    if not ok then return names, total, "the request failed" end
    -- Discord answers a good post with nothing; a rejection is JSON carrying a "message".
    if type(reply) == "string" then
        local why = reply:match('"message"%s*:%s*"([^"]*)"')
        if why then return names, total, why end
    end
    return names, total
end

-- "Send Current Song" (Logs tab > Music): the game's background music, its name and id, to
-- DEATHLOG.MusicWebhook. Measured live 2026-10-22:
--   * the music is Workspace.WorldMusicSoundEffect, attribute FadeState = "Playing". The game finds
--     it by CollectionService tag, but GetTagged does not exist under Matcha, so it is found by name
--     (a crossfade can briefly leave two; the one not fading out wins).
--   * Sound.SoundId reads nil through the shim. It is a std::string in the Sound at +176 (the same
--     on a second Sound, UnderwaterAmbience), read here word by word. Further strings sit at
--     +688..+928 and are NOT the sound id, so if a Roblox update moves it the LOWEST offset holding
--     an asset id is taken, and only when another Sound has one at that offset too.
--   * the song's name is not in the game at all; Roblox's public asset API has it
--     (economy.roblox.com/v2/assets/<id>/details -> "Name"), reachable with HttpGet (~1s).
-- Wrapped in an IIFE: the main chunk is near Lua's 200-local limit, and this only exposes
-- DEATHLOG.SendSong.
;(function()
local MUSIC_SOUNDID_HINT = 176
local function musicPtr(a) local ok, v = pcall(memory_read, "uintptr", a) return ok and v or nil end
local function musicStr(base)
    local len, cap = musicPtr(base + 16), musicPtr(base + 24)
    if not (len and cap) or len < 4 or len > 200 or cap < len or cap > 4096 then return nil end
    local src = (cap < 16) and base or musicPtr(base)
    if type(src) ~= "number" or src < 0x10000 then return nil end
    local out, i = {}, 0
    while i < len do
        local okW, w = pcall(memory_read, "int32", src + i)
        if not okW or type(w) ~= "number" then return nil end
        for b = 0, 3 do
            if i + b < len then
                local ch = bit32.band(bit32.rshift(w, b * 8), 255)
                if ch < 32 or ch > 126 then return nil end
                out[#out + 1] = string.char(ch)
            end
        end
        i = i + 4
    end
    return table.concat(out)
end
-- the numeric id in "rbxassetid://N" or "http://www.roblox.com/asset/?id=N"
local function musicIdAt(addr, off)
    local s = musicStr(addr + off)
    if type(s) ~= "string" or not (s:find("rbxassetid://", 1, true) or s:find("asset/?id=", 1, true)) then return nil end
    return s:match("(%d%d%d%d+)%s*$")
end
local function musicAddr(inst)
    local a = nil
    pcall(function() a = inst.Address end)
    if type(a) == "string" then a = tonumber(a) or tonumber((a:gsub("^0[xX]", "")), 16) end
    return type(a) == "number" and a or nil
end

-- The Sound playing the music right now, or nil.
local function musicSound()
    local best, bestRank = nil, 0
    local kids = {}
    pcall(function() kids = Workspace:GetChildren() end)
    for _, c in ipairs(kids) do
        local nm = nil
        pcall(function() nm = c.Name end)
        if nm == "WorldMusicSoundEffect" then
            local fade = nil
            pcall(function() fade = c:GetAttribute("FadeState") end)
            local rank = (fade == "Playing" and 4) or (fade == "FadingIn" and 3) or (fade == nil and 2)
                or (fade == "FadingOut" and 1) or 0
            if rank > bestRank then best, bestRank = c, rank end
        end
    end
    return best
end

-- The numeric sound id of `snd`, or nil and why.
local function musicSoundId(snd)
    local A = musicAddr(snd)
    if not A then return nil, "could not read the sound" end
    local id = musicIdAt(A, MUSIC_SOUNDID_HINT)
    if id then return id end
    -- moved: the lowest offset that holds an asset id here AND on another Sound
    local other = nil
    pcall(function()
        for _, c in ipairs(Workspace:GetChildren()) do
            if c.ClassName == "Sound" and c.Name ~= "WorldMusicSoundEffect" then
                local b = musicAddr(c)
                if b then other = b; break end
            end
        end
    end)
    for off = 0, 1024, 8 do
        local hit = musicIdAt(A, off)
        if hit then
            if other and musicIdAt(other, off) then
                MUSIC_SOUNDID_HINT = off
                return hit
            end
            return nil, "sound id not found safely on this Roblox build"
        end
    end
    return nil, "sound id not found on this Roblox build"
end

-- A JSON string with everything outside plain ASCII written as \u escapes (UTF-16 pairs above
-- U+FFFF), so a song called "Café" or one with an emoji in it reaches Discord intact whatever
-- happens to the bytes on the way. Invalid UTF-8 falls back to the plain escaper.
local function musicJson(text)
    local out = { '"' }
    local ok = pcall(function()
        for _, cp in utf8.codes(text) do
            if cp == 34 then out[#out + 1] = '\\"'
            elseif cp == 92 then out[#out + 1] = '\\\\'
            elseif cp >= 32 and cp < 127 then out[#out + 1] = string.char(cp)
            elseif cp < 0x10000 then out[#out + 1] = string.format("\\u%04x", cp)
            else
                local v = cp - 0x10000
                out[#out + 1] = string.format("\\u%04x\\u%04x", 0xD800 + math.floor(v / 1024), 0xDC00 + v % 1024)
            end
        end
    end)
    if not ok then return rsJsonEscape(text) end
    out[#out + 1] = '"'
    return table.concat(out)
end

-- Backslash Discord's markdown characters, so a title like "*NSYNC" or "lo_fi_mix" prints as-is.
local function musicMd(text)
    return (text:gsub("([%*_~`|\\])", "\\%1"))
end

-- ISO time ("2026-05-06T10:26:24.43Z", always UTC from Roblox) -> unix seconds. Plain arithmetic
-- (days-from-civil), because os.time() on a table would read it as LOCAL time.
local function isoUnix(s)
    local y, mo, d, h, mi, se = tostring(s or ""):match("^(%d+)%-(%d+)%-(%d+)T(%d+):(%d+):(%d+)")
    if not y then return nil end
    y, mo, d = tonumber(y), tonumber(mo), tonumber(d)
    if mo <= 2 then y = y - 1 end
    local era = math.floor(y / 400)
    local yoe = y - era * 400
    local doy = math.floor((153 * ((mo + 9) % 12) + 2) / 5) + d - 1
    local doe = yoe * 365 + math.floor(yoe / 4) - math.floor(yoe / 100) + doy
    return (era * 146097 + doe - 719468) * 86400 + tonumber(h) * 3600 + tonumber(mi) * 60 + tonumber(se)
end

-- Everything the embed shows, from ONE call to Roblox's public catalogue (~0.2s):
--   { title, duration (whole seconds), created, updated (unix), creator, creatorId, creatorType
--     ("Group"/"User"), updater (the group member who last updated it) }
-- Falls back to the older economy endpoint for just the name if the catalogue does not answer.
local function musicInfo(id)
    local info = {}
    pcall(function()
        local body = game:HttpGet("https://apis.roblox.com/toolbox-service/v1/items/details?assetIds=" .. id)
        local ok, j = pcall(function() return HttpService:JSONDecode(body) end)
        local row = ok and type(j) == "table" and type(j.data) == "table" and j.data[1]
        local a = type(row) == "table" and row.asset
        local c = type(row) == "table" and row.creator
        if type(a) == "table" then
            local t = (type(a.audioDetails) == "table" and a.audioDetails.title) or a.name
            if type(t) == "string" and t ~= "" then info.title = t end
            if type(a.duration) == "number" and a.duration > 0 then info.duration = math.floor(a.duration + 0.5) end
            info.created = isoUnix(a.createdUtc)
            info.updated = isoUnix(a.updatedUtc)
        end
        if type(c) == "table" then
            if type(c.name) == "string" and c.name ~= "" then info.creator = c.name end
            if type(c.id) == "number" then info.creatorId = string.format("%d", c.id) end
            info.creatorType = (c.type == 2 and "Group") or (c.type == 1 and "User") or nil
            if type(c.latestGroupUpdaterUserName) == "string" and c.latestGroupUpdaterUserName ~= "" then
                info.updater = c.latestGroupUpdaterUserName
            end
        end
    end)
    -- Not every song is in that catalogue: it only lists Creator Store items, and a song uploaded
    -- for the game but never listed (e.g. "BP", 140127299664875) is a 404 there. The older economy
    -- endpoint still knows it - name, creator, created and updated - but NOT its length or who last
    -- updated it, and no public endpoint does (the rest need a login). So those two are left out.
    if not info.title or not info.creator then
        pcall(function()
            local body = game:HttpGet("https://economy.roblox.com/v2/assets/" .. id .. "/details")
            local ok, j = pcall(function() return HttpService:JSONDecode(body) end)
            if not (ok and type(j) == "table") then return end
            if not info.title and type(j.Name) == "string" and j.Name ~= "" then info.title = j.Name end
            local c = j.Creator
            if not info.creator and type(c) == "table" and type(c.Name) == "string" and c.Name ~= "" then
                info.creator = c.Name
                if type(c.CreatorTargetId) == "number" then info.creatorId = string.format("%d", c.CreatorTargetId) end
                info.creatorType = (c.CreatorType == "Group" or c.CreatorType == "User") and c.CreatorType or nil
            end
            info.created = info.created or isoUnix(j.Created)
            info.updated = info.updated or isoUnix(j.Updated)
        end)
    end
    return info
end

-- The embed, as a JSON OBJECT string (the menu posts it, or hands it to the helper verbatim).
-- One column, a bold heading over each value and a blank line between blocks (the user found
-- v7.0's three-across inline fields cramped) EXCEPT Created and Updated, which sit side by side
-- as exactly TWO inline fields: with two, Discord gives each half the width, so there is a real
-- gap between them (a third, empty spacer column is what squeezed v7.0). Dates use Discord's
-- <t:unix:D> tag, so everyone sees their own date format and time zone. Anything the catalogue
-- did not return is simply left out.
local function musicEmbed(info, id)
    local blocks = {
        "**Song Name**\n" .. musicMd(info.title or "Unknown"),
        "**Song ID**\n" .. id,
    }
    if info.creator then
        local who = musicMd(info.creator)
        if info.creatorId and info.creatorType == "Group" then
            who = "[" .. who .. "](https://www.roblox.com/communities/" .. info.creatorId .. ")"
        elseif info.creatorId and info.creatorType == "User" then
            who = "[" .. who .. "](https://www.roblox.com/users/" .. info.creatorId .. "/profile)"
        end
        blocks[#blocks + 1] = "**Made By**\n" .. who
    end
    if info.duration then
        blocks[#blocks + 1] = "**Length**\n" .. string.format("%d:%02d", math.floor(info.duration / 60), info.duration % 60)
    end
    local fields = {}
    local function field(name, value)
        fields[#fields + 1] = '{"name":' .. musicJson(name) .. ',"value":' .. musicJson(value) .. ',"inline":true}'
    end
    if info.created then field("Created", string.format("<t:%d:D>", info.created)) end
    if info.updated then
        local v = string.format("<t:%d:D>", info.updated)
        if info.updater then v = v .. " by @" .. musicMd(info.updater) end
        field("Updated", v)
    end
    -- Discord trims blank lines off the END of a description, so the gap before Created/Updated
    -- is a line holding only a zero-width space: it renders as one empty line, matching the gap
    -- between every other block.
    local desc = table.concat(blocks, "\n\n")
    if #fields > 0 then desc = desc .. "\n\u{200B}" end
    return '{"color":' .. string.format("%d", 3447003)       -- 0x3498DB, blue
        .. ',"description":' .. musicJson(desc)
        .. (#fields > 0 and (',"fields":[' .. table.concat(fields, ",") .. "]") or "")
        .. "}"
end


-- ---- Song Helper hand-off (SongHelper\song-helper.js, a normal program on this PC) ----
-- Matcha cannot read the Roblox cache or upload a file, so when the helper is running it sends
-- the message instead, with the song attached. They talk through files in C:\matcha\workspace\RQ:
--   songhelper_alive.txt     the helper writes the unix time every second
--   songhelper_request.json  we write { reqId, id, name, webhook, embed }, the helper deletes it
--   songhelper_result.json   the helper answers { reqId, ok, audio, how, why, name }
--   songhelper_now.json      we write { id, at } when the music changes, so the helper can learn
--                            which cache file is which song from when it was downloaded
-- No helper (another PC, or not started): the menu posts the embed itself, exactly as before.
local HELPER_DIR = "RQ/"
local function helperAlive()
    local t = nil
    pcall(function()
        if type(isfile) == "function" and not isfile(HELPER_DIR .. "songhelper_alive.txt") then return end
        t = tonumber(readfile(HELPER_DIR .. "songhelper_alive.txt"))
    end)
    local now = nil
    pcall(function() now = os.time() end)
    return t ~= nil and now ~= nil and math.abs(now - t) <= 5
end

-- Hand the song to the helper and wait for its answer (an upload with the song attached takes a
-- few seconds). Returns err (or nil) and a short description of the audio for the popup.
local function viaHelper(name, id, url, embed)
    local reqId = string.format("%d-%d", os.time(), math.random(1, 999999999))
    local body = '{"reqId":"' .. reqId .. '","id":"' .. id .. '","webhook":' .. musicJson(url)
        .. ',"name":' .. musicJson(name) .. ',"embed":' .. embed .. "}"
    pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder("RQ") then makefolder("RQ") end
    end)
    local okW = pcall(writefile, HELPER_DIR .. "songhelper_request.json", body)
    if not okW then return "could not write the request for the helper" end
    local t0 = os.clock()
    while os.clock() - t0 < 60 do
        task.wait(0.3)
        local res = nil
        pcall(function()
            local txt = readfile(HELPER_DIR .. "songhelper_result.json")
            local j = HttpService:JSONDecode(txt)
            if type(j) == "table" and j.reqId == reqId then res = j end
        end)
        if res then
            if not res.ok then return tostring(res.why or "the helper failed") end
            if res.audio then return nil, "with the song attached" end
            return nil, "no audio: " .. tostring(res.why or "not found")
        end
    end
    return "the helper did not answer in 60s"
end

-- Report song changes to the helper while it is running (a read of one Sound every 3s).
task.spawn(function()
    local gen = {}
    _G.__RQ_MUSIC = gen
    local last = nil
    while GUI.Running and _G.__RQ_MUSIC == gen do
        if helperAlive() then
            local snd = musicSound()
            local id = snd and musicSoundId(snd) or nil
            if id and id ~= last then
                last = id
                pcall(writefile, HELPER_DIR .. "songhelper_now.json",
                    '{"id":"' .. id .. '","at":' .. string.format("%d", os.time()) .. "}")
            end
        else
            last = nil
        end
        task.wait(3)
    end
end)

-- Posts the embed built by musicEmbed (hand-built JSON: JSONEncode would write the colour as a
-- float, which Discord rejects silently). With the helper running, it posts the same embed and
-- then the song as a second message, so the mp3 sits BELOW the embed (Discord always draws a
-- message's attachments above its embeds, so one message cannot do it).
-- Returns name, id, an error message or nil, and a note about the audio.
DEATHLOG.SendSong = function()
    local snd = musicSound()
    if not snd then return nil, nil, "no music is playing" end
    local id, why = musicSoundId(snd)
    if not id then return nil, nil, why end
    local info = musicInfo(id)
    local name = info.title or "Unknown"
    local url = DEATHLOG.MusicWebhook
    if type(url) ~= "string" or url == "" then return name, id, "no webhook set" end
    local embed = musicEmbed(info, id)
    if helperAlive() then
        local err, audio = viaHelper(name, id, url, embed)
        return name, id, err, audio
    end
    local body = '{"embeds":[' .. embed .. ']}'
    local reply = nil
    local ok = pcall(function()
        if type(httppost) == "function" then
            reply = httppost(url, body, "application/json")
        else
            reply = game:HttpPost(url, body, "application/json")
        end
    end)
    if not ok then return name, id, "the request failed" end
    if type(reply) == "string" then
        local err = reply:match('"message"%s*:%s*"([^"]*)"')
        if err then return name, id, err end
    end
    return name, id
end
end)()  -- /Music

-- ============================================================
-- ACTOR / STAFF ESP ENGINE
-- ============================================================
-- The server never tells other clients who is an actor, so players are
-- flagged from public signals. Every flag is high priority (green name):
--   shared slot   - 2+ players hold the same slot id (Character attr);
--                   only staff-loaded slots can be shared. Slots saved
--                   from earlier sessions count too.
--   Player name   - Name or DisplayName attribute has the word "Player"
--   died as actor - an Actor=true <name>_ragdoll was seen for their slot
--   hidden player - a character in Workspace with no Player object
--                   (staff hid them from the leaderboard). Ignored when
--                   hidden characters outnumber visible players, since
--                   staff can hide the whole server at once. Anyone already
--                   tagged before being hidden keeps their tag while their
--                   character stays in the world.
-- A player with StaffState but no flag is staff (listed in the Player List's Staff tab, never drawn).
--
-- Measured Matcha costs: GetAttribute ~1.5ms, Workspace:FindFirstChild
-- ~2.6ms, reading .Character ~0.07ms. So work runs each frame under a
-- small time budget, and a player's attributes are only re-read when
-- their character model changes (slot loads and respawns both make a
-- new one), plus a slow safety re-read.
-- Wrapped in its own function: the main chunk is near Lua's 200-local cap.
;(function()
    local SLOT_FILE    = CONFIG_DIR .. "/actor_slots.txt"
    local PART_NAMES   = { "HumanoidRootPart", "UpperTorso", "Torso", "Head" }
    local BUDGET       = 0.002
    local ROSTER_EVERY = 2
    local WORLD_EVERY  = 3
    local REREAD_EVERY = 30
    local COLOR_ACTOR  = Color3.fromRGB(40, 255, 90)
    local COLOR_STAFF  = Color3.fromRGB(255, 120, 230)
    local COLOR_TEXT   = Color3.fromRGB(235, 235, 240)
    local COLOR_DIM    = Color3.fromRGB(170, 170, 178)
    local COLOR_PILL   = Color3.fromRGB(24, 24, 28)

    local knownSlots     = {}   -- [slot] = true, persisted actor slots
    local sharedSlots    = {}   -- [slot] = true, seen held by 2+ players
    local ragdollSlots   = {}   -- [slot] = true, seen on an Actor=true ragdoll
    local actorNames     = {}   -- [name] = true, owner of an Actor=true ragdoll
    local pendingRagdoll = {}   -- [name] = true, ragdoll seen before their slot was read
    local cache          = {}   -- [name] = per-player cached reads
    local roster, rosterSet, rosterAt, cursor = {}, {}, -1e9, 0
    local world, worldIdx, worldAt = nil, 0, -1e9
    local checkedRagdolls, ragdollsSeen = {}, {}
    local notCharacter = {}     -- [modelName] = true, top-level models that aren't characters
    local hidden, hiddenSeen = {}, {}
    local remembered = {}       -- [name] = { role, flags } kept when their Player object is hidden
    local dirty = true
    local reported = {}

    local function attr(inst, key)
        local v
        pcall(function() v = inst:GetAttribute(key) end)
        return v
    end

    local function loadKnownSlots()
        if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
        local raw
        pcall(function() if isfile(SLOT_FILE) then raw = readfile(SLOT_FILE) end end)
        if type(raw) ~= "string" then return end
        for id in raw:gmatch("%x+") do
            if #id == 32 then knownSlots[id] = true end
        end
    end

    local function saveKnownSlots()
        if type(writefile) ~= "function" then return end
        pcall(function()
            if type(makefolder) == "function" and type(isfolder) == "function"
               and not isfolder(CONFIG_DIR) then
                makefolder(CONFIG_DIR)
            end
        end)
        local ids = {}
        for id in pairs(knownSlots) do ids[#ids + 1] = id end
        table.sort(ids)
        pcall(writefile, SLOT_FILE, table.concat(ids, "\n"))
    end

    local function rememberSlot(slot)
        if type(slot) == "string" and #slot == 32 and not knownSlots[slot] then
            knownSlots[slot] = true
            saveKnownSlots()
        end
    end

    local function hasPlayerWord(s)
        return type(s) == "string" and s:lower():find("%f[%a]player%f[%A]") ~= nil
    end

    -- Named parts first: Matcha's PrimaryPart on player characters is a
    -- broken shim with no Position, so it's only a last resort.
    local function resolvePart(model)
        for i = 1, #PART_NAMES do
            local part
            pcall(function() part = model:FindFirstChild(PART_NAMES[i]) end)
            if part then return part end
        end
        local pp, pos
        pcall(function() pp = model.PrimaryPart; pos = pp.Position end)
        if pos then return pp end
        return nil
    end

    local function originPos()
        local o
        pcall(function() o = Workspace.CurrentCamera.CFrame.Position end)
        return o or getPlayerPos()
    end

    local function newText(color)
        local t = Drawing.new("Text")
        t.Color = color
        t.Size = ACTOR_ESP.TextSize
        t.Font = TITAN_FONTS[ACTOR_ESP.FontIndex].font
        t.Center = false
        t.Outline = false
        t.Visible = false
        t.ZIndex = 54
        return t
    end

    local function newPill()
        local s = Drawing.new("Square")
        s.Color = COLOR_PILL
        s.Filled = true
        s.Corner = 4
        s.Transparency = 0.85
        s.Visible = false
        s.ZIndex = 53
        return s
    end

    local function newEntry()
        local icon = Drawing.new("Circle")
        icon.Color = COLOR_DIM
        icon.Filled = false
        icon.Thickness = 1
        icon.NumSides = 16
        icon.Radius = 3
        icon.Visible = false
        icon.ZIndex = 54
        local dot = Drawing.new("Circle")
        dot.Color = COLOR_DIM
        dot.Filled = true
        dot.NumSides = 8
        dot.Radius = 1
        dot.Visible = false
        dot.ZIndex = 54
        return {
            distBg   = newPill(),
            distText = newText(COLOR_TEXT),
            icon     = icon,
            dot      = dot,
            nameBg   = newPill(),
            nameText = newText(COLOR_ACTOR),
        }
    end

    local DRAW_KEYS = { "distBg", "distText", "icon", "dot", "nameBg", "nameText" }

    -- Visibility is tracked so hidden labels aren't rewritten every frame.
    local function hideEntry(e)
        if e.shown == false then return end
        e.shown = false
        for i = 1, #DRAW_KEYS do e[DRAW_KEYS[i]].Visible = false end
    end

    local function removeEntry(e)
        for i = 1, #DRAW_KEYS do
            local d = e[DRAW_KEYS[i]]
            pcall(function() d:Remove() end)
        end
    end

    local function markRagdollSlot(slot)
        if type(slot) == "string" and not ragdollSlots[slot] then
            ragdollSlots[slot] = true
            rememberSlot(slot)
        end
    end

    local function refreshRoster(now)
        rosterAt = now
        local plist
        pcall(function() plist = Players:GetPlayers() end)
        if not plist then return end
        local names, set = {}, {}
        for i = 1, #plist do
            local p = plist[i]
            local nm
            pcall(function() nm = p.Name end)
            if nm then
                names[#names + 1] = nm
                set[nm] = true
                local c = cache[nm]
                if c then c.player = p else cache[nm] = { name = nm, player = p } end
                remembered[nm] = nil
            end
        end
        -- Gone from the player list: staff hid them (or they left). Keep what they were tagged
        -- as; it is used while their character is still in the world.
        for nm in pairs(cache) do
            if not set[nm] then
                local e = ACTOR_ESP.Objects[nm]
                if e and e.role then remembered[nm] = { role = e.role, flags = e.flags or "" } end
                cache[nm] = nil
            end
        end
        roster, rosterSet = names, set
        if cursor > #roster then cursor = 0 end
        dirty = true
    end

    -- Returns true when anything that affects classification changed.
    local function visitPlayer(c, origin, now)
        local changed = false
        local char
        pcall(function() char = c.player.Character end)
        if char ~= c.char then
            c.char = char
            c.part = char and resolvePart(char) or nil
            c.readAt = nil
            changed = true
        end

        if c.readAt and now - c.readAt < REREAD_EVERY then return changed end
        c.readAt = now
        local p = c.player
        local slot = attr(p, "Character")
        if slot ~= c.slot then
            c.slot = slot
            c.charName = attr(p, "Name")
            c.display = attr(p, "DisplayName")
            c.staffState = attr(p, "StaffState")
            changed = true
        end
        if pendingRagdoll[c.name] and type(c.slot) == "string" then
            pendingRagdoll[c.name] = nil
            markRagdollSlot(c.slot)
            changed = true
        end
        return changed
    end

    -- Incremental sweep of Workspace's top level for actor ragdolls and
    -- characters whose Player object is hidden. Returns true on changes.
    local function worldStep(now, deadline)
        if not world then
            if now - worldAt < WORLD_EVERY then return false end
            pcall(function() world = Workspace:GetChildren() end)
            worldIdx, hiddenSeen, ragdollsSeen = 0, {}, {}
            if not world then worldAt = now; return false end
        end
        local changed = false
        while worldIdx < #world and os.clock() < deadline do
            worldIdx = worldIdx + 1
            local m = world[worldIdx]
            local nm
            pcall(function() nm = m.Name end)
            if type(nm) == "string" then
                if #nm > 8 and nm:sub(-8) == "_ragdoll" then
                    ragdollsSeen[nm] = true
                    if not checkedRagdolls[nm] then
                        checkedRagdolls[nm] = true
                        if attr(m, "Actor") == true then
                            local base = nm:sub(1, #nm - 8)
                            actorNames[base] = true
                            local c = cache[base]
                            if c and type(c.slot) == "string" then
                                markRagdollSlot(c.slot)
                            else
                                pendingRagdoll[base] = true
                            end
                            changed = true
                        end
                    end
                elseif not rosterSet[nm] and not notCharacter[nm] then
                    local hum
                    pcall(function() hum = m:FindFirstChildOfClass("Humanoid") end)
                    if hum then hiddenSeen[nm] = m else notCharacter[nm] = true end
                end
            end
        end
        if worldIdx >= #world then
            world, worldAt = nil, now
            for nm in pairs(checkedRagdolls) do
                if not ragdollsSeen[nm] then checkedRagdolls[nm] = nil end
            end
            for nm in pairs(hiddenSeen) do
                if not hidden[nm] then changed = true end
            end
            for nm in pairs(hidden) do
                if not hiddenSeen[nm] then changed = true end
            end
            hidden = hiddenSeen
            -- their character is gone too: they left, so a later rejoin starts clean
            for nm in pairs(remembered) do
                if not hiddenSeen[nm] and not rosterSet[nm] then remembered[nm] = nil end
            end
        end
        return changed
    end

    local function classify()
        local counts = {}
        for _, c in pairs(cache) do
            if type(c.slot) == "string" then counts[c.slot] = (counts[c.slot] or 0) + 1 end
        end
        for s, n in pairs(counts) do
            if n >= 2 and not sharedSlots[s] then
                sharedSlots[s] = true
                rememberSlot(s)
            end
        end

        local want = {}
        for name, c in pairs(cache) do
            local flags = {}
            local s = c.slot
            if type(s) == "string" then
                if sharedSlots[s] then flags[#flags + 1] = "shared slot"
                elseif knownSlots[s] then flags[#flags + 1] = "known slot" end
                if ragdollSlots[s] then flags[#flags + 1] = "died as actor" end
            end
            if hasPlayerWord(c.charName) or hasPlayerWord(c.display) then
                flags[#flags + 1] = "Player name"
            end
            local role
            if #flags > 0 then role = "actor" elseif c.staffState ~= nil then role = "staff" end
            if role then
                want[name] = { role = role, flags = table.concat(flags, ", "), char = c.char, part = c.part }
            end
        end
        -- Staff can hide the whole server, which strips every Player object;
        -- being hidden only means something when most players are visible.
        local hiddenCount = 0
        for _ in pairs(hidden) do hiddenCount = hiddenCount + 1 end
        local visibleOthers = #roster - 1
        local hidingIsTell = hiddenCount < visibleOthers
        ACTOR_ESP.hiddenMode = hidingIsTell and "partial" or (hiddenCount > 0 and "whole server" or "none")
        for name, m in pairs(hidden) do
            if not want[name] then
                local mem = remembered[name]
                local flags = {}
                local actor = false
                if mem and mem.role == "actor" then
                    actor = true
                    flags[#flags + 1] = "remembered: " .. (mem.flags ~= "" and mem.flags or "actor")
                end
                if hidingIsTell then actor = true; flags[#flags + 1] = "hidden player" end
                if actorNames[name] then actor = true; flags[#flags + 1] = "died as actor" end
                if actor then
                    want[name] = { role = "actor", flags = table.concat(flags, ", "), char = m }
                elseif mem and mem.role == "staff" then
                    want[name] = { role = "staff", flags = "remembered: staff", char = m }
                end
            end
        end
        -- just hidden, not yet found by the world sweep: keep their current label meanwhile
        for name in pairs(remembered) do
            local e = ACTOR_ESP.Objects[name]
            if not want[name] and e and e.char then
                want[name] = { role = e.role, flags = e.flags, char = e.char, part = e.part }
            end
        end

        for name, w in pairs(want) do
            local e = ACTOR_ESP.Objects[name]
            if not e then
                e = newEntry()
                ACTOR_ESP.Objects[name] = e
            end
            e.role, e.flags = w.role, w.flags
            if e.char ~= w.char then
                e.char = w.char
                e.part = w.part
            end
        end
        for name, e in pairs(ACTOR_ESP.Objects) do
            if not want[name] then
                removeEntry(e)
                ACTOR_ESP.Objects[name] = nil
            end
        end
    end

    function ACTOR_ESP.step(budget)
        local now = os.clock()
        local deadline = now + (budget or BUDGET)
        if now - rosterAt >= ROSTER_EVERY then refreshRoster(now) end
        local origin = originPos()
        local n = #roster
        local visited = 0
        while visited < n and os.clock() < deadline do
            cursor = cursor % n + 1
            local c = cache[roster[cursor]]
            if c and visitPlayer(c, origin, now) then dirty = true end
            visited = visited + 1
        end
        if os.clock() < deadline and worldStep(now, deadline) then dirty = true end
        if dirty then
            dirty = false
            classify()
        end
    end

    -- Catch-up pass when a toggle is switched on; anything it doesn't
    -- reach is finished by the per-frame steps.
    actorEspScan = function()
        rosterAt, worldAt = -1e9, -1e9
        ACTOR_ESP.step(0.3)
    end

    local function entryPos(e)
        local char = e.char
        if not char then return nil end
        local pos
        if e.part then pcall(function() pos = e.part.Position end) end
        if not pos then
            e.part = resolvePart(char)
            if e.part then pcall(function() pos = e.part.Position end) end
        end
        return pos
    end

    -- Camera to their feet (3 studs under the root part), to match Matcha's own ESP readout:
    -- in a side-by-side frame it read 16 where camera-to-root read 14, with the camera above.
    local function distTo(origin, pos)
        local dx, dy, dz = origin.X - pos.X, origin.Y - (pos.Y - 3), origin.Z - pos.Z
        return math.sqrt(dx * dx + dy * dy + dz * dz)
    end

    -- Label cap (MaxLabels 0 = draw none): when more players are tagged than it, only the
    -- nearest get drawn. Selected labels refresh their distance as they
    -- draw; a few others are re-measured per frame, and the nearest set
    -- is re-picked a few times a second.
    local SELECT_EVERY, REFRESH_PER_FRAME = 0.25, 8
    local distCursor, selectAt = 0, -1e9

    function ACTOR_ESP.update()
        if not ACTOR_ESP.Enabled then ACTOR_ESP.hideAll(); return end
        ACTOR_ESP.frames = (ACTOR_ESP.frames or 0) + 1
        local origin = originPos()
        if not origin then ACTOR_ESP.state = "no camera position"; return end
        ACTOR_ESP.state = "ok"
        local limit = ACTOR_ESP.MaxDistance
        local cap = ACTOR_ESP.MaxLabels
        if cap <= 0 then
            ACTOR_ESP.state = "labels set to 0"
            ACTOR_ESP.hideAll()
            return
        end
        local size = ACTOR_ESP.TextSize
        local cw = size * 0.55
        local h = size + 4
        local pad = 4

        -- On death the character model is renamed <name>_ragdoll and becomes the corpse (the
        -- Player still points at it until respawn), so a twice-a-second name check hides the dead.
        local now = os.clock()
        local cands = {}
        for name, e in pairs(ACTOR_ESP.Objects) do
            if e.char and (e.deadAt == nil or now - e.deadAt > 0.5 or e.deadChar ~= e.char) then
                local nm = nil
                pcall(function() nm = e.char.Name end)
                e.dead = type(nm) == "string" and nm:sub(-8) == "_ragdoll"
                e.deadAt, e.deadChar = now, e.char
            end
            if e.dead then
                e.selected = false
                e.state = "dead"
                hideEntry(e)
            elseif e.role == "actor" then
                cands[#cands + 1] = name
            else
                e.selected = false
                e.state = "staff hidden"
                hideEntry(e)
            end
        end

        local n = #cands
        if n <= cap then
            for i = 1, n do ACTOR_ESP.Objects[cands[i]].selected = true end
        else
            for _ = 1, math.min(REFRESH_PER_FRAME, n) do
                distCursor = distCursor % n + 1
                local e = ACTOR_ESP.Objects[cands[distCursor]]
                if not e.selected then
                    local pos = entryPos(e)
                    e.dist = pos and distTo(origin, pos) or math.huge
                end
            end
            if now - selectAt >= SELECT_EVERY then
                selectAt = now
                local order = {}
                for i = 1, n do order[i] = cands[i] end
                table.sort(order, function(a, b)
                    return (ACTOR_ESP.Objects[a].dist or math.huge) < (ACTOR_ESP.Objects[b].dist or math.huge)
                end)
                for i = 1, n do
                    local e = ACTOR_ESP.Objects[order[i]]
                    e.selected = i <= cap and (e.dist or math.huge) <= limit
                end
            end
        end

        for i = 1, n do
            local name = cands[i]
            local e = ACTOR_ESP.Objects[name]
            local pos, screenPos, onScreen, dist
            if e.selected then
                pos = entryPos(e)
                if pos then
                    dist = distTo(origin, pos)
                    e.dist = dist
                    if dist <= limit then
                        screenPos, onScreen = WorldToScreen(Vector3.new(pos.X, pos.Y + 3, pos.Z))
                    end
                end
            end

            if not (screenPos and onScreen) then
                e.state = not e.selected and "over label cap" or not e.char and "no character"
                    or not e.part and "no part" or not pos and "no position"
                    or not screenPos and "too far" or "off screen"
                hideEntry(e)
            else
                e.state = "shown"
                local distStr = tostring(math.floor(dist))
                local distW = pad + #distStr * cw + 4 + 6 + pad
                local nameW = pad + #name * cw + pad
                local left = screenPos.X - (distW + 3 + nameW) / 2
                local top = screenPos.Y - h - 5
                local textY = top + (h - size) / 2

                e.distBg.Position = Vector2.new(left, top)
                e.distBg.Size = Vector2.new(distW, h)
                e.distText.Text = distStr
                e.distText.Position = Vector2.new(left + pad, textY)
                local iconX = left + pad + #distStr * cw + 4 + 3
                e.icon.Position = Vector2.new(iconX, top + h / 2)
                e.dot.Position = Vector2.new(iconX, top + h / 2)

                local nameLeft = left + distW + 3
                e.nameBg.Position = Vector2.new(nameLeft, top)
                e.nameBg.Size = Vector2.new(nameW, h)
                e.nameText.Position = Vector2.new(nameLeft + pad, textY)
                local op = ACTOR_ESP.Opacity or 1
                if e.op ~= op then
                    e.op = op
                    e.distBg.Transparency, e.nameBg.Transparency = 0.85 * op, 0.85 * op
                    e.distText.Transparency, e.nameText.Transparency = op, op
                    e.icon.Transparency, e.dot.Transparency = op, op
                end
                if not e.shown or e.drawnRole ~= e.role then
                    e.nameText.Text = name
                    e.nameText.Color = e.role == "staff" and COLOR_STAFF or COLOR_ACTOR
                    e.drawnRole = e.role
                end
                if not e.shown then
                    e.shown = true
                    for k = 1, #DRAW_KEYS do e[DRAW_KEYS[k]].Visible = true end
                end
            end
        end
    end

    function ACTOR_ESP.hideAll()
        for _, e in pairs(ACTOR_ESP.Objects) do hideEntry(e) end
    end

    function ACTOR_ESP.destroyAll()
        for _, e in pairs(ACTOR_ESP.Objects) do removeEntry(e) end
        ACTOR_ESP.Objects = {}
    end

    -- Keeps an engine error from killing the shared ESP loop; the first
    -- error of each stage is shown on screen.
    function ACTOR_ESP.guard(stage, fn)
        local ok, err = pcall(fn)
        if not ok then ACTOR_ESP.lastError = stage .. ": " .. tostring(err) end
        if not ok and not reported[stage] then
            reported[stage] = true
            pcall(function() uiNotify("Actor ESP error (" .. stage .. ")", tostring(err), 10) end)
        end
    end

    function ACTOR_ESP.summary(role)
        local list = {}
        for name, e in pairs(ACTOR_ESP.Objects) do
            if e.role == role then list[#list + 1] = name .. " (" .. (e.flags ~= "" and e.flags or "StaffState") .. ")" end
        end
        table.sort(list)
        return #list, table.concat(list, "; ")
    end

    loadKnownSlots()
    _G.__RQ_ACTOR_ESP = ACTOR_ESP
end)()

-- ============================================================
-- DIRECT ESP: named players, switched on one by one in the Direct ESP tab, drawn with the Actor
-- ESP pill and a white name. Found through the player list; with Bypass Leaderboard on, a player
-- missing from it (staff hid the leaderboard, which removes Player objects on the client) is found
-- by their character model in Workspace, which keeps the exact username as its name (the lookup is
-- case-sensitive, so the list holds exact Roblox usernames).
-- The list itself is encrypted (RC4-drop768 with a per-blob nonce, base64) so the script does not
-- show who is on it. The key is never in the script: it lives in RQ/direct_esp.txt, written the
-- first time it is entered in the Direct ESP tab (or put there by hand - the textbox cannot paste).
-- ============================================================
;(function()
    local DIRECT_BLOB = "c71d24b0:"
    -- .txt: Matcha's readfile/writefile refuse unknown extensions such as .key
    local KEY_FILE = CONFIG_DIR .. "/direct_esp.txt"

    local function rc4(key, data)
        local S = {}
        for i = 0, 255 do S[i] = i end
        local j, kl = 0, #key
        for i = 0, 255 do
            j = (j + S[i] + key:byte(i % kl + 1)) % 256
            S[i], S[j] = S[j], S[i]
        end
        local i, out = 0, {}
        j = 0
        for n = 1, 768 + #data do
            i = (i + 1) % 256
            j = (j + S[i]) % 256
            S[i], S[j] = S[j], S[i]
            if n > 768 then
                out[#out + 1] = string.char(bit32.bxor(data:byte(n - 768), S[(S[i] + S[j]) % 256]))
            end
        end
        return table.concat(out)
    end

    -- the groups, or nil when the key is wrong
    local function decode(key)
        if type(key) ~= "string" or key == "" then return nil end
        local nonce, b64 = DIRECT_BLOB:match("^(%x+):(.+)$")
        local raw = nil
        pcall(function() raw = base64decode(b64) end)
        if type(raw) ~= "string" then return nil end
        local ok, plain = pcall(rc4, key .. nonce, raw)
        if not ok or plain:sub(1, 6) ~= "RQDE1\n" then return nil end
        local groups, byName = {}, {}
        for line in plain:sub(7):gmatch("[^\n]+") do
            local g, nm, id = line:match("^([^|]+)|([^|]+)|(%d+)$")
            if g then
                if not byName[g] then
                    byName[g] = { name = g, list = {} }
                    groups[#groups + 1] = byName[g]
                end
                table.insert(byName[g].list, { nm, tonumber(id) })
            end
        end
        return groups
    end

    local D = {
        On = {}, Bypass = false, ShowDead = false, Opacity = 1, Found = {},
        Groups = {}, Locked = true,
    }
    do
        local saved = nil
        pcall(function() if isfile(KEY_FILE) then saved = readfile(KEY_FILE) end end)
        local groups = type(saved) == "string" and decode((saved:gsub("%s", ""))) or nil
        if groups then D.Groups, D.Locked = groups, false end
    end
    -- entered in the tab: keep it on this machine only
    function D.unlock(key)
        key = (tostring(key or ""):gsub("%s", ""))
        local groups = decode(key)
        if not groups then return false end
        D.Groups, D.Locked = groups, false
        pcall(function()
            if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(CONFIG_DIR) then
                makefolder(CONFIG_DIR)
            end
            writefile(KEY_FILE, key)
        end)
        return true
    end
    local cfg = GUI.DirectESPCfg
    if type(cfg) == "table" then
        if type(cfg.on) == "table" then
            for k, v in pairs(cfg.on) do if v == true then D.On[k] = true end end
        end
        if type(cfg.bypass) == "boolean" then D.Bypass = cfg.bypass end
        if type(cfg.showDead) == "boolean" then D.ShowDead = cfg.showDead end
        if type(cfg.opacity) == "number" then D.Opacity = math.max(0.1, math.min(1, cfg.opacity)) end
    end
    GUI.DirectESP = D

    -- [name] = { model, part, via, checkedAt, nameAt, dead }
    local track = {}

    local function locate(name)
        local p = nil
        pcall(function() p = Players:FindFirstChild(name) end)
        if p then
            local ch, cn = nil, nil
            pcall(function() ch = p.Character; cn = ch and ch.Name end)
            -- dead: the Player still points at its body (renamed <name>_ragdoll) until respawn
            local dead = type(cn) == "string" and cn:sub(-8) == "_ragdoll"
            if ch and not dead then return ch, "player list" end
            if ch then
                if D.ShowDead then return ch, "body" end
                return nil
            end
        end
        if D.Bypass then
            local m = nil
            pcall(function() m = Workspace:FindFirstChild(name) end)
            if m then return m, "workspace" end
            if D.ShowDead then
                pcall(function() m = Workspace:FindFirstChild(name .. "_ragdoll") end)
                if m then return m, "body" end
            end
        end
        return nil
    end

    local function resolvePart(model)
        for _, n in ipairs({ "HumanoidRootPart", "UpperTorso", "Torso", "Head" }) do
            local part = nil
            pcall(function() part = model:FindFirstChild(n) end)
            if part then return part end
        end
        return nil
    end

    -- switched on from the tab: look now, and say so if they are not here
    function D.search(name)
        local m, via = locate(name)
        track[name] = { model = m, part = m and resolvePart(m), via = via, checkedAt = os.clock() }
        D.Found[name] = m ~= nil
        pcall(function()
            if m then uiNotify("Direct ESP", name .. " found (" .. via .. ")", 3)
            else uiNotify("Direct ESP", "Player not found: " .. name .. (D.Bypass and "" or " - try Bypass Leaderboard"), 4) end
        end)
    end

    task.spawn(function()
        local PILL, TEXT, DIM, NAME = Color3.fromRGB(24, 24, 28), Color3.fromRGB(235, 235, 240),
            Color3.fromRGB(170, 170, 178), Color3.fromRGB(250, 250, 252)
        local DEADC = Color3.fromRGB(225, 110, 110)
        local SIZE, PAD = 13, 4
        local H, CW = SIZE + 4, SIZE * 0.55
        local font = nil
        pcall(function() font = TITAN_FONTS[ACTOR_ESP.FontIndex].font end)
        local function pill()
            local s = Drawing.new("Square")
            s.Color, s.Filled, s.Corner, s.ZIndex, s.Visible = PILL, true, 4, 53, false
            return s
        end
        local function text(c)
            local t = Drawing.new("Text")
            t.Color, t.Size, t.Center, t.Outline, t.ZIndex, t.Visible = c, SIZE, false, false, 54, false
            if font then t.Font = font end
            return t
        end
        local function circle(filled, r)
            local c = Drawing.new("Circle")
            c.Color, c.Filled, c.Radius, c.NumSides, c.ZIndex, c.Visible = DIM, filled, r, filled and 8 or 16, 54, false
            if not filled then c.Thickness = 1 end
            return c
        end
        local KEYS = { "distBg", "distText", "icon", "dot", "nameBg", "nameText" }
        local drawn = {}
        local function hide(d)
            if d.shown == false then return end
            d.shown = false
            for _, k in ipairs(KEYS) do d[k].Visible = false end
        end
        local cursor, lookAt = 0, 0
        while GUI.Running do
            local now = os.clock()
            -- one lookup every 0.25s, round-robin over the names switched on: finds players who
            -- join or respawn later, and lets go of bodies (renamed <name>_ragdoll on death)
            local names = {}
            for nm in pairs(D.On) do names[#names + 1] = nm end
            table.sort(names)
            if #names > 0 and now - lookAt >= 0.25 then
                lookAt = now
                cursor = cursor % #names + 1
                local nm = names[cursor]
                local t = track[nm]
                local stale = not t or not t.model or now - (t.checkedAt or 0) > 3
                if t and t.model and not stale then
                    local mn, par = nil, nil
                    pcall(function() mn = t.model.Name; par = t.model.Parent end)
                    t.dead = type(mn) == "string" and mn:sub(-8) == "_ragdoll"
                    if par == nil or (t.dead and not D.ShowDead) then stale = true end
                end
                if stale then
                    local m, via = locate(nm)
                    if not (t and t.model == m and t.part) then
                        track[nm] = { model = m, part = m and resolvePart(m), via = via }
                        t = track[nm]
                    end
                    t.via, t.checkedAt, t.dead = via, now, via == "body"
                    D.Found[nm] = m ~= nil
                end
            end

            local cam = nil
            pcall(function() cam = Workspace.CurrentCamera.CFrame.Position end)
            local op = D.Opacity
            for nm, d in pairs(drawn) do
                if not D.On[nm] then
                    for _, k in ipairs(KEYS) do pcall(function() d[k]:Remove() end) end
                    drawn[nm] = nil
                end
            end
            for _, nm in ipairs(names) do
                local t = track[nm]
                local d = drawn[nm]
                if not d then
                    d = { distBg = pill(), distText = text(TEXT), icon = circle(false, 3), dot = circle(true, 1),
                          nameBg = pill(), nameText = text(NAME) }
                    d.nameText.Text = nm
                    drawn[nm] = d
                end
                local pos = nil
                local dead = t and t.dead
                if t and t.part and (D.ShowDead or not dead) then pcall(function() pos = t.part.Position end) end
                local s, vis = nil, false
                if pos and cam then s, vis = WorldToScreen(Vector3.new(pos.X, pos.Y + 3, pos.Z)) end
                local label = dead and (nm .. " (dead)") or nm
                if d.label ~= label then
                    d.label = label
                    d.nameText.Text = label
                    d.nameText.Color = dead and DEADC or NAME
                end
                if not (s and vis) then
                    hide(d)
                else
                    if d.op ~= op then
                        d.op = op
                        d.distBg.Transparency, d.nameBg.Transparency = 0.85 * op, 0.85 * op
                        d.distText.Transparency, d.nameText.Transparency = op, op
                        d.icon.Transparency, d.dot.Transparency = op, op
                    end
                    local dx, dy, dz = cam.X - pos.X, cam.Y - (pos.Y - 3), cam.Z - pos.Z
                    local distStr = tostring(math.floor(math.sqrt(dx * dx + dy * dy + dz * dz)))
                    local distW = PAD + #distStr * CW + 4 + 6 + PAD
                    local nameW = PAD + #label * CW + PAD
                    local left = s.X - (distW + 3 + nameW) / 2
                    local top = s.Y - H - 5
                    local ty = top + (H - SIZE) / 2
                    d.distBg.Position, d.distBg.Size = Vector2.new(left, top), Vector2.new(distW, H)
                    d.distText.Text, d.distText.Position = distStr, Vector2.new(left + PAD, ty)
                    local ix = left + PAD + #distStr * CW + 4 + 3
                    d.icon.Position, d.dot.Position = Vector2.new(ix, top + H / 2), Vector2.new(ix, top + H / 2)
                    local nl = left + distW + 3
                    d.nameBg.Position, d.nameBg.Size = Vector2.new(nl, top), Vector2.new(nameW, H)
                    d.nameText.Position = Vector2.new(nl + PAD, ty)
                    if not d.shown then
                        d.shown = true
                        for _, k in ipairs(KEYS) do d[k].Visible = true end
                    end
                end
            end
            task.wait(1 / 60)
        end
        for _, d in pairs(drawn) do
            for _, k in ipairs(KEYS) do pcall(function() d[k]:Remove() end) end
        end
    end)
end)()


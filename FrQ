-- Character-tab lock overlay: dims ONLY the Character panel (rect from _G.RQGeo, published by the
-- patched INS-ui fork) + a centered "Load Values" popup with ONE button. Shows only while the menu
-- is open, the Character tab is active, and Values aren't loaded. Drawn last so its button click wins.
local function drawCharLock()
    local geo = _G.RQGeo
    -- Locked = menu open, on the Character tab, Values not yet loaded.
    -- R.geoLive (the render loop's heartbeat): a MINIMISED menu leaves RQGeo frozen at open=true, and
    -- trusting it painted this scrim over the game with no menu under it.
    local locked = R.geoLive == true and type(geo) == "table" and geo.open == true and geo.tab == "Character"
        and not (GUI.CharIsLoaded and GUI.CharIsLoaded())
    -- Freeze the lib's OWN control input while locked — the patched fork's cN()
    -- callback dispatcher checks this flag and swallows every control callback,
    -- so sliders/buttons/toggles behind the scrim do nothing. Cleared the moment
    -- you load, switch tabs, or close the menu. nil (not false) so a stale flag
    -- can never bleed into another script that shares the fork.
    _G.RQBlockInput = locked or nil
    if not locked then return end
    local gx, gy, gw, gh = geo.cx, geo.cy, geo.cw, geo.ch
    if type(gx) ~= "number" or type(gy) ~= "number" or type(gw) ~= "number" or type(gh) ~= "number" then return end
    if gw < 40 or gh < 40 then return end
    R.fade = 1; R.yoff = 0; R.clipTop = nil; R.clipBot = nil
    -- The lib scales every ZIndex it draws by 10000, so its layers land in the millions. This
    -- clears the tab content it needs to cover, but NOT the lib's own floating overlays —
    -- tooltips (~3.33M), the spotlight palette (~4.13M) and modal dialogs (~4.66M) still sit on
    -- top, which is the behaviour you want from a dialog anyway. Left at 3000000 for that reason;
    -- drawBadge deliberately goes higher because a version pill must never be occluded.
    local Z = 3000000
    rect(gx, gy, gw, gh, C3(8, 8, 11), Z, 0.66, 6)                       -- scrim over ONLY the panel
    local pw = minf(380, gw - 36); local ph = 156
    local px = gx + (gw - pw) / 2; local py = gy + (gh - ph) / 2
    shadow(px, py, pw, ph, Z + 1)
    rect(px, py, pw, ph, T.panel, Z + 2, 0.98, 9)
    rect(px, py, pw, ph, T.red, Z + 3, 0.75, 9, false, 1)
    rect(px, py, pw, 3, T.red, Z + 4, 0.9, 2)
    txt("VALUES LOCKED", px + pw / 2, py + 22, 16, T.red, Z + 4, true, Drawing.Fonts.SystemBold)
    txt("Load Values to use the Character tab.", px + pw / 2, py + 52, 12, T.text, Z + 4, true)
    txt("Scans memory once (~15s). Cached until you rejoin.", px + pw / 2, py + 72, 11, T.muted, Z + 4, true)
    local scanning = GUI.CharIsLoading and GUI.CharIsLoading()
    button("charlockload", px + (pw - 210) / 2, py + ph - 48, 210, 34, scanning and "Scanning memory..." or "Load Values  (~15s)", function()
        if GUI.CharLoad then GUI.CharLoad() end
    end, true, T.red, Z + 5)
    -- This popup is drawn ABOVE the menu (it sits on top of the Character tab), so its click must
    -- still land while the cursor is over the menu -- the render loop's overMenu guard lets only
    -- clicks tagged `top` through.
    if clicks[#clicks] then clicks[#clicks].top = true end
end

-- Version badge, drawn by US rather than by the UI library.
--
-- The library was patched to render a `badge` option and it never once appeared, for two
-- independent reasons — either alone is fatal:
--   1. It funnels every ZIndex through a helper that multiplies it by 10000. The patch passed
--      629997 (copied from a nearby RAW `.ZIndex=629999` assignment that bypasses that helper),
--      so the pill asked for a ZIndex of ~6.3 BILLION — three times past int32, and dropped.
--   2. Both of its alphas are multiplied by the sidebar hover spring, which is 0 whenever the
--      sidebar is collapsed. The saved config has sidebarPinned=false, so that spring is 0 almost
--      always — the window TITLE has the same bug and is invisible for the same reason.
-- Drawing it here means we own the ZIndex, the alpha and the placement, and no future library
-- push can silently break it again.
--
-- Placement: the 40px header band above the content rect, right-aligned, sharing the active tab
-- title's optical centre line. (cx+cw) is the only stable horizontal anchor RQGeo gives us — it
-- reduces to windowRight-18 whether the sidebar is collapsed or hover-expanded, whereas cx alone
-- slides by the full sidebar width every time the cursor crosses the rail.
-- Assumes the sidebar tab layout (the default, and what the saved config selects). Under
-- Settings -> Tab layout -> Top the band belongs to the tab strip instead and this would sit on
-- the tabs; RQGeo publishes nothing that distinguishes the two, so it is simply not supported.
local vbGeo, vbIdle = nil, 0
local function drawBadge()
    local ver = tostring(GUI.Version or "")
    if ver == "" then return end
    local geo = _G.RQGeo
    -- The library rebuilds RQGeo as a fresh table on every frame it renders the window, so table
    -- IDENTITY is a free liveness signal. It matters because minimising to the bubble skips the
    -- whole window renderer: RQGeo then freezes with open=true and a rect describing a window
    -- that is no longer on screen, and anything trusting it paints a ghost over the game.
    if geo ~= vbGeo then vbGeo = geo; vbIdle = 0 else vbIdle = vbIdle + R.dt end
    local live = type(geo) == "table" and geo.open == true and vbIdle <= 0.25
    -- open flips instantly but the window fades over ~200ms; ride the same curve so the badge
    -- doesn't pop in ahead of the menu it belongs to.
    local op = av("verbadge", live and 1 or 0, 12)
    if op < 0.02 or type(geo) ~= "table" then return end
    local cx, cy, cw, ch = geo.cx, geo.cy, geo.cw, geo.ch
    if type(cx) ~= "number" or type(cy) ~= "number" or type(cw) ~= "number" or type(ch) ~= "number" then return end
    if cw < 200 or ch < 40 then return end   -- half-initialised rect the lib can publish on frame one
    -- All the draw fns share ONE pcall, so a panel that throws mid-draw leaves its fade and its
    -- scissor band set for everyone after it. Reset all four or the badge silently clips to
    -- nothing — and clipTop without clipBot is a hard error in rect().
    R.fade = op; R.yoff = 0; R.clipTop = nil; R.clipBot = nil
    local fs, h = 11, 18
    local w = maxf(34, floor(tw(ver, fs)) + 18)
    local x = cx + cw - w
    local y = cy - 37   -- cy-48 is the top of the band; this centres the pill on the tab title
    -- 5,000,000 clears the library's real ceiling of 4,659,999 (its modal dialog's button labels,
    -- base 455 through the x10000 helper). 3,000,000 — what drawCharLock above uses — does NOT:
    -- tooltips, the spotlight palette and dialogs all outrank it.
    local Z = 5000000
    rect(x, y, w, h, T.red, Z, 0.22, 6)
    rect(x, y, w, h, T.red, Z + 1, 0.60, 6, false, 1)      -- explicit thickness: pooled Squares keep the last one
    -- Dead centre, measured off a real screenshot rather than guessed: with Center=true Matcha
    -- treats Position as the text's CENTRE on BOTH axes, not as a top-left corner. So the pill's
    -- midpoint is the whole answer. (The engine's own button()/tabs() helpers pass a top-left
    -- style y here and consequently draw their labels a few px high — don't copy them.)
    txt(ver, x + w / 2, y + h / 2, fs, T.text, Z + 2, true)   -- T.text so a dark custom accent can't hide it
    R.fade = 1
end


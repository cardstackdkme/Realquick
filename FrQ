        -- ---------- Firearms (EVERY gun): zero inaccuracy + recoil ----------
        -- Sets BASE_INACCURACY_OFFSET (7.5) + BASE_RECOIL_IMPULSE (2) -> 0. Both are client-read
        -- (spread in getProjectilePhysics, recoil in the AddVelocity kick), so 0 = dead-center,
        -- no kick. getgc matches the key across EVERY firearm config (defaults differ: inaccuracy
        -- 2.5/7.5/8.5, recoil 2/4) so "Zero" writes 0 to all guns; "Restore" writes each gun's OWN
        -- captured original back PER-ENTRY (applygc on a 1-entry list = that one address only), so
        -- the 2.5/8.5/4 guns are never flattened to a single value.
        -- This INCLUDES the BlunderBuss. It EXCLUDES thunderspears — those own their two constants
        -- outright in their own panel, so the two can never fight over the same addresses.
        local secFire = tab:Section("Firearm Auto", "Left", "One press: no spread / no recoil")
        secFire:Label(function() return "Inaccuracy 0 | Recoil 0   (guns only, not spears)" end)
        local FIRE_KEYS = { "BASE_INACCURACY_OFFSET", "BASE_RECOIL_IMPULSE" }
        -- key -> { [addr] = original }, captured before the FIRST write. Lives in the per-JobId _G
        -- table so a script RE-RUN in the same server can still Restore — as a plain local it was
        -- lost on reload while the writes stayed applied, leaving no way back to stock.
        local fireOrig = bbState.fireOrig or {}
        bbState.fireOrig = fireOrig
        -- Shared by the zero button AND the Weapons Manual sliders below, so whichever you use,
        -- Restore still puts the PER-GUN originals back. That matters because the stock values
        -- differ (inaccuracy 2.5 / 7.5 / 8.5 / 15, recoil 2 / 4) and any single written number
        -- flattens them all — without this snapshot the differences would be gone for good.
        -- Thunderspears share BASE_INACCURACY_OFFSET with all 12 gun entries, so the guns panel
        -- and the spear panel must be told apart by ADDRESS or whichever you pressed last would
        -- silently clobber the other.
        --
        -- Identify them by ANCHOR, not by value. The obvious test — "the entry whose value is 15"
        -- — is self-erasing: the moment the spear panel writes 3, it can never be found again.
        -- INACCURACY_REFERENCE_DISTANCE is spear-exclusive (exactly 2 numeric entries in the whole
        -- game) and NEITHER panel's identity depends on what we wrote, so it survives our own
        -- edits. Its slot sits +64 bytes from the spear's inaccuracy slot; the nearest FOREIGN
        -- inaccuracy slot is ~3.1 MB away, so a 2048-byte moat has ~1500x headroom.
        -- The module is instantiated twice (two anchors, ~742 MB apart) and BOTH must be written,
        -- or one config stays stale — so resolve per anchor rather than aborting on "2 matches".
        local TS_WINDOW = 2048
        local function tsResolve()
            if bbState.ts then return bbState.ts end
            local cands   = entriesFor("BASE_INACCURACY_OFFSET")
            local anchors = entriesFor("INACCURACY_REFERENCE_DISTANCE")
            if #anchors == 0 then return nil, "spear config not loaded - equip thunderspears once" end
            local out, n = {}, 0
            for _, an in ipairs(anchors) do
                local aa = gcAddr(an)
                local hit, hits = nil, 0
                if aa then
                    for _, c in ipairs(cands) do
                        local ca = gcAddr(c)
                        if ca and math.abs(ca - aa) <= TS_WINDOW then hit = c; hits = hits + 1 end
                    end
                end
                -- exactly one, or we cannot tell spears from a co-located gun: refuse
                if hits ~= 1 then return nil, "spear layout unexpected (" .. hits .. " near anchor)" end
                out[gcKey(hit)] = true
                n = n + 1
            end
            if n ~= #anchors then return nil, "resolved " .. n .. "/" .. #anchors end
            bbState.ts = out          -- cache only a COMPLETE resolve
            return out
        end
        -- applygc on a ONE-entry list writes exactly that address, which is how we hit a subset.
        -- Verified per entry: range-check the address still reads sanely, write, then read back.
        -- Without the read-back, pcall returning true proves nothing — applygc can no-op.
        local function writeEntries(key, list, value)
            local cfg, done = CFG[key], 0
            for _, e in ipairs(list) do
                local a = gcAddr(e)
                if a and type(memory_read) == "function" then
                    local okR, cur = pcall(memory_read, "double", a)
                    cur = okR and gcNum(cur) or nil
                    if cur and cfg and cur >= cfg.lo and cur <= cfg.hi then
                        pcall(function() applygc({ e }, key, value) end)
                        local okB, back = pcall(memory_read, "double", a)
                        back = okB and gcNum(back) or nil
                        if back and math.abs(back - value) < 0.0001 then done = done + 1 end
                    end
                end
            end
            return done == #list, done
        end
        -- Every gun EXCEPT thunderspears. FAILS CLOSED: if the partition can't be resolved we
        -- refuse rather than fall through and write the spear config too.
        local function fireWrite(key, value)
            local safe = entriesFor(key)
            if #safe == 0 then return false, "no entries - equip a firearm once" end
            local ts, why
            if key == "BASE_INACCURACY_OFFSET" then
                ts, why = tsResolve()
                if not ts then return false, why end
            end
            fireOrig[key] = fireOrig[key] or {}
            local list, skipped = {}, 0
            for _, e in ipairs(safe) do
                local a = gcKey(e)
                if a and ts and ts[a] then
                    skipped = skipped + 1
                elseif a then
                    list[#list + 1] = e
                    if fireOrig[key][a] == nil then fireOrig[key][a] = gcNum(e.value) end
                end
            end
            if ts and skipped == 0 then return false, "partition failed - refused to touch spears" end
            if #list == 0 then return false, "nothing to write" end
            -- NEVER RAISE a gun above its own stock. One slider sends one number to every gun, but
            -- the stocks differ (inaccuracy 2.5 / 7.5 / 8.5, recoil 2 / 4), so an unclamped write at
            -- the 7.5 default made the ACCURATE guns worse: the Kar98k is 2.5 stock and got flattened
            -- to three times its spread. Clamping per entry against the captured original keeps
            -- "lower is better" true for every gun, and 0 still zeroes all of them.
            -- Written one entry at a time because the clamped value differs per gun, and a 1-entry
            -- applygc list is the documented safe write anyway.
            local done = 0
            for _, e in ipairs(list) do
                local a = gcKey(e)
                local orig = a and fireOrig[key][a]
                local v = value
                if type(orig) == "number" and orig < v then v = orig end
                if writeEntries(key, { e }, v) then done = done + 1 end
            end
            if done ~= #list then return false, string.format("%d/%d writes landed", done, #list) end
            return true
        end
        local function fireRestore()
            local n = 0
            for _, key in ipairs(FIRE_KEYS) do
                local orig = fireOrig[key]
                if orig then
                    for _, e in ipairs(entriesFor(key)) do
                        local o = orig[gcKey(e)]
                        -- 1-entry applygc = that one address only, so each gun gets ITS own value
                        if o ~= nil then
                            pcall(function() applygc({ e }, key, o) end)
                            n = n + 1
                        end
                    end
                end
            end
            return n
        end
        secFire:Button("Apply Firearms", function()
            if not gateOK() then return end
            task.spawn(function()
                local okAll, why = true, nil
                for _, key in ipairs(FIRE_KEYS) do
                    local ok, reason = fireWrite(key, 0)
                    if not ok then okAll = false; why = why or reason end
                end
                -- surface the resolver's own reason: "equip a firearm first" was previously
                -- printed for a partition failure too, which is a completely different problem
                notif("Firearms", okAll and "Guns zeroed (spears untouched)" or ("Failed - " .. tostring(why)), 4)
            end)
        end)
        secFire:Button("Restore Default", function()
            if not gateOK() then return end
            task.spawn(function()
                local n = fireRestore()
                notif("Firearms", n > 0 and ("Restored " .. n .. " gun values") or "Nothing to restore - no writes recorded", 3)
            end)
        end)

        -- ---------- Blunderbuss (TEST): live-tune pellet spread ----------
        -- Inaccuracy and recoil moved OUT of this panel and into the Firearms button above (which
        -- zeroes them on every gun, BlunderBuss included). What's left here is PELLET_SPREAD_OFFSET
        -- — the pellet CONE, which only the two pellet guns have and which nothing else touches.
        --
        -- The fingerprint below no longer stock-checks inaccuracy/recoil, and that removal is
        -- REQUIRED, not a shortcut: the Firearms button zeroes those exact slots, so a
        -- "must still be at stock" test on them would abort this panel forever the moment you used
        -- it. Identity is still pinned by the anchor pair plus a unique, at-stock spread slot.
        --
        -- WHY THIS ISN'T JUST "getgc the key and write it": the BlunderBuss SHARES
        -- BASE_INACCURACY_OFFSET 7.5 with the Musket and the Flintlock, and BASE_RECOIL_IMPULSE 2
        -- with FOUR other guns. Writing by name (or by value) retunes every one of them.
        --
        -- So we FINGERPRINT the BlunderBuss's own config table instead: one weapon's constants live
        -- in ONE Lua table, so their GC value-slots sit a few hundred bytes apart. Live scan
        -- (2026-07-15) -- SPREAD_REFERENCE_DISTANCE 45 / MAX_PRECISION_SCALING 0.5 / inaccuracy 7.5 /
        -- recoil 2 / spread 8.35 / PELLET_COUNT 10 all landed in ONE ~900-byte window, while the
        -- nearest competing same-key entry was 5,000+ bytes out (a 30-80x margin).
        --
        -- Nearest-address ALONE is not safe: one gun's table can lack a key entirely, so an
        -- unbounded "closest" would silently pick a DIFFERENT weapon. The candidate must therefore
        -- (a) sit within BB_WINDOW of the anchor AND (b) currently hold its stock value, and any
        -- 0-or->1 match ABORTS without writing.
        --
        -- The anchor uses only keys this section never writes (PELLET_COUNT 10 +
        -- SPREAD_REFERENCE_DISTANCE 45 -- which are also exactly what separates the BlunderBuss from
        -- the TrenchShotgun's 9 / 60), so our own edits can't destroy the fingerprint.
        --
        -- Writes go through applygc on a ONE-entry list = that single address only (bridge.lua /
        -- reference §28: applygc writes the entries you hand it; setgc matches by name across the
        -- whole heap and is the documented corruption path). Each write is compare-and-swap'd first
        -- and read back after, so a stale address reports instead of scribbling somewhere random.
        -- PELLET_COUNT is deliberately NOT tunable here.
        local BB_STOCK  = { spread = 835/100 }   -- integer fraction: Matcha's parser has choked on
                                                 -- some decimal literals
        local BB_KEY    = { spread = "PELLET_SPREAD_OFFSET" }
        local BB_ORDER  = { "spread" }
        local BB_LABEL  = { spread = "Spread" }
        local BB_SCAN   = { "PELLET_COUNT", "SPREAD_REFERENCE_DISTANCE", "PELLET_SPREAD_OFFSET" }
        local BB_WINDOW = 2048        -- max bytes from the anchor. Live: our own slots are 64-800 out
                                      -- and the nearest OTHER gun's slot is 4936 -> 2.4x headroom.
        local BB_EPS    = 1/1000000   -- NOT 1e-6: sci-notation literals can trip Matcha's parser
                                      -- ("Malformed number"), which would kill the whole chunk
        local BB_STEP   = 5/100       -- 0.05: the lib derives display precision from step MAGNITUDE,
                                      -- so 0.05 is exact but 0.25 would render as 0.3
        local bbStatus  = bbState.ok and "Slot resolved - press Apply" or "Idle - press Apply"
        -- Last value written, persisted per-server so a script RE-RUN seeds the slider from what is
        -- actually in memory instead of snapping the UI back to stock while the tune is still live.
        local bbLive    = bbState.live or { spread = BB_STOCK.spread }
        bbState.live    = bbLive
        local bbVal     = { spread = bbLive.spread or BB_STOCK.spread }

        -- getgc reports .addr as a number in-VM but as a hex string on some builds -> take both.
        local function bbAddr(e)
            if type(e) ~= "table" then return nil end
            local a = e.addr
            if type(a) == "number" then return a end
            if type(a) == "string" then return tonumber(a) or tonumber((a:gsub("^0[xX]", "")), 16) end
            return nil
        end
        local function bbNum(v) local n = tonumber(v); if n and n == n then return n end return nil end
        local function bbNear(a, b) return a ~= nil and b ~= nil and math.abs(a - b) <= BB_EPS end

        -- ONE snapshot for all three keys. This is load-bearing: entriesFor() re-scans a key whose
        -- cache list is EMPTY and never re-scans one that is populated, so the anchor keys could
        -- come from a fresh sweep while the spread key came from an older one. In that split the
        -- BlunderBuss's own spread slot may be absent from the candidate list entirely and the
        -- nearest survivor belongs to the other pellet gun -- an invisible mis-resolve that no later
        -- check could catch. Reading one snapshot makes that impossible.
        -- Prefer the Load Values sweep (already paid for); only if the BlunderBuss wasn't resident
        -- then do we spend one dedicated getgc, rate-limited so a retry can't become a scan loop.
        local function bbSnapshot()
            local snap = {}
            for _, k in ipairs(BB_SCAN) do
                snap[k] = {}
                for _, e in ipairs(cache[k] or {}) do
                    if e and e.key == k and e.type == "number" and bbAddr(e) and bbNum(e.value) then
                        local t = snap[k]; t[#t + 1] = e
                    end
                end
            end
            if #snap.PELLET_COUNT > 0 and #snap.PELLET_SPREAD_OFFSET > 0 then return snap end
            local now = os.clock()
            if bbState.lastScan and (now - bbState.lastScan) < 20 then return snap end
            bbState.lastScan = now
            local ok, raw = pcall(function() return getgc(BB_SCAN) end)
            if not ok or type(raw) ~= "table" then return snap end
            local fresh = {}
            for _, k in ipairs(BB_SCAN) do fresh[k] = {} end
            for _, e in pairs(raw) do
                if type(e) == "table" and e.type == "number" and fresh[e.key]
                    and bbAddr(e) and bbNum(e.value) then
                    local t = fresh[e.key]; t[#t + 1] = e
                end
            end
            return fresh
        end

        -- Anchor = a PELLET_COUNT==10 slot with a SPREAD_REFERENCE_DISTANCE==45 slot beside it
        -- (the TrenchShotgun, the only other pellet gun, is 9 / 60).
        --
        -- THERE ARE ALWAYS TWO. The weapon module is instantiated twice, so two identical
        -- BlunderBuss config tables exist (measured ~763 MB apart). The old code treated the
        -- second one as ambiguity and aborted — which means this panel never wrote a single byte
        -- since it was added. Return every anchor and write them all; leaving one stale makes the
        -- result depend on which copy the game happens to read.
        local function bbAnchors(snap)
            local seen, hits = {}, {}
            for _, pc in ipairs(snap.PELLET_COUNT) do
                if bbNear(bbNum(pc.value), 10) then
                    local pa = bbAddr(pc)
                    for _, sr in ipairs(snap.SPREAD_REFERENCE_DISTANCE) do
                        local sa = bbAddr(sr)
                        if bbNear(bbNum(sr.value), 45) and pa and sa and math.abs(pa - sa) <= BB_WINDOW then
                            local k = string.format("%.0f", pa)   -- %.0f, not tostring: big addresses
                            if not seen[k] then                   -- would render in scientific notation
                                seen[k] = true
                                hits[#hits + 1] = pa
                            end
                        end
                    end
                end
            end
            if #hits == 0 then return nil, "BlunderBuss not in memory - equip one, then retry" end
            return hits
        end

        -- Per anchor, the slot must be the ONLY entry of its key inside the window — a moat: a
        -- second one means another gun's table is co-located and we cannot tell them apart.
        -- NOTE there is deliberately no "still at stock" test any more. Identity comes from the
        -- anchor pair, which this panel never writes; testing a value we DO write is self-erasing
        -- and was what made the old resolver a one-shot.
        local function bbResolveFresh()
            local snap = bbSnapshot()
            local anchors, why = bbAnchors(snap)
            if not anchors then return nil, why end
            local out = {}
            for _, slot in ipairs(BB_ORDER) do
                local key, list = BB_KEY[slot], {}
                for _, anchor in ipairs(anchors) do
                    local cands = {}
                    for _, e in ipairs(snap[key]) do
                        local ea = bbAddr(e)
                        if ea and math.abs(ea - anchor) <= BB_WINDOW then cands[#cands + 1] = e end
                    end
                    if #cands ~= 1 then
                        return nil, key .. ": " .. #cands .. " candidates near an anchor - wrote nothing"
                    end
                    list[#list + 1] = cands[1]
                end
                out[slot] = list
            end
            return out
        end

        -- Resolve once per server, then reuse: after the first write the stock-value test can never
        -- pass again. Same Lua VM = same addresses (Luau's GC never moves objects); a rejoin makes a
        -- new JobId, which rebuilds the whole cache against a freshly-stock game. NOTE: the latch is
        -- set by bbApply only after the write verifies, so a bad resolve is never made sticky.
        local function bbResolve()
            if bbState.ok and bbState.slots then return bbState.slots end
            return bbResolveFresh()
        end

        -- One slot: sanity-check the address still reads a plausible value for this key, write via a
        -- ONE-entry applygc, then read back to prove it landed. The check is a RANGE not an equality:
        -- identity was already established at resolve time, so its only job here is catching a
        -- dangling pointer -- an equality check would refuse every write after the first one.
        local function bbWriteSlot(slot, e, value)
            local a = bbAddr(e)
            if not a then return false, "no address" end
            if type(applygc) ~= "function" then return false, "applygc unavailable" end
            -- fail closed: without a read-back we cannot prove anything, so we refuse rather than
            -- report a green "Applied" for a write that may never have happened
            if type(memory_read) ~= "function" then return false, "Unsafe LuaU off" end
            local cfg = CFG[e.key]
            local ok, cur = pcall(memory_read, "double", a)
            cur = ok and bbNum(cur) or nil
            if cur == nil then return false, "unreadable" end
            if not (cfg and cur >= cfg.lo and cur <= cfg.hi) then
                return false, "slot moved (" .. tostring(cur) .. ") - rejoin"
            end
            pcall(function() applygc({ e }, e.key, value) end)
            local ok2, now = pcall(memory_read, "double", a)
            now = ok2 and bbNum(now) or nil
            if not bbNear(now, value) then return false, "write rejected" end
            bbLive[slot] = value
            return true
        end

        local function bbApply(vals, tag, quiet)
            local slots, why = bbResolve()
            if not slots then
                bbStatus = "FAILED: " .. tostring(why)
                if not quiet then notif("Blunderbuss", bbStatus, 5) end
                return
            end
            local okAll, parts = true, {}
            for _, slot in ipairs(BB_ORDER) do
                local list = slots[slot] or {}
                local wrote, failed = 0, nil
                -- write EVERY instance of the config, not just the first
                for _, e in ipairs(list) do
                    local ok, err = bbWriteSlot(slot, e, vals[slot])
                    if ok then wrote = wrote + 1 else failed = failed or err end
                end
                if wrote == #list and wrote > 0 then
                    parts[#parts + 1] = string.format("%s %.2f", BB_LABEL[slot], vals[slot])
                else
                    okAll = false
                    parts[#parts + 1] = string.format("%s %s (%d/%d)", BB_LABEL[slot],
                        tostring(failed or "no slots"), wrote, #list)
                end
            end
            -- only make the resolution sticky once the write has been verified
            if okAll then bbState.ok, bbState.slots = true, slots end
            bbStatus = (okAll and tag or "PARTIAL") .. ": " .. table.concat(parts, " | ")
            if not quiet then notif("Blunderbuss", bbStatus, okAll and 3 or 5) end
        end

        -- ---------- Firearm Manual: tune by hand instead of going all-zero ----------
        -- Three scopes live in this one section, and the differences are not cosmetic:
        --   Inaccuracy    -> every gun EXCEPT thunderspears (their addresses are excluded by
        --                    tsResolve(), so this panel and the spear panel never fight)
        --   Recoil        -> every gun; thunderspears have no recoil constant at all
        --   Pellet Spread -> BlunderBuss ONLY, via the address fingerprint above, because
        --                    PELLET_SPREAD_OFFSET is shared with the other pellet gun
        -- Guns have different stock values, so one slider flattens them to a single number;
        -- Restore puts each gun's own value back from the pre-write snapshot.
        local wmInacc, wmRecoil = 7.5, 2   -- musket/flintlock stock, the most common of each
        local secBB = tab:Section("Firearm Manual", "Right", "Hand-tune instead of zeroing")
        secBB:Label(function() return bbStatus end)
        -- Ranges are capped at the WORST stock value in the game (inaccuracy 8.5, recoil 4) — there
        -- is no reason to offer a setting that shoots straighter guns crooked.
        secBB:Slider("Inaccuracy", wmInacc, 0.1, 0, 8.5, "",
            function(v) wmInacc = tonumber(v) or wmInacc end,
            "Aim-point scatter, for every gun EXCEPT thunderspears. Stock is 2.5 (Kar98k, scoped Kar98k) / 7.5 (musket, flintlock) / 8.5. This only ever LOWERS a gun - a gun already tighter than the slider keeps its own value, so you cannot accidentally make the Kar98k worse. 0 = dead centre.")
        secBB:Slider("Recoil", wmRecoil, BB_STEP, 0, 4, "",
            function(v) wmRecoil = tonumber(v) or wmRecoil end,
            "Camera kick, for every gun. Stock 2 on most, 4 on one. Only ever LOWERS a gun. 0 = no kick. Thunderspears have no recoil constant at all - they kick via a separate camera shake.")
        secBB:Slider("Pellet Spread", bbVal.spread, BB_STEP, 0, BB_STOCK.spread, "",
            function(v) bbVal.spread = tonumber(v) or bbVal.spread end,
            "BlunderBuss ONLY - pellet cone radius (x max(0.5, accuracy)). 0 = all 10 pellets dead centre. Stock 8.35")
        secBB:Button("Apply Weapons", function()
            if not gateOK() then return end
            task.spawn(function()
                local okAll = fireWrite("BASE_INACCURACY_OFFSET", wmInacc)
                if not fireWrite("BASE_RECOIL_IMPULSE", wmRecoil) then okAll = false end
                notif("Weapons", okAll and string.format("All guns: inacc %.2f | recoil %.2f", wmInacc, wmRecoil)
                    or "Inaccuracy/recoil failed - equip a firearm first", 3)
                bbApply(bbVal, "Applied")   -- BlunderBuss pellet cone, reported via the status label
            end)
        end)
        secBB:Button("Restore Default", function()
            if not gateOK() then return end
            -- Put the sliders back too, so the panel shows what is actually in memory.
            wmInacc, wmRecoil = 7.5, 2
            bbVal.spread = BB_STOCK.spread
            task.spawn(function()
                fireRestore()               -- per-gun originals, NOT one flattened number
                bbApply(BB_STOCK, "Restored")
                notif("Weapons", "Restored stock spread, recoil and pellet cone", 3)
            end)
        end)

        -- ---------- Thunderspears ----------
        -- The spear's whole accuracy model is two numbers. It picks an aim point
        -- REFERENCE_DISTANCE studs straight ahead, jitters that point by up to +/-INACCURACY on
        -- each axis, and fires at it — so the cone half-angle is atan(inaccuracy / distance).
        -- That gives two ways to tighten it, and they are NOT equivalent:
        --   Spear Inaccuracy  -> shrinks the jitter. Shared key, but we write ONLY the spear
        --                        addresses (see tsResolve), so guns are untouched.
        --   Aim Distance      -> lengthens the lever arm, which divides the cone down without
        --                        touching the jitter. INACCURACY_REFERENCE_DISTANCE has exactly
        --                        two numeric entries in the whole game and both are spears, so
        --                        this one is inherently safe. 1000 = a tenth of the stock cone.
        local tsInacc, tsDist = 15, 100
        -- addr -> pre-write value. In the per-JobId _G table for the same reason as fireOrig:
        -- as a plain local, a script re-run kept the writes but lost the way back.
        local tsOrig = bbState.tsOrig or {}
        bbState.tsOrig = tsOrig
        local secTS = tab:Section("Thunderspears", "Right", "Spear accuracy")
        secTS:Slider("Spear Inaccuracy", tsInacc, 0.1, 0, 15, "",
            function(v) tsInacc = tonumber(v) or tsInacc end,
            "Random scatter applied to the aim point, in studs. Stock 15 - by far the loosest weapon in the game. 0 = perfectly straight.")
        secTS:Slider("Aim Distance", tsDist, 25, 100, 1000, "",
            function(v) tsDist = tonumber(v) or tsDist end,
            "How far ahead the aim point sits. Bigger = tighter cone, because the spread angle is inaccuracy divided by this. Stock 100; 1000 makes the same jitter ten times tighter.")
        -- Camera shake on throw. Zeroing Amplitude alone already flattens the output vector
        -- (offset = noise * Amplitude), but we also stop the shake outright: FadeOutTime 0 is
        -- explicitly handled by Shake.Update as "finish now", and SustainTime 0 removes the hold.
        -- FIRE_SHAKE_FREQUENCY is deliberately NOT in this list — see the CFG comment; it is a
        -- divisor, and 0 there NaNs your camera instead of removing the shake.
        local TS_SHAKE = { "FIRE_SHAKE_AMPLITUDE", "FIRE_SHAKE_ROTATION_INFLUENCE",
                           "FIRE_SHAKE_SUSTAIN_TIME", "FIRE_SHAKE_FADE_OUT_TIME" }
        secTS:Button("No Camera Shake", function()
            if not gateOK() then return end
            task.spawn(function()
                local okAll, n = true, 0
                for _, key in ipairs(TS_SHAKE) do
                    local list = entriesFor(key)
                    if #list == 0 then
                        okAll = false
                    else
                        for _, e in ipairs(list) do
                            local a = gcKey(e)
                            if a and tsOrig[a] == nil then tsOrig[a] = gcNum(e.value) end
                        end
                        if writeEntries(key, list, 0) then n = n + #list else okAll = false end
                    end
                end
                -- Repair a Frequency that has already been zeroed (by an earlier build, or by
                -- hand in a constant editor). Left at 0 it breaks the camera on the next throw.
                local fixed = 0
                for _, e in ipairs(entriesFor("FIRE_SHAKE_FREQUENCY")) do
                    if (gcNum(e.value) or 0) == 0 then
                        pcall(function() applygc({ e }, "FIRE_SHAKE_FREQUENCY", 12/100) end)
                        fixed = fixed + 1
                    end
                end
                notif("Thunderspears",
                    (okAll and ("Camera shake off (" .. n .. " values)")
                            or "Shake partly failed - throw a spear once, then retry")
                    .. (fixed > 0 and ("  |  repaired Frequency x" .. fixed) or ""), 4)
            end)
        end):Tooltip("Removes the camera kick when you throw. It is purely visual - the spear's direction comes from your body, so the shake never affected where it goes.")
        secTS:Button("Apply Thunderspears", function()
            if not gateOK() then return end
            task.spawn(function()
                local ts, why = tsResolve()
                if not ts then
                    notif("Thunderspears", "Failed - " .. tostring(why), 5)
                    return
                end
                -- spear-only subset of the shared inaccuracy key
                local list = {}
                for _, e in ipairs(entriesFor("BASE_INACCURACY_OFFSET")) do
                    local a = gcKey(e)
                    if a and ts[a] then
                        list[#list + 1] = e
                        if tsOrig[a] == nil then tsOrig[a] = gcNum(e.value) end
                    end
                end
                local okI, doneI = false, 0
                if #list > 0 then okI, doneI = writeEntries("BASE_INACCURACY_OFFSET", list, tsInacc) end
                -- the aim distance key is spear-exclusive, so every entry is ours
                local dist = entriesFor("INACCURACY_REFERENCE_DISTANCE")
                for _, e in ipairs(dist) do
                    local a = gcKey(e)
                    if a and tsOrig[a] == nil then tsOrig[a] = gcNum(e.value) end
                end
                local okD, doneD = writeEntries("INACCURACY_REFERENCE_DISTANCE", dist, tsDist)
                if okI and okD then
                    notif("Thunderspears", string.format("Spread %.1f | aim distance %d   cone ~%.1f deg (stock 8.5)",
                        tsInacc, tsDist, math.deg(math.atan(tsInacc / tsDist))), 4)
                else
                    notif("Thunderspears", string.format("Partial - spread %d/%d, distance %d/%d",
                        doneI, #list, doneD, #dist), 5)
                end
            end)
        end)
        secTS:Button("Restore Default", function()
            if not gateOK() then return end
            tsInacc, tsDist = 15, 100
            task.spawn(function()
                local n = 0
                for _, key in ipairs({ "BASE_INACCURACY_OFFSET", "INACCURACY_REFERENCE_DISTANCE",
                                       "FIRE_SHAKE_AMPLITUDE", "FIRE_SHAKE_ROTATION_INFLUENCE",
                                       "FIRE_SHAKE_SUSTAIN_TIME", "FIRE_SHAKE_FADE_OUT_TIME",
                                       "FIRE_SHAKE_FREQUENCY" }) do
                    -- BASE_INACCURACY_OFFSET is SHARED with every gun, so only addresses we
                    -- actually recorded may be touched. Every other key here is spear-exclusive,
                    -- so we can fall back to the known stock value — which is what lets this
                    -- repair constants zeroed outside the menu, Frequency above all.
                    local shared = (key == "BASE_INACCURACY_OFFSET")
                    for _, e in ipairs(entriesFor(key)) do
                        local o = tsOrig[gcKey(e)]
                        if o == nil and not shared then o = CFG[key] and CFG[key].fb end
                        if o ~= nil then
                            pcall(function() applygc({ e }, key, o) end)
                            n = n + 1
                        end
                    end
                end
                notif("Thunderspears", n > 0 and ("Restored " .. n .. " spear values (incl. camera shake)")
                    or "Nothing to restore - no writes recorded", 3)
            end)
        end)
    end)


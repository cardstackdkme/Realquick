-- The config file as a table ({} when there is none yet). nil + reason when it exists but cannot be
-- read, so a positions-only save never replaces a config it could not parse.
function GUI.ReadConfigFile()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return nil, "readfile not available" end
    local exists = false
    pcall(function() exists = isfile(CONFIG_PATH) end)
    if not exists then return {} end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_PATH)) end)
    if not (ok and type(data) == "table") then return nil, "the saved config could not be read" end
    return data

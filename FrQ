-- Read a player's health and max-health by name. Returns (hp, maxHp).
-- Defaults: hp=100, maxHp=100. Tries attributes/NumberValues first, then Humanoid.
local function ReadPlayerHealth(playerName)
    local hp = 100
    local maxHp = 100
    local sawMax = false
    pcall(function()
        local p = game:GetService("Players"):FindFirstChild(playerName)
        if p then
            pcall(function()
                local h = p:GetAttribute("Health")
                if h then hp = tonumber(h) or hp end
                local m = p:GetAttribute("Maximum health")
                if not m then m = p:GetAttribute("MaxHealth") end
                if not m then m = p:GetAttribute("MaximumHealth") end
                if m then maxHp = tonumber(m) or maxHp; sawMax = true end
            end)
            pcall(function()
                for _, child in pairs(p:GetChildren()) do
                    if child.Name == "Health" then
                        hp = tonumber(child.Value) or hp
                    elseif child.Name == "MaxHealth" or child.Name == "Maximum health" or child.Name == "MaximumHealth" then
                        maxHp = tonumber(child.Value) or maxHp
                        sawMax = true
                    end
                end
            end)
            if not sawMax then
                pcall(function()
                    local char = p.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            local m = tonumber(hum.MaxHealth)
                            if m and m > 0 then maxHp = m; sawMax = true end
                            -- Humanoid.Health is authoritative when present
                            local h = tonumber(hum.Health)
                            if h then hp = h end
                        end
                    end
                end)
            end
        end
    end)
    -- If we never found a max, assume max is at least the current hp (so a
    -- buffed player at 145 still reads as 100% instead of being stuck).
    if not sawMax then maxHp = math.max(100, hp) end
    if maxHp <= 0 then maxHp = 100 end
    if hp < 0 then hp = 0 end
    if hp > maxHp then hp = maxHp end
    return hp, maxHp
end

-- Generic health bar drawing (reused for self and monitors)
local function DrawHealthBarWidget(px, py, pw, ph, playerName, hp, maxHp, zb, elemTable)
    maxHp = (maxHp and maxHp > 0) and maxHp or 100
    local hpFrac = math.max(0, math.min(1, hp / maxHp))
    local pctNum = math.floor(hpFrac * 100 + 0.5)
    local hpColor = GetHealthColor(pctNum)
    local C3c = Color3.fromRGB
    local function add(o) o.Visible = true; table.insert(elemTable, o); return o end
    local function sq(x, y, w, h, col, z, a, cn, fl, th)
        local s = Drawing.new("Square"); s.Position = Vector2.new(x, y); s.Size = Vector2.new(w, h)
        s.Color = col; s.Filled = fl ~= false; s.Corner = cn or 0; if th then s.Thickness = th end
        s.Transparency = a or 1; s.ZIndex = z; return add(s)
    end
    local function tx(str, x, y, sz, col, z, font)
        local t = Drawing.new("Text"); t.Position = Vector2.new(x, y); t.Text = tostring(str)
        t.Size = sz; t.Color = col; t.Font = font or Drawing.Fonts.System; t.Center = false
        t.Outline = false; t.ZIndex = z; return add(t)
    end
    -- drop shadow, rounded body, hairline edge
    sq(px + 4, py + 6, pw, ph, C3c(0, 0, 0), zb - 1, 0.16, 8)
    sq(px, py, pw, ph, C3c(15, 15, 19), zb, 0.93, 8)
    sq(px, py, pw, ph, C3c(255, 255, 255), zb + 1, 0.10, 8, false, 1)
    -- health-coloured accent strip on the left edge
    local elAccent = sq(px, py + 7, 3, ph - 14, hpColor, zb + 2, 0.9, 2)
    -- name
    tx(playerName, px + 14, py + 7, 15, C3c(228, 228, 234), zb + 4, Drawing.Fonts.SystemBold)
    -- percent + hp numbers, right-aligned
    local pctStr = tostring(pctNum) .. "%"
    local elPct = tx(pctStr, px + pw - 12 - #pctStr * 8, py + 7, 14, hpColor, zb + 4, Drawing.Fonts.SystemBold)
    local hpStr = math.floor(hp + 0.5) .. " / " .. math.floor(maxHp + 0.5)
    local elNum = tx(hpStr, px + pw - 18 - #pctStr * 8 - #hpStr * 7, py + 8, 12, C3c(150, 150, 158), zb + 4, Drawing.Fonts.Monospace)
    -- bar: taller, rounded, with a subtle top highlight
    local barX, barY, barW, barH = px + 14, py + ph - 13, pw - 28, 8
    sq(barX, barY, barW, barH, C3c(30, 30, 36), zb + 2, 0.9, 3)
    local fw = math.max(3, math.floor(barW * hpFrac))
    local elFill = sq(barX, barY, fw, barH, hpColor, zb + 3, 0.96, 3)
    local elHl = sq(barX + 1, barY + 1, math.max(1, fw - 2), 2, C3c(255, 255, 255), zb + 4, 0.22, 2)
    -- Handle to the elements whose VALUES change, so a caller can refresh the numbers in place
    -- instead of destroying and rebuilding the widget. Existing callers ignore the return value.
    return { accent = elAccent, pct = elPct, num = elNum, fill = elFill, hl = elHl, label = playerName }
end

-- Refresh a widget's numbers WITHOUT recreating any Drawing object.
-- ⚠ THIS IS THE FIX FOR THE FLASHING. Rebuilding meant Remove()ing every element and constructing
-- new ones; the Drawing layer renders on its own loop, so any frame landing between the destroy and
-- the recreate drew nothing at all — a blink on every refresh. Mutating the existing objects has no
-- such window, and is far cheaper besides.
-- px/pw are passed in rather than captured, because dragging moves the widget after it was built.
local function UpdateBarWidget(h, val, maxVal, px, py, pw)
    if not h then return end
    maxVal = (maxVal and maxVal > 0) and maxVal or 100
    local frac = math.max(0, math.min(1, val / maxVal))
    local pctNum = math.floor(frac * 100 + 0.5)
    local col = GetHealthColor(pctNum)
    local pctStr = tostring(pctNum) .. "%"
    local numStr = math.floor(val + 0.5) .. " / " .. math.floor(maxVal + 0.5)
    pcall(function()
        h.accent.Color = col
        h.pct.Text = pctStr
        h.pct.Color = col
        h.pct.Position = Vector2.new(px + pw - 12 - #pctStr * 8, py + 7)
        h.num.Text = numStr
        -- right-aligned, so its X depends on BOTH strings' lengths and must be recomputed
        h.num.Position = Vector2.new(px + pw - 18 - #pctStr * 8 - #numStr * 7, py + 8)
        local barW = pw - 28
        local fw = math.max(3, math.floor(barW * frac))
        h.fill.Size = Vector2.new(fw, 8)
        h.fill.Color = col
        h.hl.Size = Vector2.new(math.max(1, fw - 2), 2)
    end)
end

ClearGasBar = function()
    for _, el in ipairs(GUI.GasBarElements) do
        pcall(function() el:Remove() end)
    end
    GUI.GasBarElements = {}
    GUI.GasBarHandle = nil   -- the handle points at removed objects; never reuse it
end

-- ============================================================
-- SLIM HUD BARS (v8.5): personal health + ODM gas
-- Text sits INSIDE the bar, centred on its middle line (Matcha's Text.Center centres vertically
-- too), white with a thin outline, on a black track. Health fills red/orange/green or a gradient;
-- gas fills with a gradient. Gradients are 2-5 colour stops, empty end first (Style -> Gradient
-- Editor). Size, text and the rest are per bar in GUI.BarStyle (Style tab). Drag either bar; the
-- spot is saved with the config. Values refresh IN PLACE, so the bars never blink.
-- Everything lives in this do-block: the main chunk is near Luau's 200-local limit.
-- ============================================================
do
    local SLICE = 2                           -- gradient strip width (px): narrow = smooth
    local FONT = Drawing.Fonts.SystemBold     -- the health bar's font, used for both bars
    local C3 = Color3.fromRGB
    GUI.SlimLabelH = 0                        -- the text is inside the bar (the drag code reads this)

    -- Per-bar look. Width/height live in GUI.<Bar>W/H (the drag code uses them); the rest here.
    GUI.BarStyle = GUI.BarStyle or {
        hp  = { text = 12, pct = true, nums = true, track = 100, border = true, fill = "Health Colors" },
        gas = { text = 12, pct = true, nums = true, track = 100, border = true,
                flash = true, flashFor = 3, flashColor = { 255, 30, 30 } },
    }
    -- Gradient stops {r,g,b}, empty end FIRST. Presets: the built-ins plus any you save (config).
    GUI.Grad = GUI.Grad or {
        gas = { { 45, 125, 255 }, { 170, 80, 255 } },
        hp  = { { 225, 70, 60 }, { 245, 150, 45 }, { 90, 200, 120 } },
        presets = {},
    }

    -- "Health Colors" fill: 0-33% red, 34-66% orange, 67-100% green. Banded on the same rounded
    -- percent the label prints, so the colour can never disagree with the number next to it.
    local function barColor(frac)
        local p = math.floor(frac * 100 + 0.5)
        if p >= 67 then return C3(90, 200, 120) end
        if p >= 34 then return C3(245, 150, 45) end
        return C3(225, 70, 60)
    end

    -- Colour at t (0 = empty end, 1 = full end) along 2-5 stops, blended in LINEAR light (gamma
    -- 2.2): a raw sRGB blend sags dull between stops, a linear-light one keeps every strip equally
    -- bright, so the sweep reads smooth and even. Returns r, g, b (0-255). Shared with the editor.
    local function lin(c) return (c / 255) ^ 2.2 end
    GUI.GradAt = function(stops, t)
        local n = type(stops) == "table" and #stops or 0
        if n == 0 then return 255, 255, 255 end
        if n == 1 then return stops[1][1], stops[1][2], stops[1][3] end
        local x = math.max(0, math.min(1, t)) * (n - 1)
        local i = math.min(n - 2, math.floor(x))
        local u, a, b = x - i, stops[i + 1], stops[i + 2]
        local o = {}
        for k = 1, 3 do
            local l = lin(a[k]) + (lin(b[k]) - lin(a[k])) * u
            o[k] = math.floor(255 * l ^ (1 / 2.2) + 0.5)
        end
        return o[1], o[2], o[3]
    end

    -- First build with no saved spot: gas centred above the hotbar, health to its left.
    local function defaultPos(which, w)
        local vp = nil
        pcall(function() vp = Workspace.CurrentCamera.ViewportSize end)
        local vx, vy = vp and vp.X or 1920, vp and vp.Y or 1080
        local y = math.floor(vy - 150)
        if which == "gas" then return math.floor((vx - w) / 2), y end
        return math.floor(vx / 2 - w - 190), y
    end

    local function usesGradient(which)
        return which == "gas" or GUI.BarStyle.hp.fill == "Gradient"
    end

    -- Gradient fills are rows of SLICE-wide strips, each its own colour (Drawing has no gradient
    -- fill). They are positioned once here; dragging moves them with everything else.
    local function draw(px, py, pw, ph, elems, which)
        local st = GUI.BarStyle[which]
        local function add(o) o.Visible = true; elems[#elems + 1] = o; return o end
        local function sq(col, z, filled, a, corner)
            local s = Drawing.new("Square")
            s.Color = col; s.Filled = filled; s.Transparency = a; s.ZIndex = z
            s.Corner = corner or 4; s.Thickness = 1
            return add(s)
        end
        local h = { which = which }
        h.bg = sq(C3(0, 0, 0), 55, true, math.max(0, math.min(1, (st.track or 100) / 100)))
        h.bg.Position, h.bg.Size = Vector2.new(px, py), Vector2.new(pw, ph)
        local iw = pw - 4
        if usesGradient(which) then
            h.slices, h.sliceH = {}, math.max(1, ph - 4)
            local n = math.ceil(iw / SLICE)
            local stops = GUI.Grad[which]
            for i = 1, n do
                local r, g, b = GUI.GradAt(stops, (i - 0.5) / n)
                local s = sq(C3(r, g, b), 56, true, 1, 0)
                s.Position = Vector2.new(px + 2 + (i - 1) * SLICE, py + 2)
                s.Size = Vector2.new(SLICE, h.sliceH)
                s.Visible = false
                h.slices[i] = { o = s, vis = false, w = SLICE, x0 = (i - 1) * SLICE }
            end
        else
            h.fill = sq(C3(90, 200, 120), 56, true, 1, 3)
            h.fill.Position, h.fill.Size = Vector2.new(px + 2, py + 2), Vector2.new(0, math.max(1, ph - 4))
        end
        h.border = sq(C3(60, 60, 66), 57, false, 1)
        h.border.Position, h.border.Size = Vector2.new(px, py), Vector2.new(pw, ph)
        if st.border == false then h.border.Visible = false end
        local t = Drawing.new("Text")
        t.Size = st.text or 12; t.Outline = true; t.Center = true; t.ZIndex = 58
        t.Color = C3(255, 255, 255); t.Font = FONT; t.Text = ""
        h.label = add(t)
        h.label.Position = Vector2.new(px + math.floor(pw / 2), py + math.floor(ph / 2))
        return h
    end

    -- Recolour a gradient bar in place (the editor calls this on every change).
    local function recolor(h)
        if not (h and h.slices) then return end
        local n, stops = #h.slices, GUI.Grad[h.which]
        for i, s in ipairs(h.slices) do
            local r, g, b = GUI.GradAt(stops, (i - 0.5) / n)
            pcall(function() s.o.Color = C3(r, g, b) end)
        end
    end
    GUI.RecolorBars = function()
        recolor(GUI.GasBarHandle)
        recolor(GUI.HealthBarHandle)
    end

    -- Show `fw` px of gradient: touch only the strips whose state changes, so a draining bar costs
    -- one or two property writes per refresh instead of ~120.
    local function showSlices(h, fw)
        for _, s in ipairs(h.slices) do
            local w = math.max(0, math.min(SLICE, fw - s.x0))
            local vis = w > 0
            if vis ~= s.vis then s.vis = vis; s.o.Visible = vis end
            if vis and w ~= s.w then s.w = w; s.o.Size = Vector2.new(w, h.sliceH) end
        end
    end

    local function labelText(title, st, frac, val, m)
        local parts = { title }
        if st.pct ~= false then parts[#parts + 1] = string.format("%d%%", math.floor(frac * 100 + 0.5)) end
        if st.nums ~= false then parts[#parts + 1] = string.format("%d / %d", math.floor(val + 0.5), math.floor(m + 0.5)) end
        return table.concat(parts, "   ")
    end

    -- `status` replaces the whole text (no title, no numbers) and empties the bar.
    local function update(h, title, val, maxVal, px, py, pw, ph, status)
        if not h then return end
        pcall(function()
            if status then
                if h.slices then showSlices(h, 0) else h.fill.Visible = false end
                h.label.Text = status
                return
            end
            local st = GUI.BarStyle[h.which]
            local inf = (maxVal == math.huge)
            local m = (maxVal and maxVal > 0) and maxVal or 100
            local frac = inf and 1 or math.max(0, math.min(1, val / m))
            local fw = math.floor((pw - 4) * frac + 0.5)
            if h.slices then
                showSlices(h, fw)
            else
                h.fill.Position, h.fill.Size = Vector2.new(px + 2, py + 2), Vector2.new(fw, math.max(1, ph - 4))
                h.fill.Color = barColor(frac)
                h.fill.Visible = fw > 0
            end
            h.label.Text = inf and (title .. "  INF") or labelText(title, st, frac, val, m)
        end)
    end

    -- Style tab: change one setting and rebuild that bar (positions are kept).
    GUI.SetBarStyle = function(which, key, value)
        local st = GUI.BarStyle[which]
        if not st then return end
        if key == "w" or key == "h" then
            local pre = which == "hp" and "HealthBar" or "GasBar"
            GUI[pre .. (key == "w" and "W" or "H")] = value
        else
            st[key] = value
        end
        if which == "hp" then BuildHealthBar() else BuildGasBar() end
    end

    -- ---------- health ----------
    BuildHealthBar = function()
        ClearHealthBar()
        if not GUI.HealthBarVisible then return end
        if GUI.HealthBarX == nil or GUI.HealthBarY == nil then
            GUI.HealthBarX, GUI.HealthBarY = defaultPos("hp", GUI.HealthBarW)
        end
        GUI.HealthBarHandle = draw(GUI.HealthBarX, GUI.HealthBarY, GUI.HealthBarW, GUI.HealthBarH,
            GUI.HealthBarElements, "hp")
        GUI.UpdateHealthBar()
    end
    GUI.UpdateHealthBar = function()
        local h = GUI.HealthBarHandle
        if not (GUI.HealthBarVisible and h) then return end
        local hp, maxHp = ReadPlayerHealth(LocalPlayer.Name)
        update(h, "HP", hp, maxHp, GUI.HealthBarX, GUI.HealthBarY, GUI.HealthBarW, GUI.HealthBarH)
    end

    -- ---------- ODM gear gas ----------
    -- The gas the check-gas monologue reports lives in ClientGearHandler's gear state table, rebuilt
    -- on every equip/respawn: { gas = <left>, maxGas = 800, gasConsumption = 6,
    -- gasBoostingConsumption = 12, ... } (live 2026-11-09). Found by a getgc, then the two numbers are
    -- read straight from memory. (The gaspack's Amount/MaxAmount attributes are a different tank.)
    --
    -- ⚠ THE GAS BAR NEVER RUNS getgc ITSELF. One sweep = 10+ s with Matcha frozen (v8.2 swept on
    -- load and Windows closed Matcha as not responding). It is fed by sweeps you start:
    --   * Character -> Load Values: warm() adds the three gas keys to its ONE sweep and hands the raw
    --     entries to GUI.GasFromSweep (no second freeze);
    --   * Character -> Reload Gas: a gas-only sweep, for after a respawn rebuilt the table.
    -- Found slots ride on _G keyed by JobId, so re-running the script in the same server keeps them.
    local NODE_SPAN = 2048   -- a 64-slot hash part (32-byte slots): every field of the table is inside
    GUI.GasSweepKeys = { "gasBoostingConsumption", "maxGas", "gas" }
    -- status nil = derive it (Load Values first / Reload Gas); a string = say exactly that
    local ODM = { cands = {}, char = nil, prev = nil, status = nil }
    GUI.ODMGas = ODM

    local function num(kind, a)
        local ok, v = pcall(memory_read, kind, a)
        if ok and type(v) == "number" and v == v then return v end
        return nil
    end
    local function addrOf(e)
        local a = e and e.addr
        if type(a) == "number" then return a end
        if type(a) == "string" then return tonumber(a) or tonumber((a:gsub("^0[xX]", "")), 16) end
        return nil
    end
    -- A slot is [value 8][extra 4][type tag 4][key pointer 8 ...]. It still holds its field while
    -- the tag says number (3) and the key pointer is the one seen at sweep time.
    local function slotOf(e)
        local a = addrOf(e)
        if not a then return nil end
        local k = num("uint64", a + 16)
        if not k or k == 0 then return nil end
        return { a = a, key = k }
    end
    local function slotOK(s)
        return num("int", s.a + 12) == 3 and num("uint64", s.a + 16) == s.key
    end

    local function jobId()
        local j = ""
        pcall(function() j = tostring(game.JobId or "") end)
        return j
    end
    -- a re-run in the same server: reuse the slots found last time (checked by slotOK every read)
    do
        local saved = _G.RQGasSlots
        if type(saved) == "table" and saved.job == jobId() and type(saved.cands) == "table" then
            ODM.cands = saved.cands
        end
    end

    -- Every live gear table in a sweep's entries: a numeric gasBoostingConsumption with exactly one
    -- numeric gas and one numeric maxGas in the same hash part. Function-constant look-alikes never
    -- have all three. Called by the Character tab's sweeps; never sweeps by itself.
    GUI.GasFromSweep = function(entries)
        if type(entries) ~= "table" then return 0 end
        local by = { gasBoostingConsumption = {}, maxGas = {}, gas = {} }
        for _, e in pairs(entries) do
            if type(e) == "table" and e.type == "number" and by[e.key] then
                local a = addrOf(e)
                if a then table.insert(by[e.key], { e = e, a = a }) end
            end
        end
        local found = {}
        for _, anchor in ipairs(by.gasBoostingConsumption) do
            local gE, mE, nG, nM = nil, nil, 0, 0
            for _, r in ipairs(by.gas) do
                if math.abs(r.a - anchor.a) < NODE_SPAN then gE = r.e; nG = nG + 1 end
            end
            for _, r in ipairs(by.maxGas) do
                if math.abs(r.a - anchor.a) < NODE_SPAN then mE = r.e; nM = nM + 1 end
            end
            if nG == 1 and nM == 1 then
                local g, m = slotOf(gE), slotOf(mE)
                -- `last` starts at the value seen now, so the very next change already counts
                if g and m then found[#found + 1] = { gas = g, max = m, last = num("double", g.a), changed = 0 } end
            end
        end
        if ODM.active then ODM.prev = ODM.active.gas.a end
        ODM.cands, ODM.active = found, nil
        ODM.status = (#found == 0) and "No gear - Reload Gas" or nil
        _G.RQGasSlots = { job = jobId(), cands = found }
        return #found
    end

    local function charAddr()
        local a = nil
        pcall(function()
            local c = LocalPlayer.Character
            a = c and tostring(c.Address) or nil
        end)
        return a
    end

    -- After a respawn the old gear table can linger until Lua frees it, holding its last number.
    -- Several candidates: show the one whose gas moved most recently; while none has moved, prefer
    -- one that is not the table shown before (the newer one).
    local function pick()
        local best = nil
        for _, c in ipairs(ODM.cands) do
            if not best or c.changed > best.changed
               or (c.changed == best.changed and best.gas.a == ODM.prev and c.gas.a ~= ODM.prev) then
                best = c
            end
        end
        return best
    end

    local function idleText()
        if ODM.status then return ODM.status end
        if GUI.CharIsLoaded and GUI.CharIsLoaded() then return "Reload Gas in Character" end
        return "Load Values first"
    end

    -- (gas, maxGas), or (nil, text). Memory reads only: this never sweeps.
    local function readODM()
        if type(memory_read) ~= "function" then return nil, "unavailable" end
        local now = os.clock()
        local ch = charAddr()
        if ch ~= ODM.char then
            local first = not ODM.charSeen
            ODM.charSeen = true
            ODM.char = ch
            if not first and #ODM.cands > 0 then   -- respawned: the gear table is rebuilt
                if ODM.active then ODM.prev = ODM.active.gas.a end
                ODM.cands, ODM.active = {}, nil
                ODM.status = "Reload Gas in Character"
            end
        end
        local had = #ODM.cands > 0
        local keep = {}
        for _, c in ipairs(ODM.cands) do
            if slotOK(c.gas) and slotOK(c.max) then
                local v = num("double", c.gas.a)
                if v and c.last and v ~= c.last then c.changed = now end
                c.last = v
                keep[#keep + 1] = c
            end
        end
        ODM.cands = keep
        if had and #keep == 0 then ODM.status = "Reload Gas in Character" end   -- table freed
        if #keep == 0 then return nil, idleText() end
        ODM.active = pick()
        local c = ODM.active
        if not c then return nil, idleText() end
        local g, m = num("double", c.gas.a), num("double", c.max.a)
        if g and m and m > 0 then return g, m end
        return nil, "--"
    end

    BuildGasBar = function()
        ClearGasBar()
        if not GUI.GasBarVisible then return end
        if GUI.GasBarX == nil or GUI.GasBarY == nil then
            GUI.GasBarX, GUI.GasBarY = defaultPos("gas", GUI.GasBarW)
        end
        GUI.GasBarHandle = draw(GUI.GasBarX, GUI.GasBarY, GUI.GasBarW, GUI.GasBarH, GUI.GasBarElements, "gas")
        UpdateGasBar()
    end
    -- Emergency gas: the moment gas drops under 15% the bar flashes the Style colour twice a second
    -- for BarStyle.gas.flashFor seconds, then shows normally. Going back above 15% re-arms it. The
    -- drop time is on GUI, so a Style change that rebuilds the bar does not restart the flash.
    -- Only writes on a flash edge.
    GUI.FlashGas = function(h, frac)
        local st, now = GUI.BarStyle.gas, os.clock()
        if st.flash ~= false and frac and frac < 0.15 then GUI._gasLowAt = GUI._gasLowAt or now else GUI._gasLowAt = nil end
        local t = GUI._gasLowAt and now - GUI._gasLowAt
        local on = t ~= nil and t < (st.flashFor or 3) and math.floor(t * 4) % 2 == 0
        if on == (h.flashOn == true) then return end
        h.flashOn = on
        local c = st.flashColor or { 255, 30, 30 }
        local col = C3(c[1], c[2], c[3])
        if h.slices then
            if on then
                for _, s in ipairs(h.slices) do pcall(function() s.o.Color = col end) end
            else
                recolor(h)
            end
        elseif h.fill and on then
            pcall(function() h.fill.Color = col end)   -- off: update() repaints it
        end
        pcall(function() h.border.Color = on and col or C3(60, 60, 66) end)
    end
    UpdateGasBar = function()
        local h = GUI.GasBarHandle
        if not (GUI.GasBarVisible and h) then return end
        local g, m = readODM()
        if g then
            update(h, "GAS", g, m, GUI.GasBarX, GUI.GasBarY, GUI.GasBarW, GUI.GasBarH)
            GUI.FlashGas(h, (m and m > 0) and g / m or nil)
        else
            update(h, "GAS", 0, 1, GUI.GasBarX, GUI.GasBarY, GUI.GasBarW, GUI.GasBarH, m)
            GUI.FlashGas(h, nil)
        end
    end
end

-- Clear a single monitor bar
local function ClearMonitorBar(name)
    local bar = GUI.MonitorBars[name]
    if bar then
        for _, el in ipairs(bar.elements) do
            pcall(function() el:Remove() end)
        end
        GUI.MonitorBars[name] = nil
    end
end

-- Clear all monitor bars
ClearAllMonitorBars = function()
    for name, _ in pairs(GUI.MonitorBars) do
        ClearMonitorBar(name)
    end
end

-- Build/rebuild a single monitor bar
local function BuildMonitorBar(playerName)
    local bar = GUI.MonitorBars[playerName]
    if not bar then return end
    -- Clear old elements
    for _, el in ipairs(bar.elements) do
        pcall(function() el:Remove() end)
    end
    bar.elements = {}
    local hp, maxHp = ReadPlayerHealth(playerName)
    DrawHealthBarWidget(bar.x, bar.y, bar.w, bar.h, playerName, hp, maxHp, 56, bar.elements)
end

-- Rebuild all active monitor bars
RefreshAllMonitorBars = function()
    for name, _ in pairs(GUI.MonitorBars) do
        BuildMonitorBar(name)
    end
end

-- Toggle monitoring for a player
ToggleMonitorBar = function(playerName)
    if GUI.MonitorBars[playerName] then
        ClearMonitorBar(playerName)
    else
        -- Stack new bars below existing ones
        local baseY = 350
        for _, bar in pairs(GUI.MonitorBars) do
            if bar.y + bar.h + 6 > baseY then
                baseY = bar.y + bar.h + 6
            end
        end
        GUI.MonitorBars[playerName] = {
            elements = {},
            x = 20, y = baseY,
            w = 260, h = 40,
            dragging = false, dragOX = 0, dragOY = 0,
        }
        BuildMonitorBar(playerName)
    end
end

-- ============================================================
-- DAMAGE INDICATOR ENGINE
-- ============================================================

local function DmgIndicatorLoop()
    local playerCache = nil
    local playerCacheTimer = 999
    local healthSrcCache = {}  -- [playerName] = { child = instance|false, expires = tick }
    while GUI.Running do
        if not GUI.DmgIndicatorEnabled then
            -- Idle: clean up and wait
            if #GUI.DmgIndicatorFloaters > 0 then
                for _, f in ipairs(GUI.DmgIndicatorFloaters) do
                    for _, el in ipairs(f.elements) do
                        pcall(function() el:Remove() end)
                    end
                end
                GUI.DmgIndicatorFloaters = {}
            end
            GUI.DmgIndicatorPrevHP = {}
            playerCache = nil
            playerCacheTimer = 999
            healthSrcCache = {}
            wait(0.5)
        else
            local ok, err = pcall(function()
                -- Get my position (same pattern as ESP code)
                local playerPos = getPlayerPos()
                if not playerPos then return end
                local radius = GUI.DmgIndicatorRadius

                -- Refresh player list every ~1s instead of every 30ms tick
                playerCacheTimer = playerCacheTimer + 1
                if not playerCache or playerCacheTimer >= 33 then
                    playerCache = Players:GetPlayers()
                    playerCacheTimer = 0
                    -- Drop stale Health child refs for players no longer present
                    local alive = {}
                    for _, p in pairs(playerCache) do
                        pcall(function() alive[p.Name] = true end)
                    end
                    for n, _ in pairs(healthSrcCache) do
                        if not alive[n] then healthSrcCache[n] = nil end
                    end
                end

                local now = tick()
                for _, player in pairs(playerCache) do
                    pcall(function()
                        if player == LocalPlayer or player.Name == LocalPlayer.Name then return end
                        local name = player.Name

                        -- Read health from attributes (nil = 100, same as playerlist)
                        local hp = 100
                        pcall(function()
                            local h = player:GetAttribute("Health")
                            if h then hp = tonumber(h) or 100 end
                        end)

                        -- Resolve "Health" child once per second per player; reuse the ref every tick
                        local hsc = healthSrcCache[name]
                        if not hsc or now > hsc.expires then
                            local found = false
                            pcall(function()
                                for _, child in pairs(player:GetChildren()) do
                                    if child.Name == "Health" then found = child; break end
                                end
                            end)
                            hsc = { child = found, expires = now + 1 }
                            healthSrcCache[name] = hsc
                        end
                        if hsc.child then
                            pcall(function()
                                local v = hsc.child.Value
                                if v then hp = tonumber(v) or hp end
                            end)
                        end

                        local prevHP = GUI.DmgIndicatorPrevHP[name]
                        GUI.DmgIndicatorPrevHP[name] = hp

                        -- Detect health drop
                        if prevHP and hp < prevHP then
                            local dmg = math.floor(prevHP - hp)
                            if dmg <= 0 then return end

                            -- Distance check using character HRP (same pattern as ESP)
                            local char = nil
                            pcall(function() char = player.Character end)
                            if not char then return end
                            local hrp = char:FindFirstChild("HumanoidRootPart")
                            if not hrp then return end

                            local pos = hrp.Position
                            local dx = playerPos.X - pos.X
                            local dy = playerPos.Y - pos.Y
                            local dz = playerPos.Z - pos.Z
                            local dist = math.sqrt(dx*dx + dy*dy + dz*dz)

                            if dist > radius then return end


                            -- Get screen position
                            local screenPos, onScreen = WorldToScreen(pos + Vector3.new(0, 3, 0))
                            if not screenPos or not onScreen then return end

                            local isKill = hp <= 0

                            -- Stack offset: count active floaters to push new ones up
                            local stackOffset = #GUI.DmgIndicatorFloaters * 80

                            -- Clamp to screen bounds (leave margin for text)
                            local cx = math.max(120, math.min(screenPos.X, 2560 - 120))
                            local baseY = math.max(30, math.min(screenPos.Y - 50 - stackOffset, 1440 - 100))
                            local nameY = baseY
                            local lineY = baseY + 26
                            local dmgY = baseY + 40
                            local killY = baseY + 62

                            -- Player name (slides from right)
                            local nameText = Drawing.new("Text")
                            nameText.Position = Vector2.new(cx + 200, nameY)
                            nameText.Text = name
                            nameText.Color = Color3.fromRGB(255, 255, 255)
                            nameText.Size = 23
                            nameText.Font = Drawing.Fonts.SystemBold
                            nameText.Center = true
                            nameText.Outline = true
                            nameText.Visible = true
                            nameText.ZIndex = 58

                            -- Separator line
                            local sepLine = Drawing.new("Line")
                            sepLine.From = Vector2.new(cx - 80, lineY)
                            sepLine.To = Vector2.new(cx + 80, lineY)
                            sepLine.Color = Color3.fromRGB(220, 75, 75)
                            sepLine.Thickness = 1
                            sepLine.Visible = true
                            sepLine.ZIndex = 58

                            -- "X Damage Dealt" on one line (number red, text white)
                            local dmgText = Drawing.new("Text")
                            dmgText.Position = Vector2.new(cx - 200, dmgY)
                            dmgText.Text = tostring(dmg) .. " Damage Dealt"
                            dmgText.Color = Color3.fromRGB(220, 75, 75)
                            dmgText.Size = 18
                            dmgText.Font = Drawing.Fonts.System
                            dmgText.Center = true
                            dmgText.Outline = true
                            dmgText.Visible = true
                            dmgText.ZIndex = 58

                            -- Kill text
                            local killText = nil
                            if isKill then
                                killText = Drawing.new("Text")
                                killText.Position = Vector2.new(cx, killY)
                                killText.Text = "KILLED"
                                killText.Color = Color3.fromRGB(255, 60, 60)
                                killText.Size = 18
                                killText.Font = Drawing.Fonts.SystemBold
                                killText.Center = true
                                killText.Outline = true
                                killText.Visible = true
                                killText.ZIndex = 58
                            end

                            local floater = {
                                created = tick(),
                                cx = cx,
                                nameY = nameY,
                                dmgY = dmgY,
                                nameText = nameText,
                                sepLine = sepLine,
                                dmgText = dmgText,
                                killText = killText,
                                elements = {nameText, sepLine, dmgText},
                            }
                            if killText then table.insert(floater.elements, killText) end

                            table.insert(GUI.DmgIndicatorFloaters, floater)
                        end
                    end)
                end

                -- Animate and clean up floaters
                local now = tick()
                local alive = {}
                for _, f in ipairs(GUI.DmgIndicatorFloaters) do
                    local age = now - f.created
                    if age < 2.5 then
                        -- Slide animation (first 0.3s)
                        local slideT = math.min(1, age / 0.3)
                        local ease = 1 - (1 - slideT) * (1 - slideT) * (1 - slideT)

                        -- Name slides from right to center
                        local nameX = f.cx + 200 * (1 - ease)
                        pcall(function()
                            f.nameText.Position = Vector2.new(nameX, f.nameY)
                        end)

                        -- Damage slides from left to center
                        local dmgX = f.cx - 200 * (1 - ease)
                        pcall(function()
                            f.dmgText.Position = Vector2.new(dmgX, f.dmgY)
                        end)

                        -- Fade out last 0.6s
                        if age > 1.9 then
                            local alpha = (age - 1.9) / 0.6
                            for _, el in ipairs(f.elements) do
                                pcall(function() el.Transparency = alpha end)
                            end
                        end

                        table.insert(alive, f)
                    else
                        for _, el in ipairs(f.elements) do
                            pcall(function() el:Remove() end)
                        end
                    end
                end
                GUI.DmgIndicatorFloaters = alive
            end)
            wait(0.03)
        end
    end
end


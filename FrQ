-- File-local rarity table + helpers, used by both the fetch and the lazy
-- card-click description loader.
local ENCHANT_RARITY_NAMES = {
    Mythical = true, Mythic = true, Legendary = true, Epic = true,
    Rare = true, Uncommon = true, Common = true, Unique = true,
}

local function enchantRarityFromAncestors(inst)
    local node = nil
    pcall(function() node = inst.Parent end)
    for _ = 1, 6 do
        if not node then break end
        local nm = nil
        pcall(function() nm = node.Name end)
        if nm and ENCHANT_RARITY_NAMES[nm] then
            if nm == "Mythic" then return "Mythical" end
            return nm
        end
        local nextNode = nil
        pcall(function() nextNode = node.Parent end)
        node = nextNode
    end
    return nil
end

local function enchantDescriptionFromSource(src)
    if not src or src == "" then return nil end
    -- Try a bunch of common field names, in priority order. Long-bracket
    -- strings ([[...]]) come first within each field so multi-line
    -- descriptions win over short quoted strings elsewhere in the file.
    local fields = {
        "Description", "description",
        "Desc", "desc",
        "Effect", "effect",
        "Tooltip", "tooltip",
        "Info", "info",
        "Body", "body",
        "Text", "text",
    }
    for _, f in ipairs(fields) do
        local d = src:match(f .. "%s*=%s*%[%[(.-)%]%]")
            or src:match('%["' .. f .. '"%]%s*=%s*%[%[(.-)%]%]')
            or src:match("%['" .. f .. "'%]%s*=%s*%[%[(.-)%]%]")
            or src:match(f .. '%s*=%s*"([^"]*)"')
            or src:match(f .. "%s*=%s*'([^']*)'")
            or src:match('%["' .. f .. '"%]%s*=%s*"([^"]*)"')
            or src:match("%['" .. f .. "'%]%s*=%s*'([^']*)'")
        if d and #d > 0 then return d end
    end
    -- Last-resort fallback: pick the longest plausible string in the source.
    -- Most enchant modules have at most one long human-readable string, so
    -- this catches modules with non-standard field names.
    local best = nil
    for s in src:gmatch("%[%[(.-)%]%]") do
        if #s >= 30 and #s <= 600 and (not best or #s > #best) then best = s end
    end
    if not best then
        for s in src:gmatch('"([^"]+)"') do
            if #s >= 30 and #s <= 600 and not s:find("\\") and not s:find("/") then
                if not best or #s > #best then best = s end
            end
        end
    end
    return best
end

local function enchantRarityFromSource(src)
    if not src or src == "" then return nil end
    local r = src:match('[Rr]arity%s*=%s*"([^"]+)"')
        or src:match("[Rr]arity%s*=%s*'([^']+)'")
        or src:match('%["[Rr]arity"%]%s*=%s*"([^"]+)"')
    if r and ENCHANT_RARITY_NAMES[r] then
        if r == "Mythic" then return "Mythical" end
        return r
    end
    return nil
end

-- Walks ReplicatedStorage.Client.Progression.Enchantments.Enchantments and
-- builds { [name] = { rarity, description = nil, module = ModuleScript } }.
-- Rarity comes from the ancestor folder name; descriptions are fetched lazily
-- on card click (decompile() in a tight loop hangs the VM and looked like a
-- crash on first open). Yields every few items to keep the VM responsive.
FetchEnchantData = function()
    local data = {}

    local ok, err = pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local node = rs:FindFirstChild("Client")
        if node then node = node:FindFirstChild("Progression") end
        if node then node = node:FindFirstChild("Enchantments") end
        if node then node = node:FindFirstChild("Enchantments") end
        if not node then
            GUI.EnchantsFetchStatus = "Folder not found"
            return
        end

        -- Depth-limited walk (safer than GetDescendants on large trees)
        local modules = {}
        local function walk(inst, depth)
            if depth > 5 then return end
            local kids = nil
            pcall(function() kids = inst:GetChildren() end)
            if not kids then return end
            for _, c in pairs(kids) do
                local cls = nil
                pcall(function() cls = c.ClassName end)
                if cls == "ModuleScript" then
                    table.insert(modules, c)
                else
                    walk(c, depth + 1)
                end
            end
        end
        walk(node, 0)

        local total = #modules
        local kept = 0
        for i, mod in ipairs(modules) do
            -- One bad module (or one bad decompile) shouldn't kill the loop.
            -- We try ancestor first (free) and fall back to decompile only
            -- when needed. Description comes from the same decompiled source
            -- if we ran one, otherwise stays nil and is loaded on card click.
            pcall(function()
                local rarity = enchantRarityFromAncestors(mod)
                local description = nil
                if not rarity then
                    local src = nil
                    pcall(function() src = decompile(mod) end)
                    rarity = enchantRarityFromSource(src)
                    description = enchantDescriptionFromSource(src)
                end
                if rarity then
                    data[mod.Name] = {
                        rarity = rarity,
                        description = description,  -- may be nil → lazy load on click
                        module = mod,
                    }
                    kept = kept + 1
                end
            end)
            -- Yield every iteration when we might be decompiling, less often
            -- when ancestor walk is enough. Cheaper than freezing the VM.
            if i % 4 == 0 then
                GUI.EnchantsFetchStatus = "Loading " .. i .. " / " .. total
                task.wait()
            end
        end
        GUI.EnchantsFetchStatus = kept .. " enchants loaded"
    end)
    if not ok then
        GUI.EnchantsFetchStatus = "Error: " .. tostring(err)
    end
    GUI.EnchantsAllData = data
end

-- One spelling for both sides of the owned check. The game shows an owned enchant in capitals
-- ("I CAN'T DIE LIKE THIS"); its module is named "I Can't Die Like This". Case, spaces and
-- punctuation are dropped before the two are compared.
local function enchantKey(s)
    return (string.gsub(string.lower(tostring(s or "")), "[^%w]", ""))
end

-- Reads owned enchants from LocalPlayer.PlayerGui.Enchantments.Enchantments.
--
-- Each owned enchant is one Frame in that list. The frame's NAME used to be the enchant's name and
-- that was all this read. The game now names the frames "Enchantment_<id>_<n>", and the enchant's
-- name exists only as the text of a label inside (Frame.Group.Frame.Frame.textLabel), so every
-- lookup missed and the whole panel read MISSING. Measured live: 284 such frames, every one of
-- them matching a module under ReplicatedStorage once both are put through enchantKey.
-- The same list also holds "Proficiency_..." frames. They are not enchants (one even shares its
-- name with one), so when the id-style names are in use ONLY "Enchantment_" frames are counted.
--
-- GUI.EnchantsOwned is keyed by enchantKey(name). About 300 frames at ~1ms each, so this YIELDS
-- as it goes: call it from a spawned thread, never straight from a UI callback.
FetchOwnedEnchants = function()
    GUI.EnchantsOwnedGen = (GUI.EnchantsOwnedGen or 0) + 1
    local gen = GUI.EnchantsOwnedGen
    local owned, done = {}, false

    -- The text of the label that names the enchant. Never throws: one frame that cannot be read
    -- (destroyed mid-refresh by a reroll, say) must not cost the other 283.
    local function labelText(frame)
        local tx = nil
        pcall(function()
            local node = frame
            for _, nm in ipairs({ "Group", "Frame", "Frame", "textLabel" }) do
                node = node and node:FindFirstChild(nm)
            end
            if node then tx = node.Text end
        end)
        if type(tx) == "string" and tx ~= "" then return tx end
        -- That path has moved before. If it moves again, take the first TextLabel that has text,
        -- breadth-first and bounded, rather than reporting everything missing a second time.
        local queue, qi = { frame }, 1
        while queue[qi] and qi <= 40 do
            local kids = nil
            pcall(function() kids = queue[qi]:GetChildren() end)
            qi = qi + 1
            for _, k in ipairs(kids or {}) do
                local cls, t2 = nil, nil
                pcall(function() cls = k.ClassName end)
                if cls == "TextLabel" then
                    pcall(function() t2 = k.Text end)
                    if type(t2) == "string" and t2 ~= "" then return t2 end
                end
                queue[#queue + 1] = k
            end
        end
        return nil
    end

    pcall(function()
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        local container = pgui and pgui:FindFirstChild("Enchantments")
        local list = container and container:FindFirstChild("Enchantments")
        if not list then return end
        local frames = list:GetChildren()
        local names, idStyle = {}, false
        for i, f in ipairs(frames) do
            local nm = nil
            pcall(function() nm = f.Name end)
            names[i] = type(nm) == "string" and nm or ""
            if string.sub(names[i], 1, 12) == "Enchantment_" then idStyle = true end
        end
        for i, f in ipairs(frames) do
            if gen ~= GUI.EnchantsOwnedGen then return end      -- a newer refresh took over
            local nm = names[i]
            if idStyle then
                if string.sub(nm, 1, 12) == "Enchantment_" then
                    local key = enchantKey(labelText(f))
                    if key ~= "" then owned[key] = true end
                end
            elseif nm ~= "" then
                -- The old layout, where the frame's name IS the enchant. Still read the label
                -- as well, so a third naming scheme has a chance of working unpatched.
                owned[enchantKey(nm)] = true
                local key = enchantKey(labelText(f))
                if key ~= "" then owned[key] = true end
            end
            if i % 30 == 0 then task.wait() end
        end
        done = true
    end)
    -- Only a COMPLETE read replaces what is on screen: a list that is not there yet, an error
    -- half way, or a refresh that was overtaken must not blank the panel.
    if done and gen == GUI.EnchantsOwnedGen then GUI.EnchantsOwned = owned end
end

local function buildFilteredEnchantList()
    local all = GUI.EnchantsAllData or {}
    local owned = GUI.EnchantsOwned or {}
    local filter = GUI.EnchantsRarityFilter
    local showUnowned = GUI.EnchantsShowUnowned

    local list = {}
    for name, info in pairs(all) do
        local rarity = info.rarity
        local has = owned[enchantKey(name)] == true
        local pass = true
        if filter ~= "All" and rarity ~= filter then pass = false end
        if pass and showUnowned then
            -- Only show rarities the player can actually obtain
            if has or ENCHANT_RARITY_UNOBTAINABLE[rarity] then pass = false end
        end
        if pass then
            table.insert(list, {
                name = name,
                rarity = rarity,
                description = info.description,  -- nil until lazily decompiled
                module = info.module,
                owned = has,
            })
        end
    end
    -- Sort: by rarity rank desc, then name asc
    local rarityRank = {}
    for i, r in ipairs(ENCHANT_RARITIES) do rarityRank[r] = i end
    table.sort(list, function(a, b)
        local ra = rarityRank[a.rarity] or 0
        local rb = rarityRank[b.rarity] or 0
        if ra ~= rb then return ra > rb end
        return a.name < b.name
    end)
    return list
end

-- Word-wrap a single string into N-char-ish lines (Drawing has no auto-wrap)
local function wrapEnchantText(text, maxLen)
    local lines = {}
    if not text or text == "" then return { "" } end
    local current = ""
    for word in string.gmatch(text, "%S+") do
        if #current == 0 then
            current = word
        elseif #current + 1 + #word <= maxLen then
            current = current .. " " .. word
        else
            table.insert(lines, current)
            current = word
        end
    end
    if #current > 0 then table.insert(lines, current) end
    return lines
end


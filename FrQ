-- All in-menu notifications route through the INS-ui library's own toast
-- (GUI._lib:Notify) so they match the menu's look. Falls back to Matcha's
-- global notify() only when the lib isn't up (load-failure path / post-unload,
-- when the lib is destroyed). kind = "success"/"warning"/"info"/"error".
local function uiNotify(title, msg, dur, kind)
    local lib = GUI._lib
    if lib then
        local ok = pcall(function() lib:Notify(title, msg, dur, kind) end)
        if ok then return end
    end
    pcall(notify, title, msg, dur)
end


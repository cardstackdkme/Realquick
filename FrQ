-- Velocity Indicator popup. PlayerGui.Velocity.Velocity.Speed IS the character's real velocity
-- (verified: the Velocity route shows HumanoidRootPart.AssemblyLinearVelocity.Magnitude).
-- The ODM top-speed cap is applied by a server-side momentum sim (dumped ~760 client scripts —
-- GearMaxVelocityMultiplier is NOT read anywhere client-side, so there's no exact formula to copy).
-- BUT your real runs fit a straight line: 235@x1.11, 267@x1.3, 330@x1.75  ->  top ~= VELO_B + VELO_M*mult.
-- So EST. TOP VELOCITY uses that line (NOT peak*mult); your live PEAK validates it. If it drifts as you
-- upgrade gear, just retune VELO_B / VELO_M. Also: live CURRENT; ignore <50 (walking); a peak >400 is a
-- glitch and auto-clears after 5s; manual Reset.
local VELO_B, VELO_M = 74, 147   -- intercept + slope fitted to your real velocity/multiplier runs
local function drawVelo()
    if not GUI.VeloOpen then anim.veloopen=0; return end
    local op=av("veloopen",1,14); R.fade=op; R.yoff=(1-op)*12
    local w,h=314,220
    local x,y=GUI.VeloX,GUI.VeloY
    local cx,cy,cw=window("velo",x,y,w,h,"Velocity",nil,function() GUI.VeloOpen=false end,true)

    -- read the game's own live velocity readout (actual velocity)
    local raw=0
    pcall(function()
        local pg=LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
        local root=pg and pg:FindFirstChild("Velocity")
        local frame=root and root:FindFirstChild("Velocity")
        local speed=frame and frame:FindFirstChild("Speed")
        if speed then local num=tostring(speed.Text or ""):match("[%d%.]+"); raw=tonumber(num) or 0 end
    end)
    local grappling = raw >= 50            -- below 50 = walking, not grappling — ignore
    local cur = grappling and raw or 0
    local mult = tonumber(GUI.VeloMult) or 1.11
    if cur > (GUI.VeloPeak or 0) then GUI.VeloPeak = cur end
    -- peak > 400 is a glitch spike (unreachable normally) — auto-clear it 5s after it appears
    local nowc = os.clock()
    if (GUI.VeloPeak or 0) > 400 then
        if not GUI.VeloPeakHiAt then GUI.VeloPeakHiAt = nowc
        elseif nowc - GUI.VeloPeakHiAt >= 5 then GUI.VeloPeak = 0; GUI.VeloPeakHiAt = nil end
    else
        GUI.VeloPeakHiAt = nil
    end

    local peak = GUI.VeloPeak or 0
    local est = maxf(0, VELO_B + VELO_M * mult)   -- EST from the fitted line, NOT peak*mult

    -- EST. TOP VELOCITY  (the "how much am I gonna go" headline)
    txt(string.format("EST. TOP VELOCITY     x%.2f", mult), cx, cy, 11, T.muted, 63, false, Drawing.Fonts.SystemBold)
    local es = string.format("~%.0f", est)
    txt(es, cx, cy+14, 34, T.red, 64, false, Drawing.Fonts.SystemBold)
    txt("velocity", cx+tw(es,34)+8, cy+36, 12, T.muted, 63)
    ln(cx, cy+60, cx+cw, cy+60, T.soft, 62, 1, 0.4)

    -- CURRENT (live) + PEAK (measured) + Reset
    txt("CURRENT", cx, cy+68, 11, T.muted, 63, false, Drawing.Fonts.SystemBold)
    if grappling then txt(string.format("%.0f", cur), cx, cy+82, 22, T.text, 64, false, Drawing.Fonts.SystemBold)
    else txt("walking", cx, cy+84, 15, T.dim, 64, false, Drawing.Fonts.SystemBold) end

    txt("PEAK", cx+cw*0.40, cy+68, 11, T.muted, 63, false, Drawing.Fonts.SystemBold)
    txt(string.format("%.0f", peak), cx+cw*0.40, cy+82, 22, T.blue, 64, false, Drawing.Fonts.SystemBold)
    button("veloreset", cx+cw-68, cy+80, 68, 26, "Reset", function() GUI.VeloPeak=0; GUI.VeloPeakHiAt=nil end, false, T.red)

    -- the formula, spelled out so it's not a black box
    txt(string.format("est = %d + %d x %.2f", VELO_B, VELO_M, mult), cx, cy+118, 12, T.green, 63, false, Drawing.Fonts.SystemBold)

    R.fade=1; R.yoff=0
end

-- Character-tab lock overlay: dims ONLY the Character panel (rect from _G.RQGeo, published by the
-- patched INS-ui fork) + a centered "Load Values" popup with ONE button. Shows only while the menu
-- is open, the Character tab is active, and Values aren't loaded. Drawn last so its button click wins.
local function drawCharLock()
    local geo = _G.RQGeo
    -- Locked = menu open, on the Character tab, Values not yet loaded.
    local locked = type(geo) == "table" and geo.open == true and geo.tab == "Character"
        and not (GUI.CharIsLoaded and GUI.CharIsLoaded())
    -- Freeze the lib's OWN control input while locked — the patched fork's cN()
    -- callback dispatcher checks this flag and swallows every control callback,
    -- so sliders/buttons/toggles behind the scrim do nothing. Cleared the moment
    -- you load, switch tabs, or close the menu. nil (not false) so a stale flag
    -- can never bleed into another script that shares the fork.
    _G.RQBlockInput = locked or nil
    if not locked then return end
    local gx, gy, gw, gh = geo.cx, geo.cy, geo.cw, geo.ch
    if type(gx) ~= "number" or type(gy) ~= "number" or type(gw) ~= "number" or type(gh) ~= "number" then return end
    if gw < 40 or gh < 40 then return end
    R.fade = 1; R.yoff = 0; R.clipTop = nil; R.clipBot = nil
    -- The lib scales every ZIndex it draws by 10000, so its layers land in the millions. This
    -- clears the tab content it needs to cover, but NOT the lib's own floating overlays —
    -- tooltips (~3.33M), the spotlight palette (~4.13M) and modal dialogs (~4.66M) still sit on
    -- top, which is the behaviour you want from a dialog anyway. Left at 3000000 for that reason;
    -- drawBadge deliberately goes higher because a version pill must never be occluded.
    local Z = 3000000
    rect(gx, gy, gw, gh, C3(8, 8, 11), Z, 0.66, 6)                       -- scrim over ONLY the panel
    local pw = minf(380, gw - 36); local ph = 156
    local px = gx + (gw - pw) / 2; local py = gy + (gh - ph) / 2
    shadow(px, py, pw, ph, Z + 1)
    rect(px, py, pw, ph, T.panel, Z + 2, 0.98, 9)
    rect(px, py, pw, ph, T.red, Z + 3, 0.75, 9, false, 1)
    rect(px, py, pw, 3, T.red, Z + 4, 0.9, 2)
    txt("VALUES LOCKED", px + pw / 2, py + 22, 16, T.red, Z + 4, true, Drawing.Fonts.SystemBold)
    txt("Load Values to use the Character tab.", px + pw / 2, py + 52, 12, T.text, Z + 4, true)
    txt("Scans memory once (~15s). Cached until you rejoin.", px + pw / 2, py + 72, 11, T.muted, Z + 4, true)
    button("charlockload", px + (pw - 210) / 2, py + ph - 48, 210, 34, "Load Values  (~15s)", function()
        if GUI.CharLoad then GUI.CharLoad() end
    end, true, T.red, Z + 5)
end

-- Version badge, drawn by US rather than by the UI library.
--
-- The library was patched to render a `badge` option and it never once appeared, for two
-- independent reasons — either alone is fatal:
--   1. It funnels every ZIndex through a helper that multiplies it by 10000. The patch passed
--      629997 (copied from a nearby RAW `.ZIndex=629999` assignment that bypasses that helper),
--      so the pill asked for a ZIndex of ~6.3 BILLION — three times past int32, and dropped.
--   2. Both of its alphas are multiplied by the sidebar hover spring, which is 0 whenever the
--      sidebar is collapsed. The saved config has sidebarPinned=false, so that spring is 0 almost
--      always — the window TITLE has the same bug and is invisible for the same reason.

-- Where a panel being dragged to (x, y) should go instead. `self` is its key in GUI.SnapPanels.
function GUI.Snap(self, x, y, w, h)
    local free = not GUI.SnapOn or not (tonumber(w) and tonumber(h))
    if not free then pcall(function() free = iskeypressed(0x10) and true or false end) end   -- Shift
    if free then GUI.SnapGuides(nil, nil); return x, y end
    local vw, vh = 1920, 1080
    pcall(function() local vp = Workspace.CurrentCamera.ViewportSize; vw, vh = vp.X, vp.Y end)
    local xs, ys = { vw / 2 }, { vh / 2 }
    for key, get in pairs(GUI.SnapPanels) do
        if key ~= self then
            local ok, ox, oy, ow, oh = pcall(get)
            if ok and tonumber(ox) and tonumber(oy) and tonumber(ow) and tonumber(oh) then
                for _, v in ipairs({ ox, ox + ow, ox + ow / 2, vw - ox, vw - ox - ow }) do xs[#xs + 1] = v end
                for _, v in ipairs({ oy, oy + oh, oy + oh / 2 }) do ys[#ys + 1] = v end
            end
        end
    end
    local function nearest(pos, size, lines)
        local bestD, bestPos, bestLine = GUI.SnapPx + 0.5, nil, nil
        for _, edge in ipairs({ 0, size / 2, size }) do
            for _, l in ipairs(lines) do
                local d = math.abs(l - (pos + edge))
                if d < bestD then bestD, bestPos, bestLine = d, l - edge, l end
            end
        end
        return bestPos, bestLine
    end
    local sx, gx = nearest(x, w, xs)
    local sy, gy = nearest(y, h, ys)
    GUI.SnapGuides(gx, gy)
    return sx or x, sy or y
end
-- Full-screen guide lines at x = gx and y = gy; nil hides that one.
function GUI.SnapGuides(gx, gy)
    local G = GUI._snapLines
    if not G then
        if not (gx or gy) then return end
        G = {}
        pcall(function()
            for _, k in ipairs({ "v", "h" }) do
                local l = Drawing.new("Line")
                l.Thickness = 1
                l.Color = Color3.fromRGB(90, 170, 255)
                l.Transparency = 0.9
                l.ZIndex = 90
                l.Visible = false
                G[k] = l
            end
        end)
        GUI._snapLines = G
    end
    local vw, vh = 1920, 1080
    pcall(function() local vp = Workspace.CurrentCamera.ViewportSize; vw, vh = vp.X, vp.Y end)
    pcall(function()
        if G.v then
            if gx then G.v.From = Vector2.new(gx, 0); G.v.To = Vector2.new(gx, vh) end
            G.v.Visible = gx ~= nil
        end
        if G.h then
            if gy then G.h.From = Vector2.new(0, gy); G.h.To = Vector2.new(vw, gy) end
            G.h.Visible = gy ~= nil
        end
    end)
end


    for ck, gk in pairs(GUI.LayoutKeys) do
        if type(GUI[gk]) == "number" then data.panels[ck] = math.floor(GUI[gk] + 0.5) end
    end
    data.panels.menu = GUI.MenuRect()
    return GUI.WriteConfigFile(data)

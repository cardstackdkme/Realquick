-- ---------- Gas pack ----------
-- Live-verified path (2026-08-20):
--     Workspace.<playerName>.attachment_Gaspack.Gaspack.Interaction   -- a PART
-- carrying Amount and MaxAmount as NUMBER attributes (measured: 4180.8 / 4400; the part also has
-- Moveable, OriginalSize and Type). The gaspack is an ATTACHMENT model on the character, so it is
-- simply absent when none is worn — every step below is nil-guarded and returns nil in that case,
-- which is what the caller uses to decide whether to draw anything at all.
ClearGasBar = function()
    for _, el in ipairs(GUI.GasBarElements) do
        pcall(function() el:Remove() end)
    end
    GUI.GasBarElements = {}
    GUI.GasBarHandle = nil   -- the handle points at removed objects; never reuse it
end

-- Returns (amount, maxAmount) or nil when no gaspack is worn.
local function ReadGas(playerName)
    local ch = Workspace:FindFirstChild(playerName)
    if not ch then return nil end
    local att = ch:FindFirstChild("attachment_Gaspack")
    local pack = att and att:FindFirstChild("Gaspack")
    local inter = pack and pack:FindFirstChild("Interaction")
    if not inter then return nil end
    local a, m
    pcall(function() a = inter:GetAttribute("Amount") end)
    pcall(function() m = inter:GetAttribute("MaxAmount") end)
    a, m = tonumber(a), tonumber(m)
    if not a then return nil end
    return a, (m and m > 0) and m or 100
end

-- Reuses DrawHealthBarWidget so the gas bar is pixel-identical to the health bar (same shadow,
-- rounded body, accent strip, percent + "n / max" numbers and fill). Only the label and the numbers
-- differ, so there is no second widget to keep in sync.
BuildGasBar = function()
    ClearGasBar()
    if not GUI.GasBarVisible then return end
    local gas, maxGas = ReadGas(LocalPlayer.Name)
    -- No pack worn: say so rather than drawing a misleading empty bar.
    local label = gas and "Gas" or "Gas  (no pack)"
    GUI.GasBarHandle = DrawHealthBarWidget(GUI.GasBarX, GUI.GasBarY, GUI.GasBarW, GUI.GasBarH,
        label, gas or 0, maxGas or 100, 55, GUI.GasBarElements)
end

-- Periodic refresh. Mutates the existing widget rather than rebuilding it, so the bar never blinks.
-- A FULL rebuild happens only when the label itself has to change, i.e. when a gaspack is put on or
-- taken off — that is rare, and it is the one case where the text is not just a number.
UpdateGasBar = function()
    local h = GUI.GasBarHandle
    if not (GUI.GasBarVisible and h) then return end
    local gas, maxGas = ReadGas(LocalPlayer.Name)
    local want = gas and "Gas" or "Gas  (no pack)"
    if h.label ~= want then BuildGasBar(); return end
    UpdateBarWidget(h, gas or 0, maxGas or 100, GUI.GasBarX, GUI.GasBarY, GUI.GasBarW)
end


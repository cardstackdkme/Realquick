-- RS Diff row layout. A row WRAPS its path over as many lines as it needs instead of cutting it at
-- a fixed 64 characters (which also made the cut look like a path ending in "."), and the class is
-- right-aligned INSIDE the card -- it used to START at the card's right edge and run off the
-- window. Matcha's Drawing exposes no TextBounds, so widths come from tw(), which runs ~20% wide:
-- a line can wrap slightly early but never spill. Cached per result list + width, because that only
-- changes on Compare / Clear / a resize, and a diff can be thousands of rows.
local RSL = { res = nil, cw = nil, rows = {}, total = 0, LINE = 15, PAD = 9, PATHX = 48 }
function RSL.wrap(s, maxc)
    local out = {}
    while #s > maxc do
        -- prefer to break just after a "." so a line ends on a whole name; hard-cut a name that is
        -- itself too long for one line
        local cut = maxc
        for i = maxc, maxf(1, floor(maxc * 0.5)), -1 do
            if s:byte(i) == 46 then cut = i; break end
        end
        -- never split a UTF-8 character: step back off continuation bytes (0x80-0xBF)
        while cut > 1 and (s:byte(cut + 1) or 0) >= 128 and (s:byte(cut + 1) or 0) < 192 do cut = cut - 1 end
        out[#out + 1] = s:sub(1, cut)
        s = s:sub(cut + 1)
    end
    out[#out + 1] = s
    return out
end
function RSL.layout(res, cw)
    if RSL.res == res and RSL.cw == cw then return RSL end
    local rows, yy = {}, 0
    local right = cw - 14                  -- inside the card, clear of the scrollbar
    local capW = floor(cw * 0.35)          -- a long "A -> B" class change can't eat the path
    for i, rr in ipairs(res) do
        local d = tostring(rr.detail or "")
        if tw(d, 11) > capW then d = trim(d, floor(capW / 5.5)) end
        local dW = (d ~= "") and tw(d, 11) or 0
        local maxc = maxf(10, floor((right - dW - (d ~= "" and 12 or 0) - RSL.PATHX) / 6))
        local lines = RSL.wrap(tostring(rr.path or ""), maxc)
        local rh = #lines * RSL.LINE + RSL.PAD
        rows[i] = { y = yy, h = rh, lines = lines, d = d, dW = dW }
        yy = yy + rh
    end
    RSL.res, RSL.cw, RSL.rows, RSL.total = res, cw, rows, yy
    return RSL
end


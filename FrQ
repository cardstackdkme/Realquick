-- distance from point P to segment AB, on screen
local function agSegDist(px, py, ax, ay, bx, by)
    local vx, vy = bx - ax, by - ay
    local t = 0
    local vv = vx * vx + vy * vy
    if vv > 0.0001 then
        t = ((px - ax) * vx + (py - ay) * vy) / vv
        if t < 0 then t = 0 elseif t > 1 then t = 1 end
    end
    local qx, qy = ax + vx * t - px, ay + vy * t - py
    return math.sqrt(qx * qx + qy * qy)
end

-- Where a player's centre is on screen, and how fast it moves there (smoothed). Fed by the roster
-- AND by every fresh read, so whoever is near the cursor is tracked tick by tick.
local function agSeen(e, x, y, now)
    local dt = e.sAt and (now - e.sAt) or 1
    if dt > 0.001 and dt < 0.5 and e.sx then
        local k = dt < 0.05 and 0.5 or 0.8
        e.svx = (e.svx or 0) + ((x - e.sx) / dt - (e.svx or 0)) * k
        e.svy = (e.svy or 0) + ((y - e.sy) / dt - (e.svy or 0)) * k
    elseif dt >= 0.5 then
        e.svx, e.svy = 0, 0
    end
    e.sx, e.sy, e.sAt = x, y, now
end

-- This tick's on-screen picture of one player, read ONCE per tick however many tests use it:
-- { d = distance, s = pixels per stud, cx/cy centre, ax/ay..bx/by the body line, hx/hy/hs head }.
-- nil = not visible.
local function agFresh(e, tickN, now, ppK, cx, cy, cz, wantHead)
    if e.fTick ~= tickN then
        e.fTick, e.f, e.fHead = tickN, nil, false
        local p, up = nil, nil
        pcall(function()
            local cf = e.hrp.CFrame
            p = cf.Position
            up = cf.UpVector
        end)
        if p and up then
            local dx, dy, dz = p.X - cx, p.Y - cy, p.Z - cz
            local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
            if dist >= 2 and dist <= AIM.MaxDist then
                local c, onC = WorldToScreen(p)
                if c and onC then
                    local s = ppK / dist
                    local ux, uy, uz = up.X, up.Y, up.Z
                    local a = WorldToScreen(Vector3.new(p.X + ux * 2.1, p.Y + uy * 2.1, p.Z + uz * 2.1))
                    local b = WorldToScreen(Vector3.new(p.X - ux * 2.9, p.Y - uy * 2.9, p.Z - uz * 2.9))
                    -- An end can only be about its own length from the centre on screen. Further than
                    -- that it is a point behind the camera projected through it: use the centre.
                    local ax, ay, bx, by = c.X, c.Y, c.X, c.Y
                    if a then
                        local lim = 2.1 * s * 1.6 + 6
                        if (a.X - c.X) ^ 2 + (a.Y - c.Y) ^ 2 <= lim * lim then ax, ay = a.X, a.Y end
                    end
                    if b then
                        local lim = 2.9 * s * 1.6 + 6
                        if (b.X - c.X) ^ 2 + (b.Y - c.Y) ^ 2 <= lim * lim then bx, by = b.X, b.Y end
                    end
                    agSeen(e, c.X, c.Y, now)
                    e.vis, e.rpx = true, 3 * s
                    e.f = { d = dist, s = s, cx = c.X, cy = c.Y, ax = ax, ay = ay, bx = bx, by = by }
                end
            end
        end
    end
    local f = e.f
    if f and wantHead and not e.fHead then
        e.fHead = true
        local hp = nil
        pcall(function() hp = e.head.Position end)
        if hp then
            local h, onH = WorldToScreen(hp)
            if h and onH then
                local hdx, hdy, hdz = hp.X - cx, hp.Y - cy, hp.Z - cz
                local hd = math.sqrt(hdx * hdx + hdy * hdy + hdz * hdz)
                if hd > 1 then f.hx, f.hy, f.hs = h.X, h.Y, ppK / hd end
            end
        end
    end
    return f
end

-- Is screen point (px, py) on this zone of them?  zone: "body" | "core" | "head"
local function agOn(f, zone, px, py)
    if zone == "head" then
        if not f.hx then return false end
        local r = math.max(AIM.HeadR * f.hs, AIM.MinPx - 1)
        return (px - f.hx) ^ 2 + (py - f.hy) ^ 2 <= r * r
    end
    local r = math.max((zone == "core" and AIM.CoreR or AIM.BodyR) * f.s, AIM.MinPx)
    return agSegDist(px, py, f.ax, f.ay, f.bx, f.by) <= r
end

-- The press gate: on the zone now AND where the cursor will be relative to them when the game
-- reads it. Judged once per player per zone per tick.
local function agSteady(e, f, zone, mx, my, cvx, cvy, now, tickN, lead)
    e.since = e.since or {}
    e.sTick = e.sTick or {}
    e.sOk = e.sOk or {}
    if e.sTick[zone] == tickN then return e.sOk[zone] end
    if e.sTick[zone] ~= tickN - 1 then e.since[zone] = nil end
    e.sTick[zone] = tickN
    local rvx, rvy = cvx - (e.svx or 0), cvy - (e.svy or 0)
    local ok = false
    if agOn(f, zone, mx, my) and agOn(f, zone, mx + rvx * lead, my + rvy * lead) then
        if not e.since[zone] then e.since[zone] = now end
        ok = now - e.since[zone] >= AIM.Dwell
    else
        e.since[zone] = nil
    end
    e.sOk[zone] = ok
    return ok
end

-- Actor or not, from the Actor ESP's classification (players carry no "Actor" attribute; only
-- their death ragdolls do). The ESP keeps classifying in the background while a filter needs it.
local function tbIsActor(nm)
    local o = nm and ACTOR_ESP.Objects[nm]
    return o ~= nil and o.role == "actor"
end

-- Has the bot used up this aim? While true it stops clicking until you lower and re-aim, or a
-- reload finishes (both reset `fired` to 0). Matters because a click on an EMPTY gun starts a
-- reload, which lowers your aim and locks you in the reload animation.
--   prof.rounds = magazine size (TB_GUNS); fired = clicks the bot sent since the last reset.
--   Careful: `fired` counts CLICKS, not shots. On a Kar98k the bot clicks every 0.15 s and the game
--   ignores clicks while the bolt cycles, so 5 clicks can be only 1 real shot.
local function tbOutOfShots(prof, fired)
    -- Only 1- and 2-round guns stop; magazine guns keep clicking and reload themselves when
    -- empty, like a human would.
    return prof.rounds <= 2 and fired >= prof.rounds
end

-- The gun in your hands: its name and rules, or nil. A known name wins; otherwise any model with
-- a muzzle ("Exit", which is what the game itself fires from), remembered per name.
local tbHasExit = {}
local function tbFindGun(ch)
    local kids = nil
    pcall(function() kids = ch:GetChildren() end)
    if type(kids) ~= "table" then return nil, nil end
    local names = {}
    for i, k in ipairs(kids) do
        local nm = nil
        pcall(function() nm = k.Name end)
        if type(nm) == "string" then
            if TB_GUNS[nm] then return nm, TB_GUNS[nm] end
            names[i] = nm
        end
    end
    for i, k in ipairs(kids) do
        local nm = names[i]
        if nm and not TB_NOTGUN[nm] and string.sub(nm, 1, 11) ~= "attachment_" then
            if tbHasExit[nm] == nil then
                local cls, ex = nil, nil
                pcall(function() cls = k.ClassName end)
                if cls == "Model" or cls == "Tool" then
                    pcall(function() ex = k:FindFirstChild("Exit", true) end)
                end
                tbHasExit[nm] = ex ~= nil
            end
            if tbHasExit[nm] then return nm, TB_UNKNOWN end
        end
    end
    return nil, nil
end


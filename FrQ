AP.Gen = (AP.Gen or 0) + 1
local myGen = AP.Gen

-- ============================================================
-- FAST SWING  —  local playback speed on your OWN swing animations
-- ============================================================
-- Writes AnimationTrack.Speed (+212) on your own swing tracks. Entirely local: it changes how fast
-- YOUR client plays the animation. Nothing is sent to the server, no remote is touched.
--   tap / release : play the slash at Swing Speed, then zoom the recovery tail at Recovery Speed so
--                   you become actionable again sooner
--   M1 held       : boost only the windup for a short, auto-sized window and then go COMPLETELY
--                   hands-off, so the game parks the charge at that animation's own keyframe.
--                   Guessing a fixed freeze point does not work — combo animations freeze at
--                   different places, which is what made earlier versions slip on rapid re-swings.
local FS = {
    -- same two-stage arrangement as Auto Parry: pill arms, hotkey runs
    Enabled = false,
    On = false,
    Key = 0x48,        -- H
    Swing = 1.0,       -- playback rate for the active slash / windup boost
    Recovery = 8.0,    -- playback rate for the recovery tail
    -- How much of the animation the charge boost covers before going hands-off. Fixed rather than
    -- exposed: it only shapes the brief windup boost while M1 is HELD, and the value that matters
    -- is that it ends early enough for the game to park the charge at its own keyframe.
    Windup = 0.36,
    Slash = 0.35,      -- animation time that still counts as the slash rather than the tail
    M1 = false, M1At = 0, Phase = "-", Hz = 0,
    -- LEARNED SWING ANIMATIONS. The static id list below only ever contained the two Crossguard
    -- AIR swings, so entering Crossguard (or any other stance) left every playing track unmatched
    -- and Fast Swing silently did nothing at all. Rather than trying to enumerate every stance in
    -- the game, anything that STARTS on your own animator while you are pressing M1 is treated as
    -- a swing from then on. That covers Crossguard, the other stances, and weapons nobody listed.
    -- Ambient = everything seen playing while you were NOT attacking, i.e. locomotion and stance
    -- idles. Anything playing that is not in here is treated as an action animation and sped up,
    -- which is what makes this work across every stance without naming a single one.
    Ambient = {}, AmbientN = 0,
    Learned = {}, LearnedN = 0,   -- ids actually sped, for the status readout
    TP = {},                      -- [animId] = last TimePosition, the liveness signal
    Tracks = 0, Hits = 0,         -- last pass: tracks walked / tracks sped. Diagnostics.
    UpAt = 0,                     -- when M1 was last released; ambient sampling waits on this
    HoldMode = false,             -- see the FS.HoldMode branch in fsApply
}
GUI.FS = FS
pcall(function() rawset(_G, "RQFS", FS) end)

-- Melee tool swings are included as well: this is purely local playback speed, so it helps every
-- weapon, not just the gear blades the parry cares about.
local FS_SWINGS = {}
for id in pairs(SWINGS) do FS_SWINGS[id] = true end
for _, id in ipairs({ "112666168396669", "86140055867484", "124361532701064", "136621055776523",
                      "82666636655771", "75659520618730", "89635808450635" }) do FS_SWINGS[id] = true end

-- Decide whether a track is one of YOUR action animations.
--
-- The original approach was an allowlist of animation ids, inherited from the parry detector. It
-- could never work across stances: only two Crossguard AIR swings were ever in it, so any other
-- stance left every track unmatched. The replacement I tried first -- learn ids that appear on an
-- M1 press -- could not work either, because it demanded a track be BOTH newly-present AND fully
-- blended in (weight > 0.5) on the SAME pass, and a track that has just appeared still has its
-- weight ramping up from zero. It was new for exactly one pass, failed the weight test on that
-- pass, and was never eligible again. Nothing was ever learned.
--
-- So this inverts the problem. Whatever plays while you are NOT attacking is by definition ambient:
-- idle, walk, run, stance idle. Record those. Anything playing that is NOT ambient is an action
-- animation, whichever stance or weapon it belongs to, with no ids to enumerate.
-- Which of your tracks may be sped up.
--
-- HISTORY, because two attempts failed here and the reasons matter:
--   v3.1 matched a hardcoded id list. Correct but blind to stances: it held only two Crossguard
--        AIR swings, so any other stance matched nothing.
--   v3.2 tried to learn ids, demanding a track be BOTH newly-present AND weight > 0.5 on the SAME
--        pass. A just-appeared track still has its weight ramping from zero, so it failed on its
--        one "new" pass and was never new again. Nothing was ever learned.
--   v3.3 required weight > 0.5 before speeding ANYTHING. The OW offset is annotated above as
--        "measured live on two ENEMIES" -- it was never validated on your own animator. For the
--        original ids that gate was the ONLY new blocker between v3.1 working and v3.3 not, which
--        is what killed the feature outright.
--
-- So weight is no longer trusted anywhere. Liveness comes from TimePosition ADVANCING between
-- passes, which the notes above already establish and which v3.1 depended on and proved out:
-- a playing track advances, a finished one sits frozen in the active list for 20+ seconds.
--
-- THE FLOOR: the ambient denylist is consulted only once it has actually recorded something. If
-- ambient sampling never works on some build, matching collapses to exactly the v3.1 id list --
-- never worse than the version that worked.
local FS_QUIET = 1.2      -- M1 up this long before the tracks then playing count as ambient
local FS_TPEPS = 0.0005   -- TimePosition delta above which a track counts as advancing

local function fsApply(now)
    local ch = LP.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local an = hum and hum:FindFirstChildOfClass("Animator")
    if not an then return end
    local okA, A = pcall(function() return tonumber(an.Address) end)
    if not (okA and A) then return end
    local head = rptr(A + OA)
    if not head or head < 0x10000 then return end

    -- Ambient is only sampled well clear of any attack: swings run ~0.85s and the recovery zoom
    -- cuts that shorter, so 1.2s of M1 being up means whatever is still advancing is locomotion.
    local quiet = (not FS.M1) and (now - (FS.UpAt or 0)) > FS_QUIET
    local tpNow = {}
    local nTracks, nHits = 0, 0

    local node, guard = rptr(head + ON), 0
    while node and node > 0x10000 and node ~= head and guard < 64 do
        guard = guard + 1
        local t = rptr(node + OT)
        if t and t > 0x10000 and rptr(t + OO) == A then
            local id = trackId(t)
            if id then
                nTracks = nTracks + 1
                local tp = rflt(t + OP) or 0
                tpNow[id] = tp
                local prev = FS.TP[id]
                local advancing = prev ~= nil and math.abs(tp - prev) > FS_TPEPS

                if quiet and advancing and not FS_SWINGS[id] and not FS.Ambient[id] then
                    FS.Ambient[id] = true
                    FS.AmbientN = (FS.AmbientN or 0) + 1
                end

                -- Known swing ids always qualify. The denylist only widens the net, and only after
                -- it has learned something -- see THE FLOOR above.
                if FS_SWINGS[id] or ((FS.AmbientN or 0) > 0 and not FS.Ambient[id]) then
                    nHits = nHits + 1
                    if not FS.Learned[id] then
                        FS.Learned[id] = true
                        FS.LearnedN = (FS.LearnedN or 0) + 1
                    end
                    if FS.M1 and FS.HoldMode then
                        -- OPT-IN, off by default. Charging and chain-swinging both look exactly
                        -- like "M1 is down" and nothing in the animator separates them, so forcing
                        -- this on meant holding M1 to chain swings boosted only each windup and
                        -- then went hands-off, which read as the feature doing nothing.
                        if tp < FS.Windup then
                            pcall(memory_write, "float", t + OS, FS.Swing)
                            FS.Phase = "charge boost"
                        else
                            FS.Phase = "held (hands off)"
                        end
                    elseif tp < FS.Slash then
                        pcall(memory_write, "float", t + OS, FS.Swing)
                        FS.Phase = "slash"
                    else
                        pcall(memory_write, "float", t + OS, FS.Recovery)
                        FS.Phase = "recovery zoom"
                    end
                end
            end
        end
        node = rptr(node + ON)
    end
    FS.TP = tpNow
    FS.Tracks, FS.Hits = nTracks, nHits
end

task.spawn(function()
    local wasK, ready = false, false
    local hzN, hzT = 0, os.clock()
    while GUI.Running and AP.Gen == myGen do
        pcall(function()
            local now = os.clock()
            hzN = hzN + 1
            if now - hzT >= 1 then FS.Hz = hzN / (now - hzT); hzN, hzT = 0, now end

            -- M1 edge, read here rather than on its own thread: ismouse1pressed is executor-local
            -- and effectively free, so it costs nothing to sample it in the same loop.
            local m1 = false
            pcall(function() m1 = ismouse1pressed() and true or false end)
            if m1 and not FS.M1 then FS.M1At = now end
            if (not m1) and FS.M1 then FS.UpAt = now end   -- ambient sampling keys off this
            FS.M1 = m1

            -- hotkey, with the same release-arm guard the parry uses
            local d = false
            pcall(function() d = iskeypressed(FS.Key) and true or false end)
            if not ready then
                if not d then ready = true end
            elseif d and not wasK and FS.Enabled then
                -- only meaningful while armed, and it must NOT move the pill
                FS.On = not FS.On
                pcall(function() uiNotify("Fast Swing", FS.On and "ON" or "OFF", 2) end)
            end
            wasK = d

            local live = FS.Enabled and FS.On
            if live then fsApply(now) else FS.Phase = "-" end
        end)
        task.wait((FS.Enabled and FS.On) and 1 / 200 or 1 / 30)
    end
end)

task.spawn(function()
    local hzN, hzT = 0, os.clock()
    local wasToggle, toggleReady = false, false
    while GUI.Running and AP.Gen == myGen do
        local ok, err = pcall(function()
            local now = os.clock()
            hzN = hzN + 1
            if now - hzT >= 1 then AP.Hz = hzN / (now - hzT); hzN, hzT = 0, now end
            -- Measured tick period drives the commit lead. Sleep is the dominant latency here:
            -- task.wait(1/120) actually costs 10.2ms on this build (98Hz), and we need two samples
            -- to differentiate the blade, so a fixed 0.12s lead left almost no margin once input
            -- and network delay were added. That is the "parries late" case.
            if AP.LastTick then
                local d = now - AP.LastTick
                if d > 0 and d < 0.25 then AP.Dt = (AP.Dt or d) * 0.9 + d * 0.1 end
            end
            AP.LastTick = now

            -- toggle hotkey, with the release-arm guard: Matcha's iskeypressed can report a key
            -- permanently HELD, which would otherwise flip the feature on the very first frame.
            local td = false
            pcall(function() td = iskeypressed(AP.ToggleKey) and true or false end)
            if not toggleReady then
                if not td then toggleReady = true end
            elseif td and not wasToggle and AP.Enabled then
                -- only meaningful while armed, and it must NOT move the pill
                AP.On = not AP.On
                pcall(function() uiNotify("Auto Parry", AP.On and "ON" or "OFF", 2) end)
            end
            wasToggle = td

            -- release a held parry key promptly (edge-triggered keybind; a brief hold registers
            -- more reliably than an instant tap, but it must never be left down)
            if AP.Armed > 0 and (now - AP.Armed) > 0.05 then
                pcall(keyrelease, AP.Key)
                AP.Armed = 0
            end

            -- cleared every tick: an early return below must not leave the loop sprinting
            AP.Active = false
            if not AP.Enabled then AP.Status = "disabled"; AP.Near = 0; return end
            if not AP.On then AP.Status = "off (hotkey)"; AP.Near = 0; return end

            local ch = LP.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if not (hum and hrp) then AP.Status = "no character"; AP.Cand = {}; return end
            local hp = 0
            pcall(function() hp = hum.Health end)
            if hp <= 0 then AP.Status = "dead"; AP.Cand = {}; return end
            local myPos, myVel
            pcall(function() myPos = hrp.Position; myVel = hrp.AssemblyLinearVelocity end)
            if not (myPos and myVel) then return end

            -- MY acceleration. Needed because when we are BOTH grappling, the thing that has to be
            -- predicted is RELATIVE motion, and both halves of it are accelerating hard. Sampled on
            -- a ~50Hz baseline and smoothed, since frame-to-frame acceleration is very noisy.
            local mAx, mAy, mAz = 0, 0, 0
            if AP.pmv and AP.pmvT then
                local d = now - AP.pmvT
                if d > 0.02 and d < 0.3 then
                    mAx = (myVel.X - AP.pmv[1]) / d
                    mAy = (myVel.Y - AP.pmv[2]) / d
                    mAz = (myVel.Z - AP.pmv[3]) / d
                    AP.pmv = { myVel.X, myVel.Y, myVel.Z }
                    AP.pmvT = now
                    AP.ax = (AP.ax or 0) * 0.7 + mAx * 0.3
                    AP.ay = (AP.ay or 0) * 0.7 + mAy * 0.3
                    AP.az = (AP.az or 0) * 0.7 + mAz * 0.3
                end
            else
                AP.pmv = { myVel.X, myVel.Y, myVel.Z }
                AP.pmvT = now
            end

            local an = hum:FindFirstChildOfClass("Animator")
            local myA = nil
            if an then local o, a = pcall(function() return tonumber(an.Address) end); myA = o and a or nil end

            -- ONE walk of my own animator answers: did my press register (Gear.Parry playing), am I
            -- stunned, and did I just swing (PARRY_LOCKOUT_AFTER_SWING_END_SECONDS).
            local blocked, parrying = false, false
            if myA then
                local sid = scan(myA, PARRY_ONLY)
                if sid then parrying = true end
                if not sid then
                    if scan(myA, STUNS) then blocked = true end
                    local sw = scan(myA, SWINGS)
                    if sw then AP.MySwingAt = now end
                end
            end
            if AP.MySwingAt and (now - AP.MySwingAt) < C_SWING_LOCKOUT then blocked = true end

            -- Confirm the press. Our own Gear.Parry animation DOES replicate, so it is the ground
            -- truth for "the game accepted the input". Only a registered press starts a cooldown —
            -- a press the game ate (grapple, lockout, focus) must not blind us.
            if AP.PressAt > 0 then
                if parrying then
                    AP.Registered = AP.Registered + 1
                    -- Learn the real cooldown: if we ever register two parries closer together than
                    -- the model, the model was too pessimistic. Floor at the game's success window.
                    if AP.LastReg and (AP.PressAt - AP.LastReg) > 0.2 then
                        local gap = AP.PressAt - AP.LastReg
                        if gap < AP.CD then AP.CD = math.max(1.0, gap) end
                    end
                    AP.LastReg = AP.PressAt
                    AP.CoolUntil = AP.PressAt + AP.CD
                    AP.PressAt = 0
                elseif (now - AP.PressAt) > 0.25 then
                    AP.PressAt = 0     -- never registered: no cooldown, allow a retry
                end
            end
            if parrying then blocked = true end
            if AP.CoolUntil and now < AP.CoolUntil then
                -- Probe occasionally: a press that REGISTERS proves we were not locked out, which is
                -- how AP.CD gets learned down from the pessimistic 5s. Bounded to one per second.
                if (now - (AP.ProbeAt or 0)) < 1.2 then blocked = true end
            end

            if now - AP.RosterAt > 2 then AP.RosterAt = now; rebuildRoster() end

            local bestT, bestE, bestD, bestK = 9, nil, 0, nil
            local bestClose = 0
            local near = 0

            -- PASS 1: cheap distance prefilter — one position read per player, and nothing else
            -- for anyone far away.
            local nearList = {}
            for _, e in ipairs(AP.Roster) do
                local epos
                pcall(function() epos = e.hrp.Position end)
                if epos then
                    local ndx, ndy, ndz = epos.X - myPos.X, epos.Y - myPos.Y, epos.Z - myPos.Z
                    local nd3 = math.sqrt(ndx * ndx + ndy * ndy + ndz * ndz)  -- 3D: air swings come from above and below
                    if nd3 < AP.Watch then
                        nearList[#nearList + 1] = { e = e, d = nd3, dx = ndx, dy = ndy, dz = ndz }
                    end
                end
            end
            table.sort(nearList, function(a, b) return a.d < b.d end)
            near = #nearList
            -- PASS 2: the expensive work (animator walk, blade reads) for the NEAREST few only, so
            -- a crowded server cannot stall the loop and make us late.
            local lim = near
            if lim > 8 then lim = 8 end
            for li = 1, lim do
                local nl = nearList[li]
                local e, d3 = nl.e, nl.d
                local dx, dy, dz = nl.dx, nl.dy, nl.dz
                do
                    do
                        -- ONE walk per player per tick, covering swings AND their parry. Two
                        -- separate scans would double the cost of the hottest path in the loop.
                        local aid, tptr = scan(e.A, WATCHED)
                        local sid = (aid and SWINGS[aid]) and aid or nil

                        -- enemy parry-cooldown readout (rising edge of their Gear.Parry)
                        local isParry = (aid == ANIM_PARRY)
                        if isParry and not e.wasParry then e.parryAt = now end
                        e.wasParry = isParry
                        if sid then e.parryAt = 0 end   -- they are swinging, so not locked out

                        -- ================= PATH 2: the fast closer =================
                        -- The blade-sweep test below is precise, but it only runs WHILE the swing
                        -- animation is playing. A player who slashes early at range and then
                        -- grapples in finishes that animation in mid-air, so the weight gate drops
                        -- them while they are still inbound and the sweep test never gets to run —
                        -- then they arrive and the hit lands. That is the case that felt unparryable.
                        --
                        -- So: latch the swing, and for anyone CLOSING FAST predict when their body
                        -- arrives inside blade range instead of waiting for the tip to reach us.
                        -- Gating on closing speed is what keeps this from re-introducing the bait —
                        -- a stationary attacker swinging at air has ~zero closing speed and can
                        -- never take this path.
                        if sid then e.swingAt = now end
                        if e.swingAt and (now - e.swingAt) < 1.0 then
                            local evel
                            pcall(function() evel = e.hrp.AssemblyLinearVelocity end)
                            if evel then
                                -- their acceleration, same treatment as ours
                                if e.pv and e.pvT then
                                    local pd2 = now - e.pvT
                                    if pd2 > 0.02 and pd2 < 0.3 then
                                        e.ax = (e.ax or 0) * 0.7 + ((evel.X - e.pv[1]) / pd2) * 0.3
                                        e.ay = (e.ay or 0) * 0.7 + ((evel.Y - e.pv[2]) / pd2) * 0.3
                                        e.az = (e.az or 0) * 0.7 + ((evel.Z - e.pv[3]) / pd2) * 0.3
                                        e.pv = { evel.X, evel.Y, evel.Z }
                                        e.pvT = now
                                    end
                                else
                                    e.pv = { evel.X, evel.Y, evel.Z }
                                    e.pvT = now
                                end
                                local vdx = evel.X - myVel.X
                                local vdy = evel.Y - myVel.Y
                                local vdz = evel.Z - myVel.Z
                                -- LAG COMPENSATION. Their position is RTT/2 old; ours is current.
                                -- Extrapolate THEM forward so the geometry describes now, not then.
                                local lin = (AP.PingMs or 0) / 2000
                                local cdx = dx + evel.X * lin
                                local cdy = dy + evel.Y * lin
                                local cdz = dz + evel.Z * lin
                                local cd3 = math.sqrt(cdx * cdx + cdy * cdy + cdz * cdz)
                                local dx, dy, dz, d3 = cdx, cdy, cdz, cd3
                                local closing = 0
                                if d3 > 0.01 then closing = -((dx * vdx + dy * vdy + dz * vdz) / d3) end
                                local bkey = "body:" .. e.name .. ":" .. string.format("%.2f", e.swingAt)
                                if closing > 30 and not AP.Fired[bkey] then
                                    -- Effective reach grows with closing speed because the game
                                    -- raycasts each DmgPoint along its OWN per-frame displacement —
                                    -- at 300 studs/s that is ~5 extra studs per frame. This is the
                                    -- mechanism behind "he hit me from further than he should".
